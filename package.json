{
  "name": "ar-platform-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "run:test": "npm run test --workspaces",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "dev:ar-eye-hunter-v1": "npm --workspace ar-eye-hunter-v1 run dev",
    "build:ar-eye-hunter-v1": "npm --workspace ar-eye-hunter-v1 run build",
    "dev:api": "cd apps/api && deno task dev",
    "dev:api-v1": "cd apps/api-v1 && deno task dev",
    "dev:relic-hunter-server-v1": "cd apps/relic-hunter-server-v1 && deno task dev",
    "dev:relic-hunters-v1": "npm --workspace relic-hunters-v1 run dev",
    "build:relic-hunters-v1": "npm --workspace relic-hunters-v1 run build",
    "dev:rallar-black-box": "npm --workspace rallar-black-box run dev",
    "build:rallar-black-box": "npm --workspace rallar-black-box run build",
    "dev:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task dev",
    "check:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task check",
    "test:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task test",
    "dev:rallar-black-box:api-v1": "CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176 deno run --watch --env-file=apps/api-v1/.env.local --env-file=apps/api-v1/.env --env-file=.env --config apps/api-v1/deno.json --allow-net --allow-env --allow-read apps/api-v1/src/main.ts",
    "start:rallar-black-box:api-v1": "CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176 deno run --env-file=apps/api-v1/.env.local --env-file=apps/api-v1/.env --env-file=.env --config apps/api-v1/deno.json --allow-net --allow-env --allow-read apps/api-v1/src/main.ts",
    "dev:rallar-black-box:control-server": "cd apps/rallar-black-box-control-server && deno task dev",
    "start:rallar-black-box:control-server": "cd apps/rallar-black-box-control-server && deno task start",
    "dev:rallar-black-box:servers": "npm run dev:rallar-black-box:api-v1 & npm run dev:rallar-black-box:control-server & wait",
    "start:rallar-black-box:servers": "npm run start:rallar-black-box:api-v1 & npm run start:rallar-black-box:control-server & wait",
    "dev:rallar-black-box:all": "npm run dev:rallar-black-box:api-v1 & npm run dev:rallar-black-box:control-server & npm run dev:rallar-black-box -- --port 5176 & wait",
    "test:e2e:rallar-black-box": "playwright test --config apps/rallar-black-box/playwright.config.ts",
    "test:e2e:rallar-black-box:full-stack": "playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts",
    "test:e2e:rallar-black-box:full-stack:real": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts",
    "test:e2e:rallar-black-box:full-stack:real:manual": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-manual-rallar-realtime.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:rest": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-rest-workbench.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:control": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-control-orchestration.spec.ts",
    "test": "vitest run",
    "test:postgres:presence-expiry": "RALLAR_POSTGRES_INTEGRATION=1 DATABASE_URL=${DATABASE_URL:-postgres://app:app@localhost:5432/appdb} deno run -A --unstable-temporal --node-modules-dir=auto --no-lock npm:vitest run packages/tests/shared-server/postgres-presence-expiry-concurrency.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:relic": "playwright test tests/playwright/relic-hunters",
    "test:playwright:relic:full-stack": "RELIC_HUNTERS_FULL_STACK=1 playwright test --config apps/relic-hunters-v1/playwright.full-stack.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/ui": "^4.0.17",
    "eslint": "9.26.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.17",
    "graphology": "^0.26.0"
  },
  "dependencies": {
    "@babylonjs/loaders": "^9.6.2"
  }
}
