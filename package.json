{
  "name": "ar-platform-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "run:test": "npm run test --workspaces",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "dev:ar-eye-hunter-v1": "npm --workspace ar-eye-hunter-v1 run dev",
    "build:ar-eye-hunter-v1": "npm --workspace ar-eye-hunter-v1 run build",
    "dev:api": "cd apps/api && deno task dev",
    "dev:api-v1": "cd apps/api-v1 && deno task dev",
    "dev:relic-hunter-server-v1": "cd apps/relic-hunter-server-v1 && deno task dev",
    "dev:relic-hunters-v1": "npm --workspace relic-hunters-v1 run dev",
    "build:relic-hunters-v1": "npm --workspace relic-hunters-v1 run build",
    "dev:rallar-black-box": "npm --workspace rallar-black-box run dev",
    "build:rallar-black-box": "npm --workspace rallar-black-box run build",
    "dev:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task dev",
    "check:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task check",
    "test:rallar-black-box-control": "cd apps/rallar-black-box-control-server && deno task test",
    "dev:rallar-black-box:api-v1": "CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176 deno run --watch --env-file=apps/api-v1/.env.local --env-file=apps/api-v1/.env --env-file=.env --config apps/api-v1/deno.json --allow-net --allow-env --allow-read apps/api-v1/src/main.ts",
    "start:rallar-black-box:api-v1": "CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176 deno run --env-file=apps/api-v1/.env.local --env-file=apps/api-v1/.env --env-file=.env --config apps/api-v1/deno.json --allow-net --allow-env --allow-read apps/api-v1/src/main.ts",
    "start:rallar-black-box:api-v1:memory": "CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176 RALLAR_SQL_BACKEND=pglite-memory RALLAR_PGLITE_DATA_DIR=memory:// RALLAR_PGLITE_SCHEMA_INIT=auto RALLAR_DB_PUBSUB=local RALLAR_ICE_MODE=local RALLAR_LOGIN_USER_RATE_LIMIT=100 deno run --config apps/api-v1/deno.json --allow-net --allow-env --allow-read apps/api-v1/src/main.ts",
    "dev:rallar-black-box:control-server": "cd apps/rallar-black-box-control-server && deno task dev",
    "start:rallar-black-box:control-server": "cd apps/rallar-black-box-control-server && deno task start",
    "dev:rallar-black-box:servers": "npm run dev:rallar-black-box:api-v1 & npm run dev:rallar-black-box:control-server & wait",
    "start:rallar-black-box:servers": "npm run start:rallar-black-box:api-v1 & npm run start:rallar-black-box:control-server & wait",
    "start:rallar-black-box:servers:memory": "npm run start:rallar-black-box:api-v1:memory & npm run start:rallar-black-box:control-server & wait",
    "dev:rallar-black-box:all": "npm run dev:rallar-black-box:api-v1 & npm run dev:rallar-black-box:control-server & npm run dev:rallar-black-box -- --port 5176 & wait",
    "test:e2e:rallar-black-box": "playwright test --config apps/rallar-black-box/playwright.config.ts",
    "test:e2e:rallar-black-box:full-stack": "playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts",
    "test:e2e:rallar-black-box:full-stack:real": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts",
    "test:e2e:rallar-black-box:full-stack:real:manual": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-manual-rallar-realtime.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:rest": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-rest-workbench.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:control": "RALLAR_BLACK_BOX_FULL_STACK=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-control-orchestration.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:distributed": "RALLAR_BLACK_BOX_FULL_STACK=1 RALLAR_BLACK_BOX_DISTRIBUTED_RECIPES=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-distributed-recipes.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:live-rtc-3": "RALLAR_BLACK_BOX_FULL_STACK=1 RALLAR_BLACK_BOX_LIVE_RTC_MATRIX=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-live-rtc-three-browser-matrix.spec.ts",
    "test:e2e:rallar-black-box:full-stack:real:live-rtc-3:all": "RALLAR_BLACK_BOX_FULL_STACK=1 RALLAR_BLACK_BOX_LIVE_RTC_MATRIX=1 RALLAR_BLACK_BOX_LIVE_ALL_SCENARIOS=1 VITE_RALLAR_API_BASE_URL=http://localhost:8080 playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-live-rtc-three-browser-matrix.spec.ts",
    "test:e2e:rallar-black-box:full-stack:memory": "RALLAR_BLACK_BOX_FULL_STACK=1 RALLAR_BLACK_BOX_API_MODE=memory playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-command-center-qa-matrix.spec.ts tests/playwright/rallar-black-box/full-stack-rest-workbench.spec.ts tests/playwright/rallar-black-box/full-stack-quick-test-ws.spec.ts",
    "test:e2e:rallar-black-box:full-stack:memory:live-rtc-3": "RALLAR_BLACK_BOX_FULL_STACK=1 RALLAR_BLACK_BOX_API_MODE=memory RALLAR_BLACK_BOX_LIVE_RTC_MATRIX=1 VITE_RALLAR_APPLICATION_ID=rallar-server VITE_RALLAR_ROOM_ID=rallar-bb-memory-live-rtc VITE_RALLAR_AGENT_A_USERNAME=alice VITE_RALLAR_AGENT_A_PASSWORD=secret VITE_RALLAR_AGENT_B_USERNAME=bob VITE_RALLAR_AGENT_B_PASSWORD=secret VITE_RALLAR_AGENT_C_USERNAME=charlie VITE_RALLAR_AGENT_C_PASSWORD=secret playwright test --config apps/rallar-black-box/playwright.full-stack.config.ts tests/playwright/rallar-black-box/full-stack-live-rtc-three-browser-matrix.spec.ts",
    "check:shared-test": "npm --workspace @ar-eye-hunter/shared-test run check",
    "test:shared-black-box:browser:dry": "npm --workspace @ar-eye-hunter/shared-test run bb:browser:validate:dry",
    "test:shared-black-box:browser:live": "npm --workspace @ar-eye-hunter/shared-test run bb:browser:validate:live",
    "test:shared-black-box:companion": "vitest run --testTimeout=15000 packages/tests/shared-test/rallar-companion-coverage.test.ts packages/tests/shared-test/rallar-bb-test.test.ts packages/tests/shared-test/rallar-provider-parity.test.ts packages/tests/shared-web/rallar-flow.test.ts packages/tests/shared-web/rallar-operation-options.test.ts packages/tests/shared-web/rallar-data.test.ts packages/tests/shared-server/rallar-server-app-data.test.ts packages/tests/api-v1/rallar-server-ws-facade.test.ts",
    "test:shared-black-box:composite-conformance": "vitest run packages/tests/shared-test/rallar-bb-test-composite-conformance.test.ts",
    "test:shared-black-box:dry": "npm --workspace @ar-eye-hunter/shared-test run bb:dry:provider-parity",
    "test:shared-black-box:matrix:deterministic": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:deterministic",
    "test:shared-black-box:matrix:dry": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:dry",
    "test:shared-black-box:matrix:live": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live",
    "test:shared-black-box:matrix:live:parallel": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live:parallel",
    "test:shared-black-box:matrix:live:preflight": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live:preflight",
    "test:shared-black-box:matrix:live:soak": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live:soak",
    "test:shared-black-box:matrix:live:strict": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live:strict",
    "test:shared-black-box:matrix:live:traffic": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:live:traffic",
    "test:shared-black-box:matrix:parallel": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:parallel",
    "test:shared-black-box:matrix:quick": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:quick",
    "test:shared-black-box:matrix:soak": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:soak",
    "test:shared-black-box:matrix:traffic": "npm --workspace @ar-eye-hunter/shared-test run bb:matrix:traffic",
    "test:shared-black-box:memory": "npm --workspace @ar-eye-hunter/shared-test run bb:memory:delivery",
    "test:shared-black-box:memory:parallel": "npm --workspace @ar-eye-hunter/shared-test run bb:memory:parallel",
    "test:shared-black-box:memory:scale": "npm --workspace @ar-eye-hunter/shared-test run bb:memory:scale",
    "test:shared-black-box:memory:soak": "npm --workspace @ar-eye-hunter/shared-test run bb:memory:soak",
    "test:shared-black-box:memory:traffic": "npm --workspace @ar-eye-hunter/shared-test run bb:memory:traffic",
    "test:shared-black-box:remote:dry": "npm --workspace @ar-eye-hunter/shared-test run bb:remote:provider-parity:dry",
    "test": "vitest run",
    "test:postgres:presence-expiry": "RALLAR_POSTGRES_INTEGRATION=1 DATABASE_URL=${DATABASE_URL:-postgres://app:app@localhost:5432/appdb} deno run -A --unstable-temporal --node-modules-dir=auto --no-lock npm:vitest run packages/tests/shared-server/postgres-presence-expiry-concurrency.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:relic": "playwright test tests/playwright/relic-hunters",
    "test:playwright:relic:full-stack": "RELIC_HUNTERS_FULL_STACK=1 playwright test --config apps/relic-hunters-v1/playwright.full-stack.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/ui": "^4.0.17",
    "eslint": "9.26.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.17",
    "graphology": "^0.26.0"
  },
  "dependencies": {
    "@babylonjs/loaders": "^9.6.2"
  }
}
