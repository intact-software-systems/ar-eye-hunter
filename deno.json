{
  "nodeModulesDir": "manual",
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test:queue": "deno run -A --unstable-temporal npm:vitest@4.0.17 run packages/tests/queue.test.ts",
    "test:debug": "deno run -A --unstable-temporal npm:vitest@4.0.17 run",
    "qbox": "deno run -A --unstable-temporal npm:vitest@4.0.17 run --inspect-brk=127.0.0.1:53287 packages/tests/queue.test.ts --no-file-parallelism",
    "async": "deno run -A --unstable-temporal npm:vitest@4.0.17 run --inspect-brk=127.0.0.1:53287 packages/tests/ComputeAsynctask.test.ts --no-file-parallelism",
    "engine": "deno run -A --unstable-temporal npm:vitest@4.0.17 run --inspect-brk=127.0.0.1:53287 packages/tests/engine.test.ts --no-file-parallelism"
  },
  "imports": {
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "@relic-hunters/": "./packages/relic-hunters/",
    "@shared-graph/": "./packages/shared-graph/",
    "@shared-server/": "./packages/shared-server/",
    "@shared-test/": "./packages/shared-test/",
    "@shared-web/": "./packages/shared-web/",
    "@shared/": "./packages/shared/",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/path": "jsr:@std/path@^1.0.9",
    "graphology": "npm:graphology@0.26.0",
    "postgres": "npm:postgres@^3.4.9",
    "prisma": "npm:prisma@^7.8.0"
  },
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "strict": true,
    "lib": [
      "deno.ns",
      "dom"
    ]
  },
  "fmt": {
    "include": [
      "deno.json",
      "apps/api-v1",
      "apps/rallar-black-box-control-server",
      "apps/relic-hunter-server-v1"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": true
  },
  "lint": {
    "include": [
      "apps/api-v1",
      "apps/rallar-black-box-control-server",
      "apps/relic-hunter-server-v1"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
