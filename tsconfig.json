{
  "files": [],
  "references": [
    {
      "path": "packages/shared"
    },
    {
      "path": "packages/shared-graph"
    },
    {
      "path": "packages/shared-server"
    },
    {
      "path": "packages/relic-hunters"
    }
  ],
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "WebWorker"
    ],
    "paths": {
      "@shared-web/*": [
        "./packages/shared-web/*"
      ],
      "@shared-server/*": [
        "./packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "./packages/shared-graph/*"
      ],
      "@shared-test/*": [
        "./packages/shared-test/*"
      ],
      "@shared/*": [
        "./packages/shared/*"
      ],
      "@relic-hunters/*": [
        "./packages/relic-hunters/*"
      ]
    }
  },
  "exclude": [
    "./packages/tests"
  ]
}
