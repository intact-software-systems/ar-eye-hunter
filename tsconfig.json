{
  "files": [],
  "references": [
    {
      "path": "packages/shared"
    },
    {
      "path": "packages/shared-graph"
    },
    {
      "path": "apps/web"
    }
  ],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "deno.ns",
      "deno.unstable"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "WebWorker"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared-web/*": [
        "packages/shared-web/*"
      ],
      "@shared-graph/*": [
        "packages/shared-graph/*"
      ],
      "@shared/*": [
        "packages/shared/*"
      ]
    }
  },
  "exclude": [
    "packages/tests"
  ]
}
