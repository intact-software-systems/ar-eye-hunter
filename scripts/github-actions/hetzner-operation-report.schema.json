{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetznerOperationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "phase",
    "stage",
    "failureCategory",
    "component",
    "exitCode",
    "commitSha",
    "manifestPath",
    "controlRunId",
    "distributedRunId",
    "distributedArtifactAvailable",
    "recipeStarted",
    "startedAt",
    "finishedAt",
    "evidenceExcerpt",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["succeeded", "failed"] },
    "phase": { "enum": ["full", "prepare", "run"] },
    "stage": { "type": "string", "minLength": 1 },
    "failureCategory": { "type": "string", "minLength": 1 },
    "component": { "type": "string", "minLength": 1 },
    "exitCode": { "type": "integer", "minimum": 0 },
    "commitSha": { "type": "string", "minLength": 1 },
    "manifestPath": { "type": "string", "minLength": 1 },
    "controlRunId": { "type": "string", "minLength": 1 },
    "distributedRunId": { "type": "string", "minLength": 1 },
    "distributedArtifactAvailable": { "type": "boolean" },
    "recipeStarted": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "evidenceExcerpt": { "type": "string" },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}
