{
  "description": "Real Relic HTTP commands: issued identity, URL scope, idempotency, full round progression and escape, reset replay, withdrawal quorum, continuity command replay and authority, absent hunters and archived-room fencing. Physical seven-day purge is covered by database-clock integration tests.",
  "variables": {
    "apiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:8090"
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "gameId": "relic-http-{runId}",
    "password": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{apiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "postRunAssertions": [
    {
      "name": "no failed steps",
      "path": "summary.failure",
      "eq": 0
    }
  ],
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/relic-http-alice-{runId}",
        "body": {
          "username": "alice",
          "password": "{password}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuth",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/relic-http-bob-{runId}",
        "body": {
          "username": "bob",
          "password": "{password}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuth",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "unavailableBeforeCreation",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/relic/games/{gameId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 404
      }
    },
    {
      "name": "createTemporaryRoom",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/rallar-server/workspaces/default/groups/requests/relic-create-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{gameId}",
          "displayName": "Relic HTTP test {runId}",
          "kind": "room",
          "joinMode": "open",
          "retention": {
            "mode": "temporary"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{gameId}",
            "status": "active"
          }
        }
      }
    },
    {
      "name": "readEmptyExpeditionWithoutInitialization",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/relic/games/{gameId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "cannotLeaveAbsentExpedition",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/relic/games/{gameId}/commands/requests/cannotLeaveAbsentExpedition-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "protocolVersion": 1,
          "kind": "leave-expedition"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": "refused",
          "code": "expedition-unavailable"
        }
      }
    },
    {
      "name": "cannotTakeAbsentExpedition",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/relic/games/{gameId}/commands/requests/cannotTakeAbsentExpedition-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "protocolVersion": 1,
          "kind": "take-keeper"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "status": "refused",
          "code": "expedition-unavailable"
        }
      }
    },
