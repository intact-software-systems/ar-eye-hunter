      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/relic/games/{gameId}/initialize/requests/initialize-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "initialCreatedAt": "body.createdAtEpochMs"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "gameId": "{gameId}",
          "phase": "lobby",
          "players": []
        }
      }
    },
    {
      "name": "rejectInvalidCommand",
