{
  "name": "relic-hunter-server-v1",
  "exports": {},
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./",
    "@relic-hunters/": "../../packages/relic-hunters/",
    "@shared-web/": "../../packages/shared-web/",
    "@shared-server/": "../../packages/shared-server/",
    "@shared-graph/": "../../packages/shared-graph/",
    "@shared/": "../../packages/shared/",
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.4.1",
    "postgres": "npm:postgres@^3.4.9",
    "graphology": "npm:graphology@0.26.0"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read"
  },
  "deploy": {
    "org": "intact-software-systems",
    "app": "relic-hunters",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/main.ts",
      "cwd": "."
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": true
  },
  "exclude": [
    "**/node_modules/**",
    "**/*.js"
  ]
}
