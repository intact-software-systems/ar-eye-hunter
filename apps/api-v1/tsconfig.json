{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": [
      "deno.ns",
      "deno.unstable"
    ],
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "esnext"
    ]
  },
  "include": ["**/*.ts"]
}
