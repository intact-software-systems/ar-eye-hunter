{
  "name": "ar-eye-hunter-api-v1",
  "exports": {},
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./",
    "@shared-web/": "../../packages/shared-web/",
    "@shared-graph/": "../../packages/shared-graph/",
    "@shared/": "../../packages/shared/",
    "@deno/kv": "npm:@deno/kv@0.13.0",
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "prisma": "npm:prisma@^7.8.0",
    "postgres": "npm:postgres@^3.4.9",
    "graphology": "npm:graphology@0.26.0"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --unstable-kv src/main.ts",
    "start": "deno run --allow-net --allow-env --unstable-kv src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "prisma": "deno run -A --allow-scripts=npm:prisma@7.4.0,npm:@prisma/engines@7.4.0 npm:prisma@7.4.0",
    "db:migrate:dev": "deno task prisma migrate dev",
    "db:migrate:create": "deno task prisma migrate dev --create-only",
    "db:migrate:deploy": "deno task prisma migrate deploy",
    "db:pull": "deno task prisma db pull",
    "db:studio": "deno task prisma studio",
    "db:status": "deno task prisma migrate status"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true
  },
  "unstable": [
    "kv"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.js"
  ]
}
