datasource db {
  provider = "postgresql"
}

model resource_inbox {
  ri_row_id      BigInt    @id(map: "ri_pk") @default(autoincrement())
  ri_resource_id String    @db.VarChar(128)
  ri_topic_id    String    @db.VarChar(36)
  ri_resource    String
  ri_type_id     String    @db.VarChar(36)
  ri_status      String    @db.VarChar(36)
  fk_ext_bank_id String    @db.VarChar(128)
  system_date    DateTime  @db.Date
  created_by     String    @db.VarChar(16)
  created_ts     DateTime  @db.Timestamp(6)
  start_ts       DateTime? @db.Timestamp(6)
  end_ts         DateTime? @db.Timestamp(6)
  next_ts        DateTime? @db.Timestamp(6)
  ri_attempts    BigInt?
  expire_ts      DateTime  @db.Timestamp(6)

  @@unique([fk_ext_bank_id, ri_resource_id, ri_topic_id], map: "resource_inbox_unique_k")
  @@index([expire_ts], map: "resource_inbox_expire_ts_ix")
  @@index([ri_status, ri_type_id], map: "resource_inbox_ix")
  @@index([ri_type_id, ri_status, expire_ts, next_ts, ri_row_id], map: "resource_inbox_runnable_ix")
  @@index([ri_type_id, ri_status, start_ts, expire_ts, ri_row_id], map: "resource_inbox_reserved_timeout_ix")
}

model runtime_state_store {
  store_namespace String
  store_key       String
  store_value     String
  updated_ts      DateTime @default(now()) @db.Timestamptz(6)
  expire_at_ts    DateTime @db.Timestamptz(6)
  revision        BigInt   @default(0)

  @@id([store_namespace, store_key], map: "runtime_state_store_pk")
  @@index([expire_at_ts], map: "runtime_state_store_expire_at_ix")
  @@index([store_namespace, expire_at_ts], map: "runtime_state_store_namespace_expire_at_ix")
  @@index([store_namespace], map: "runtime_state_store_namespace_ix")
}

model app_data_store {
  app_namespace  String
  store_name     String
  data_key       String
  data_value     String
  schema_version Int      @default(1)
  expire_at_ts   DateTime @db.Timestamptz(6)
  updated_ts     DateTime @default(now()) @db.Timestamptz(6)
  revision       BigInt   @default(0)

  @@id([app_namespace, store_name, data_key], map: "app_data_store_pk")
  @@index([app_namespace, store_name], map: "app_data_store_store_ix")
  @@index([expire_at_ts], map: "app_data_store_expire_at_ix")
  @@index([app_namespace, expire_at_ts], map: "app_data_store_namespace_expire_at_ix")
}

model resource_inbox_results {
  ris_row_id      BigInt   @id(map: "ris_pk") @default(autoincrement())
  ris_resource_id String   @db.VarChar(128)
  ris_topic_id    String   @db.VarChar(36)
  ris_resource    String
  ris_type_id     String   @db.VarChar(36)
  ris_status      String   @db.VarChar(36)
  fk_ext_bank_id  String   @db.VarChar(128)
  system_date     DateTime @db.Date
  created_by      String   @db.VarChar(16)
  created_ts      DateTime @db.Timestamp(6)
  expire_ts       DateTime @db.Timestamp(6)

  @@unique([fk_ext_bank_id, ris_resource_id, ris_topic_id], map: "resource_inbox_results_unique_k")
  @@index([expire_ts], map: "resource_inbox_results_expire_ts_ix")
  @@index([ris_status, ris_type_id], map: "resource_inbox_results_ix")
}

model client_state_events {
  application_id       String
  workspace_key        String
  principal_id         String
  event_id             String
  event_type           String
  snapshot_version     BigInt
  occurred_at_epoch_ms BigInt
  client_instance_id   String?
  session_id           String?
  event_json           String

  @@id([application_id, workspace_key, principal_id, event_id], map: "client_state_events_pk")
  @@index([application_id, workspace_key, principal_id, snapshot_version, occurred_at_epoch_ms, event_id], map: "client_state_events_page_ix")
  @@index([application_id, workspace_key, principal_id, event_type, snapshot_version, occurred_at_epoch_ms, event_id], map: "client_state_events_type_page_ix")
}

model group_state_events {
  application_id       String
  workspace_key        String
  group_id             String
  event_id             String
  event_type           String
  snapshot_version     BigInt
  occurred_at_epoch_ms BigInt
  event_json           String

  @@id([application_id, workspace_key, group_id, event_id], map: "group_state_events_pk")
  @@index([application_id, workspace_key, group_id, snapshot_version, occurred_at_epoch_ms, event_id], map: "group_state_events_page_ix")
  @@index([application_id, workspace_key, group_id, event_type, snapshot_version, occurred_at_epoch_ms, event_id], map: "group_state_events_type_page_ix")
}

model crdt_documents {
  document_key         String    @id(map: "crdt_documents_pk")
  application_id       String
  workspace_id         String?
  document_scope       String
  document_type        String
  document_id          String
  document_ref         String
  document_revision    BigInt    @default(1)
  lifecycle            String    @default("active")
  created_at_ts        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at_ts        DateTime  @default(now()) @db.Timestamptz(6)
  archived_at_ts       DateTime? @db.Timestamptz(6)
  destroyed_at_ts      DateTime? @db.Timestamptz(6)
  last_append_sequence BigInt    @default(0)
  update_count         BigInt    @default(0)
  snapshot_count       BigInt    @default(0)
  stored_update_bytes  BigInt    @default(0)
  retention_policy     String?
  quota_policy         String?
  projection_ids       String?
  updates              crdt_updates[]
  snapshots            crdt_snapshots[]

  @@index([application_id, workspace_id, document_scope, document_type], map: "crdt_documents_lookup_ix")
  @@index([lifecycle], map: "crdt_documents_lifecycle_ix")
}

model crdt_updates {
  document_key         String
  append_sequence      BigInt
  update_id            String
  update_envelope      String
  accepted_update_hash String
  actor_id             String
  principal_id         String
  session_id           String
  server_id            String
  authorization_scope  String
  accepted_at_ts       DateTime       @default(now()) @db.Timestamptz(6)
  document             crdt_documents @relation(fields: [document_key], references: [document_key], onDelete: Cascade, map: "crdt_updates_document_fk")

  @@id([document_key, append_sequence], map: "crdt_updates_pk")
  @@unique([document_key, update_id], map: "crdt_updates_update_id_uq")
  @@index([document_key, append_sequence], map: "crdt_updates_document_sequence_ix")
  @@index([update_id], map: "crdt_updates_update_id_ix")
}

model crdt_snapshots {
  document_key      String
  snapshot_id       String
  append_sequence   BigInt
  snapshot_envelope String
  created_at_ts     DateTime       @default(now()) @db.Timestamptz(6)
  reason            String
  document          crdt_documents @relation(fields: [document_key], references: [document_key], onDelete: Cascade, map: "crdt_snapshots_document_fk")

  @@id([document_key, snapshot_id], map: "crdt_snapshots_pk")
  @@index([document_key, append_sequence(sort: Desc)], map: "crdt_snapshots_document_append_ix")
}
