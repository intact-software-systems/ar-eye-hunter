{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@shared-web/*": ["../../packages/shared-web/*"],
      "@shared-graph/*": ["../../packages/shared-graph/*"],
      "@shared/*": ["../../packages/shared/*"]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../types/**/*.d.ts"
  ]
}
