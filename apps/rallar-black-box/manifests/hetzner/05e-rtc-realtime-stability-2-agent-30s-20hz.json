{
  "schemaVersion": 1,
  "distributedRunId": "hetzner-rtc-realtime-stability-2-agent-30s-20hz",
  "controlRunId": "hetzner-manifest-template-control-run",
  "displayName": "RTC realtime stability 2-agent 30s 20 Hz",
  "group": {
    "applicationId": "rallar-server",
    "workspaceId": "default",
    "groupId": "hetzner-headless-room"
  },
  "recipes": [
    {
      "recipeId": "rtc-realtime-stability",
      "recipe": {
        "recipeId": "rtc-realtime-stability",
        "name": "RTC realtime stability stream",
        "description": "Connect RTC and send a lower-rate stream intended as a green realtime stability baseline.",
        "continueOnFailure": false,
        "metadata": {
          "profile": "rtc-realtime-stability",
          "rateHz": 20,
          "intervalMs": 50,
          "durationSeconds": 30,
          "frameCount": 600,
          "executionMode": "stream",
          "group": {
            "applicationId": "rallar-server",
            "workspaceId": "default",
            "groupId": "hetzner-headless-room"
          }
        },
        "commands": [
          {
            "kind": "http.request",
            "commandId": "rtc-realtime-ensure-group",
            "timeoutMs": 5000,
            "metadata": {
              "purpose": "Ensure the backend group exists before RTC room join.",
              "idempotent": true,
              "group": {
                "applicationId": "rallar-server",
                "workspaceId": "default",
                "groupId": "hetzner-headless-room"
              }
            },
            "request": {
              "method": "POST",
              "path": "/api/state/apps/rallar-server/workspaces/default/groups",
              "body": {
                "requestId": "rtc-realtime:ensure-group:rallar-server:default:hetzner-headless-room:{auth.sessionId}",
                "groupId": "hetzner-headless-room",
                "displayName": "hetzner-headless-room",
                "kind": "room",
                "joinMode": "open"
              }
            },
            "response": {
              "body": "json",
              "acceptedStatusCodes": [
                200,
                201,
                409
              ]
            }
          },
          {
            "kind": "http.request",
            "commandId": "rtc-realtime-ensure-member",
            "timeoutMs": 5000,
            "metadata": {
              "purpose": "Ensure the logged-in browser client is an active group member before RTC room join.",
              "idempotent": true,
              "group": {
                "applicationId": "rallar-server",
                "workspaceId": "default",
                "groupId": "hetzner-headless-room"
              }
            },
            "request": {
              "method": "PUT",
              "path": "/api/state/apps/rallar-server/workspaces/default/groups/hetzner-headless-room/members/{auth.clientId}",
              "body": {
                "requestId": "rtc-realtime:ensure-member:rallar-server:default:hetzner-headless-room:{auth.clientId}:{auth.sessionId}",
                "status": "active"
              }
            },
            "response": {
              "body": "json",
              "acceptedStatusCodes": [
                200,
                201
              ]
            }
          },
          {
            "kind": "rtc.connect",
            "commandId": "rtc-realtime-connect",
            "connection": "rtcRealtime",
            "actor": "{auth.clientId}",
            "roomId": "hetzner-headless-room",
            "applicationId": "rallar-server",
            "workspaceId": "default",
            "roomRef": {
              "applicationId": "rallar-server",
              "workspaceId": "default",
              "groupId": "hetzner-headless-room"
            },
            "transport": "realtime",
            "timeoutMs": 15000,
            "readiness": {
              "minReadyPeers": 1,
              "timeoutMs": 10000,
              "intervalMs": 100
            },
            "metadata": {
              "realtime": {
                "rateHz": 20,
                "durationSeconds": 30,
                "frameCount": 600
              }
            }
          },
          {
            "kind": "rtc.stream",
            "commandId": "rtc-realtime-position-stream",
            "connection": "rtcRealtime",
            "actor": "{auth.clientId}",
            "transport": "realtime",
            "applicationId": "rallar-server",
            "workspaceId": "default",
            "roomId": "hetzner-headless-room",
            "roomRef": {
              "applicationId": "rallar-server",
              "workspaceId": "default",
              "groupId": "hetzner-headless-room"
            },
            "count": 600,
            "intervalMs": 50,
            "maxInFlight": 64,
            "drainTimeoutMs": 5000,
            "progressEveryMs": 1000,
            "sampleEvery": 1,
            "continueOnSendFailure": true,
            "thresholds": {
              "minSendSuccessRatio": 0.95,
              "maxDroppedFrames": 30,
              "maxP95SendDurationMs": 2500,
              "maxP99SendDurationMs": 4000
            },
            "metadata": {
              "realtime": {
                "rateHz": 20,
                "intervalMs": 50,
                "durationSeconds": 30,
                "frameCount": 600,
                "executionMode": "stream"
              }
            },
            "send": {
              "roomId": "hetzner-headless-room",
              "roomRef": {
                "applicationId": "rallar-server",
                "workspaceId": "default",
                "groupId": "hetzner-headless-room"
              },
              "openTimeoutMs": 10000,
              "data": {
                "topic": "room.black-box.rtc-realtime.position",
                "typeId": "room.black-box.rtc-realtime.position",
                "actor": "{auth.clientId}",
                "seq": "{stream.index}",
                "rateHz": 20,
                "intervalMs": 50,
                "durationSeconds": 30,
                "totalFrames": 600,
                "tMs": "{stream.elapsedMs}",
                "position": {
                  "frame": "{stream.iteration}",
                  "x": "{stream.index}",
                  "y": 0,
                  "z": "{stream.index}",
                  "headingDeg": "{stream.index}",
                  "velocityMps": 4
                }
              }
            }
          },
          {
            "kind": "stats",
            "commandId": "rtc-realtime-stats",
            "metadata": {
              "realtime": {
                "rateHz": 20,
                "durationSeconds": 30,
                "frameCount": 600
              }
            }
          }
        ]
      },
      "role": "sender",
      "profile": "rtc",
      "required": true
    },
    {
      "recipeId": "rtc-realtime-stability-receiver",
      "recipe": {
        "schemaVersion": 1,
        "recipeId": "rtc-realtime-stability-receiver",
        "name": "RTC realtime stability receiver hold",
        "description": "Connect RTC and keep the receiver alive while the 20 Hz sender stream runs.",
        "continueOnFailure": false,
        "metadata": {
          "profile": "rtc-realtime-stability-receiver",
          "rateHz": 20,
          "intervalMs": 50,
          "durationSeconds": 30,
          "frameCount": 600,
          "executionMode": "stream",
          "group": {
            "applicationId": "rallar-server",
            "workspaceId": "default",
            "groupId": "hetzner-headless-room"
          },
          "role": "receiver"
        },
        "commands": [
          {
            "kind": "http.request",
            "commandId": "rtc-realtime-ensure-group",
            "timeoutMs": 5000,
            "metadata": {
              "purpose": "Ensure the backend group exists before RTC room join.",
              "idempotent": true,
              "group": {
                "applicationId": "rallar-server",
                "workspaceId": "default",
                "groupId": "hetzner-headless-room"
              }
            },
            "request": {
              "method": "POST",
              "path": "/api/state/apps/rallar-server/workspaces/default/groups",
              "body": {
                "requestId": "rtc-realtime:ensure-group:rallar-server:default:hetzner-headless-room:{auth.sessionId}",
                "groupId": "hetzner-headless-room",
                "displayName": "hetzner-headless-room",
                "kind": "room",
                "joinMode": "open"
              }
            },
            "response": {
              "body": "json",
              "acceptedStatusCodes": [
                200,
                201,
                409
              ]
            }
          },
          {
            "kind": "http.request",
            "commandId": "rtc-realtime-ensure-member",
            "timeoutMs": 5000,
            "metadata": {
              "purpose": "Ensure the logged-in browser client is an active group member before RTC room join.",
              "idempotent": true,
              "group": {
                "applicationId": "rallar-server",
                "workspaceId": "default",
                "groupId": "hetzner-headless-room"
              }
            },
            "request": {
              "method": "PUT",
              "path": "/api/state/apps/rallar-server/workspaces/default/groups/hetzner-headless-room/members/{auth.clientId}",
              "body": {
                "requestId": "rtc-realtime:ensure-member:rallar-server:default:hetzner-headless-room:{auth.clientId}:{auth.sessionId}",
                "status": "active"
              }
            },
            "response": {
              "body": "json",
              "acceptedStatusCodes": [
                200,
                201
              ]
            }
          },
          {
            "kind": "rtc.connect",
            "commandId": "rtc-realtime-connect",
            "connection": "rtcRealtime",
            "actor": "{auth.clientId}",
            "roomId": "hetzner-headless-room",
            "applicationId": "rallar-server",
            "workspaceId": "default",
            "roomRef": {
              "applicationId": "rallar-server",
              "workspaceId": "default",
              "groupId": "hetzner-headless-room"
            },
            "transport": "realtime",
            "timeoutMs": 15000,
            "readiness": {
              "minReadyPeers": 1,
              "timeoutMs": 10000,
              "intervalMs": 100
            },
            "metadata": {
              "realtime": {
                "rateHz": 20,
                "durationSeconds": 30,
                "frameCount": 600
              }
            }
          },
          {
            "kind": "loop",
            "commandId": "rtc-realtime-receiver-stats-loop",
            "count": 35,
            "intervalMs": 1000,
            "maxCommands": 35,
            "metadata": {
              "realtime": {
                "role": "receiver",
                "rateHz": 20,
                "durationSeconds": 30,
                "frameCount": 600
              }
            },
            "commands": [
              {
                "kind": "stats",
                "commandId": "rtc-realtime-receiver-stats",
                "metadata": {
                  "realtime": {
                    "role": "receiver",
                    "rateHz": 20,
                    "durationSeconds": 30,
                    "frameCount": 600
                  }
                }
              }
            ]
          }
        ]
      },
      "role": "receiver",
      "profile": "rtc",
      "required": true
    }
  ],
  "targetPolicy": {
    "mode": "role-map",
    "roles": {
      "sender": [
        "controller-01"
      ],
      "receiver": [
        "controller-02"
      ]
    },
    "expectedParticipantCount": 2
  },
  "roleAssignments": [
    {
      "role": "sender",
      "agentId": "controller-01",
      "required": true
    },
    {
      "role": "receiver",
      "agentId": "controller-02",
      "required": true
    }
  ],
  "ackTimeoutMs": 30000,
  "startMode": "manual",
  "artifactPolicy": {
    "retainArtifacts": true,
    "includeDistributedMetadata": true,
    "includeEventJsonl": true,
    "includeResultJsonl": true,
    "includeFailureBundle": true
  },
  "metadata": {
    "createdBy": "rallar-black-box-spa",
    "rolePattern": "sender-receiver",
    "manifestSuite": "hetzner-distributed",
    "diagnostic": false,
    "expectedFailure": false
  },
  "description": "Highest-rate 20 Hz RTC realtime stability stream with one sender and one receiver for sustained pacing evidence."
}
