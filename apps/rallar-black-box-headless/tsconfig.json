{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "paths": {
      "@shared-test/*": [
        "../../packages/shared-test/*"
      ],
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/shared-test/rallar-bb-test/**/*.ts",
    "../../packages/shared-test/black-box-runner/browser/**/*.ts",
    "../../types/**/*.d.ts"
  ]
}
