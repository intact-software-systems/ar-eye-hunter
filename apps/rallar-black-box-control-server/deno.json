{
  "name": "rallar-black-box-control-server",
  "exports": {},
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "imports": {
    "@shared/": "../../packages/shared/",
    "@shared-server/": "../../packages/shared-server/",
    "@shared-test/": "../../packages/shared-test/"
  },
  "tasks": {
    "dev": "DENO_NO_PACKAGE_JSON=1 deno run --watch --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "start": "DENO_NO_PACKAGE_JSON=1 deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "check": "DENO_NO_PACKAGE_JSON=1 deno check src/main.ts test/",
    "test": "DENO_NO_PACKAGE_JSON=1 deno test --allow-run --allow-net --allow-env --allow-read --allow-write"
  },
  "deploy": {
    "org": "intact-software-systems",
    "app": "rallar-bb-server",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/main.ts",
      "cwd": "."
    }
  },
  "compilerOptions": {
    "strict": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  }
}
