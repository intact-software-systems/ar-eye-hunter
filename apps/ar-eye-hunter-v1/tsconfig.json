{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "paths": {
      "@shared-react/*": [
        "../../packages/shared-react/*"
      ],
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../types/**/*.d.ts"
  ]
}
