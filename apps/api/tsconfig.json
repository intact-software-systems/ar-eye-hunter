{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": [
      "deno.ns",
      "deno.unstable"
    ],
    "lib": [
      "dom",
      "esnext"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
