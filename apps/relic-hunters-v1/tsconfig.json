{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "paths": {
      "@relic-hunters/*": [
        "../../packages/relic-hunters/*"
      ],
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../packages/relic-hunters/**/*.ts",
    "../../types/**/*.d.ts"
  ]
}
