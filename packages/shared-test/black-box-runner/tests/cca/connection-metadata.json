{
  "variables": {
    "apiBaseUrl": {
      "env": "CCA_API_URL",
      "default": "http://localhost:8092"
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{apiBaseUrl}",
      "timeoutMs": 5000
    }
  },
  "steps": [
    {
      "name": "readConnectionMetadata",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/cca"
      },
      "expect": {
        "status": 200,
        "body": {
          "incarnation": "string",
          "serverId": "string"
        }
      },
      "outputs": {
        "connection": "body"
      }
    },
    {
      "name": "checkConnectionIdentity",
      "type": "assert",
      "actual": {
        "connection": "{connection}"
      },
      "expect": {
        "comparators": [
          {
            "path": "connection.incarnation",
            "matches": "^[0-9a-f-]{36}$"
          },
          {
            "path": "connection.serverId",
            "matches": "^.+$"
          }
        ]
      }
    },
    {
      "name": "identityStableWithinProcess",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/cca"
      },
      "expect": {
        "status": 200,
        "body": "{connection}",
        "comparison": "exact"
      }
    }
  ]
}
