    },
    {
      "name": "nonentrantWatcherReceivesUnlisting",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 10000,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "message": {
          "id": {
            "traceId": "bb-tournament-unlist-changed-{runId}"
          },
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "principal",
            "principalRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "principalId": "{danaClientId}"
            }
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": "{danaClientId}"
            }
          }
        },
        "consume": true
      },
      "request": {
        "outputs": {
          "unlistedBracketResource": "matchedMessage.data.payload.resource"
        }
      }
    },
    {
      "name": "captureunlistedBracketChange",
      "type": "set",
      "output": "unlistedBracketChangeId",
      "transform": {
        "get": [
          {
            "jsonParse": {
              "path": "outputs.unlistedBracketResource"
            }
          },
          "changeId"
        ]
      }
    },
    {
      "name": "publicDiscoveryReceivesRemoval",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 10000,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "message": {
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "world"
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament-catalog",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": null,
              "changeId": "{unlistedBracketChangeId}"
            }
          }
        },
        "consume": true
      }
    },
