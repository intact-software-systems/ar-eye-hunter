{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "applicationId": "black-box-tournaments",
    "workspaceId": "default",
    "clientPassword": {
      "default": "tournament-test-password",
      "secret": true
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "danaPreviewSocket": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "postRunAssertions": [
    {
      "name": "no failed steps",
      "path": "summary.failure",
      "eq": 0
    }
  ],
  "description": "Four-player tournament API: scoped registration, exact replay/conflict, forged authority/result refusal, durable no-show advancement through a complete bracket, and cancellation. Native game scoring is verified in game-owner and clickable SPA tests. Organizer publishing, default-unlisted scoped discovery, private personal history and completed-catalogue exclusion. A nonentrant registers before creation without entering personal history; exact private bracket and scope-public catalog WS notices cover creation, publish and unlist, while unlisted creation remains private.",
  "steps": [
    {
      "name": "registeralice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/tournaments-register-alice-{runId}",
        "body": {
          "username": "tournaments-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "loginalice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/tournaments-login-alice-{runId}",
        "body": {
          "username": "tournaments-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "aliceSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "derivealiceAuth",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerbob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/tournaments-register-bob-{runId}",
        "body": {
          "username": "tournaments-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "loginbob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/tournaments-login-bob-{runId}",
        "body": {
          "username": "tournaments-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "bobSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "derivebobAuth",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "registercharlie",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/tournaments-register-charlie-{runId}",
        "body": {
          "username": "tournaments-charlie-{runId}",
          "password": "{clientPassword}",
          "displayName": "charlie"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "logincharlie",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/tournaments-login-charlie-{runId}",
        "body": {
          "username": "tournaments-charlie-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "charlieClientId": "body.clientId",
          "charlieAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "charlieSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "derivecharlieAuth",
      "type": "set",
      "output": "charlieAuthHeader",
      "secret": true,
      "redactAs": "charlieAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.charlieAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerdana",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/tournaments-register-dana-{runId}",
        "body": {
          "username": "tournaments-dana-{runId}",
          "password": "{clientPassword}",
          "displayName": "dana"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "logindana",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/tournaments-login-dana-{runId}",
        "body": {
          "username": "tournaments-dana-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "danaClientId": "body.clientId",
          "danaAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "danaSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "derivedanaAuth",
      "type": "set",
      "output": "danaAuthHeader",
      "secret": true,
      "redactAs": "danaAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.danaAccessToken"
          }
        ]
      }
    },
    {
      "name": "anonymous",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}"
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "empty",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "tournament": null
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "createPreviewWsTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-tournament-preview-ticket-{runId}",
        "headers": {
          "Authorization": "{danaAuthHeader}",
          "x-client-id": "{danaClientId}"
        },
        "outputs": {
          "danaPreviewTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "derivePreviewWsUrl",
      "type": "set",
      "output": "danaPreviewWsUrl",
      "secret": true,
      "redactAs": "danaPreviewWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.danaSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.danaPreviewTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openPreviewSocket",
      "type": "ws.open",
      "connection": "danaPreviewSocket",
      "request": {
        "url": "{danaPreviewWsUrl}",
        "snapshotScope": {
          "applicationId": "{applicationId}",
          "workspaceId": "{workspaceId}"
        },
        "timeoutMs": 20000
      }
    },
    {
      "name": "readPreviewConnectionGeneration",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{danaClientId}",
        "headers": {
          "Authorization": "{danaAuthHeader}",
          "x-client-id": "{danaClientId}"
        },
        "outputs": {
          "danaConnectionGenerationId": "body.activeSessions.0.generationId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{danaSessionId}"
            }
          ]
        }
      }
    },
    {
      "name": "watchBracketBeforeCreation",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/view-watches/tournament/requests/bb-tournament-preview-watch-{runId}",
        "headers": {
          "Authorization": "{danaAuthHeader}",
          "x-client-id": "{danaClientId}"
        },
        "body": {
          "resourceId": "cup-{runId}",
          "connectionGenerationId": "{danaConnectionGenerationId}",
          "expectedRegistrationId": null
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "applied",
          "requestId": "bb-tournament-preview-watch-{runId}",
          "registrationId": "bb-tournament-preview-watch-{runId}",
          "resourceId": "cup-{runId}"
        }
      }
    },
    {
      "name": "replayBracketWatch",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/view-watches/tournament/requests/bb-tournament-preview-watch-{runId}",
        "headers": {
          "Authorization": "{danaAuthHeader}",
          "x-client-id": "{danaClientId}"
        },
        "body": {
          "resourceId": "cup-{runId}",
          "connectionGenerationId": "{danaConnectionGenerationId}",
          "expectedRegistrationId": null
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "applied",
          "requestId": "bb-tournament-preview-watch-{runId}",
          "registrationId": "bb-tournament-preview-watch-{runId}",
          "resourceId": "cup-{runId}"
        }
      }
    },
    {
      "name": "create",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}/requests/tournament-create-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}",
          "x-request-id": "bb-tournament-create-changed-{runId}"
        },
        "body": {
          "type": "create",
          "title": "Black-box cup"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "applied",
          "code": null
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "absentBracketWatcherReceivesCreation",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 10000,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "message": {
          "id": {
            "traceId": "bb-tournament-create-changed-{runId}"
          },
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "principal",
            "principalRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "principalId": "{danaClientId}"
            }
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": "{danaClientId}"
            }
          }
        },
        "consume": true
      },
      "request": {
        "outputs": {
          "createdBracketResource": "matchedMessage.data.payload.resource"
        }
      }
    },
    {
      "name": "capturecreatedBracketChange",
      "type": "set",
      "output": "createdBracketChangeId",
      "transform": {
        "get": [
          {
            "jsonParse": {
              "path": "outputs.createdBracketResource"
            }
          },
          "changeId"
        ]
      }
    },
    {
      "name": "unlistedCreationNeverPublishesPublicIdentity",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 1500,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "absent": {
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "world"
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament-catalog",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": null,
              "changeId": "{createdBracketChangeId}"
            }
          }
        }
      }
    },
    {
      "name": "watchDoesNotAddPersonalHistory",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/catalog?view=mine&principalId={aliceClientId}",
        "headers": {
          "Authorization": "{danaAuthHeader}",
          "x-client-id": "{danaClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "principalId": "{danaClientId}",
          "entries": []
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "defaultUnlisted",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/catalog",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "entries": []
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "nonOrganizerPublish",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}/requests/tournament-nonOrganizerPublish-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "type": "publish"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "refused",
          "code": "organizer-required"
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "publish",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}/requests/tournament-publish-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}",
          "x-request-id": "bb-tournament-publish-changed-{runId}"
        },
        "body": {
          "type": "publish"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "applied",
          "code": null
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "nonentrantWatcherReceivesListingChange",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 10000,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "message": {
          "id": {
            "traceId": "bb-tournament-publish-changed-{runId}"
          },
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "principal",
            "principalRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "principalId": "{danaClientId}"
            }
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": "{danaClientId}"
            }
          }
        },
        "consume": true
      },
      "request": {
        "outputs": {
          "publishedBracketResource": "matchedMessage.data.payload.resource"
        }
      }
    },
    {
      "name": "capturepublishedBracketChange",
      "type": "set",
      "output": "publishedBracketChangeId",
      "transform": {
        "get": [
          {
            "jsonParse": {
              "path": "outputs.publishedBracketResource"
            }
          },
          "changeId"
        ]
      }
    },
    {
      "name": "publicDiscoveryReceivesPublish",
      "type": "ws.wait",
      "connection": "danaPreviewSocket",
      "expect": {
        "connection": "danaPreviewSocket",
        "withinMs": 10000,
        "decodeJsonPaths": [
          "payload.resource"
        ],
        "message": {
          "route": {
            "topicId": "view.invalidated"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "world"
          },
          "payload": {
            "typeId": "view.invalidated",
            "resource": {
              "version": 1,
              "resource": "tournament-catalog",
              "scope": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}"
              },
              "principalId": null,
              "changeId": "{publishedBracketChangeId}"
            }
          }
        },
        "consume": true
      }
    },
    {
      "name": "discover",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/catalog",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "entries": [
            {
              "ref": {
                "applicationId": "{applicationId}",
                "workspaceId": "{workspaceId}",
                "tournamentId": "cup-{runId}"
              },
              "title": "Black-box cup",
              "activeEntrantCount": 0,
              "status": "registration"
            }
          ]
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "privateHistory",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/catalog?view=mine&principalId={aliceClientId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "principalId": "{bobClientId}",
          "entries": []
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "unlist",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/tournaments/apps/{applicationId}/workspaces/{workspaceId}/tournaments/cup-{runId}/requests/tournament-unlist-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}",
          "x-request-id": "bb-tournament-unlist-changed-{runId}"
        },
        "body": {
          "type": "unlist"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "applied",
          "code": null
        },
