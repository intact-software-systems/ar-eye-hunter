{
  "description": "No-browser API-v1 activation `degraded` band from PARTIAL coverage -- the arm api-v1-activation-clock-decay could not reach, because with one planned edge a lapsed observation is a rate of zero and the band is `failed`. Three members plan two or three edges and exactly ONE of them is ever reported. The topology is PINNED to a mesh first, so three members are three edges and the reported pair is one of them by construction rather than by the planner's size heuristics; the reporting direction is canonicalised because RTT ingestion takes the pair in order. minimumViableRate is 0.25 against successRate 0.95, so one edge of three is above the floor and below success. `degraded` is a dwell-HELD band, so this cannot be reached by one instantaneous reading, and the group must still be `connecting`: partial coverage is not activation. The formation view has to agree with the group row -- one observed edge out of a planned set of at least two.",
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_PARTIALCOVERAGE_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-partialcoverage"
    },
    "workspaceId": {
      "env": "RALLAR_BB_PARTIALCOVERAGE_WORKSPACE_ID",
      "default": "workspace-partialcoverage-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_PARTIALCOVERAGE_GROUP_ID",
      "default": "partialcoverage-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_PARTIALCOVERAGE_PASSWORD",
      "default": "api-v1-partialcoverage-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "wsAlice": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsBob": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsCarol": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/partialcoverage-register-alice-{runId}",
        "body": {
          "username": "partialcoverage-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/partialcoverage-login-alice-{runId}",
        "body": {
          "username": "partialcoverage-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/partialcoverage-ws-ticket-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/partialcoverage-register-bob-{runId}",
        "body": {
          "username": "partialcoverage-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/partialcoverage-login-bob-{runId}",
        "body": {
          "username": "partialcoverage-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/partialcoverage-ws-ticket-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "registerCarol",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/partialcoverage-register-carol-{runId}",
        "body": {
          "username": "partialcoverage-carol-{runId}",
          "password": "{clientPassword}",
          "displayName": "carol client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginCarol",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/partialcoverage-login-carol-{runId}",
        "body": {
          "username": "partialcoverage-carol-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "carolClientId": "body.clientId",
          "carolSessionId": "body.sessionId",
          "carolAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveCarolAuthHeader",
      "type": "set",
      "output": "carolAuthHeader",
      "secret": true,
      "redactAs": "carolAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.carolAccessToken"
          }
        ]
      }
    },
    {
      "name": "createCarolWsTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/partialcoverage-ws-ticket-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "outputs": {
          "carolWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveCarolWsUrl",
      "type": "set",
      "output": "carolWsUrl",
      "secret": true,
      "redactAs": "carolWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.carolSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.carolWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "createTheThresholdGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/partialcoverage-create-group-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Partial coverage {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "initiator": "manager",
            "establishment": {
              "planTrigger": {
                "kind": "manual"
              },
              "connectTrigger": {
                "kind": "manual"
              }
            },
            "admission": {
              "mode": "open"
            },
            "activation": {
              "mode": "threshold-or-deadline",
              "successRate": 0.95,
              "minimumViableRate": 0.25,
              "deadlineMs": 600000,
              "maxFormationAttempts": 3
            },
            "topology": {
              "reconfigureLanding": "hold"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "lifecycleState": "forming"
          }
        }
      }
    },
    {
      "name": "bobJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{bobClientId}/requests/partialcoverage-bob-joins-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "carolJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{carolClientId}/requests/partialcoverage-carol-joins-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectAlicePresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/partialcoverage-alice-presence-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "partialcoverage-generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{bobSessionId}/requests/partialcoverage-bob-presence-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "partialcoverage-generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectCarolPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{carolSessionId}/requests/partialcoverage-carol-presence-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "generationId": "partialcoverage-generation-{runId}",
          "principalId": "{carolClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "openAliceWs",
      "type": "ws.open",
      "connection": "wsAlice",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "openBobWs",
      "type": "ws.open",
      "connection": "wsBob",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "openCarolWs",
      "type": "ws.open",
      "connection": "wsCarol",
      "request": {
        "url": "{carolWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "pinTheTopologyToAMesh",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology/config/requests/partialcoverage-pin-mesh-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "config": {
            "topologyKind": "mesh"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "config": {
            "config": {
              "topologyKind": "mesh"
            }
          }
        }
      }
    },
    {
      "name": "planTheLayout",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/lifecycle/plan/requests/partialcoverage-plan-layout-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned"
          }
        }
      }
    },
    {
      "name": "theLayoutPublishesAndNamesAlicesHop",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 25000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "layoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "layoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "layoutVersion": "body.snapshot.version",
          "layoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "connectTheLayout",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/lifecycle/connect/requests/partialcoverage-connect-layout-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": 1,
          "expectedLayout": {
            "groupRevision": "{layoutGroupRevision}",
            "presenceRevision": "{layoutPresenceRevision}",
            "version": "{layoutVersion}",
            "state": "{layoutState}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "connecting"
          }
        }
      }
    },
    {
      "name": "deriveTheObservationTime",
      "type": "set",
      "output": "observationEpochMs",
      "transform": {
        "add": [
          {
            "timestamp": true
          },
          0
        ]
      }
    },
    {
      "name": "deriveTheCanonicalReporter",
      "type": "set",
      "output": "rttReporter",
      "transform": {
        "if": {
          "condition": {
            "operator": "lexicallyBefore",
            "values": [
              {
                "path": "outputs.aliceSessionId"
              },
              {
                "path": "outputs.bobSessionId"
              }
            ]
          },
          "then": {
            "connection": "wsAlice",
            "sessionIdFrom": {
              "path": "outputs.aliceSessionId"
            },
            "sessionIdTo": {
              "path": "outputs.bobSessionId"
            }
          },
          "else": {
            "connection": "wsBob",
            "sessionIdFrom": {
              "path": "outputs.bobSessionId"
            },
            "sessionIdTo": {
              "path": "outputs.aliceSessionId"
            }
          }
        }
      }
    },
    {
      "name": "deriveTheSingleEdgeResource",
      "type": "set",
      "output": "singleEdgeResource",
      "transform": {
        "concat": [
          "{\"sessionIdFrom\":\"",
          {
            "path": "outputs.rttReporter.sessionIdFrom"
          },
          "\",\"sessionIdTo\":\"",
          {
            "path": "outputs.rttReporter.sessionIdTo"
          },
          "\",\"rttMs\":21,\"createdAtEpochMs\":",
          {
            "path": "outputs.observationEpochMs"
          },
          ",\"version\":1}"
        ]
      }
    },
    {
      "name": "reportExactlyOneOfThePlannedEdges",
      "type": "ws.send",
      "connection": "{rttReporter.connection}",
      "request": {
        "send": {
          "id": {
            "v": 2,
            "msgId": "rtt-partialcoverage-{runId}",
            "ts": 0,
            "senderId": "{rttReporter.sessionIdFrom}",
            "sessionId": "{rttReporter.sessionIdFrom}"
          },
          "route": {
            "topicId": "rtt",
            "resourceId": "{rttReporter.sessionIdFrom} {rttReporter.sessionIdTo}",
            "contextId": "1"
          },
          "delivery": {
            "reliability": "best-effort",
            "ack": "none"
          },
          "payload": {
            "typeId": "rtt",
            "contentType": "application/json",
            "resource": "{singleEdgeResource}"
          }
        }
      }
    },
    {
      "name": "thePartialCoverageSettlesAsDegraded",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 30000,
          "backoffMs": 500,
          "backoffMultiplier": 1.1
        },
        "outputs": {
          "degradedCoverageRate": "body.group.activationStatus.coverageRate",
          "degradedCondition": "body.group.activationStatus.condition",
          "degradedLifecycleState": "body.group.lifecycleState"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "activationStatus": {
              "condition": "degraded"
            }
          }
        }
      }
    },
    {
      "name": "theDegradedBandCameFromPartialCoverage",
      "type": "assert",
      "actual": {
        "rate": "{degradedCoverageRate}",
        "condition": "{degradedCondition}",
        "lifecycleState": "{degradedLifecycleState}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "condition": "degraded",
          "lifecycleState": "connecting"
        },
        "comparators": [
          {
            "path": "rate",
            "gte": 0.25,
            "lt": 0.95
          }
        ]
      }
    },
    {
      "name": "theFormationViewCountsTheSameOneEdge",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 25000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "observedEdgeCount": "body.readiness.observedEdgeCount",
          "plannedEdgeCount": "body.readiness.plannedEdgeCount"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "exactlyOneOfSeveralPlannedEdgesWasObserved",
      "type": "assert",
      "actual": {
        "observed": "{observedEdgeCount}",
        "planned": "{plannedEdgeCount}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "comparators": [
          {
            "path": "observed",
            "equals": 1
          },
          {
            "path": "planned",
            "equals": 3
          }
        ]
      }
    },
    {
      "name": "closeAliceWs",
      "type": "ws.close",
      "connection": "wsAlice",
      "request": {
        "code": 1000,
        "reason": "done"
      }
    },
    {
      "name": "closeBobWs",
      "type": "ws.close",
      "connection": "wsBob",
      "request": {
        "code": 1000,
        "reason": "done"
      }
    },
