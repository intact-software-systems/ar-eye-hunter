          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Debounced group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "topology": {
              "replanning": "debounced",
              "debounceWindowMs": 3000,
              "maxReplanWaitMs": 4000
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": [
              "{aliceClientId}"
            ]
          }
        }
      }
    },
