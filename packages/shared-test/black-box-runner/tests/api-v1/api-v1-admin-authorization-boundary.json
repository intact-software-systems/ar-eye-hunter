        "body": {
          "error": "Forbidden: platform admin authorization required"
        }
      }
    },
    {
      "name": "aNonAdminCannotExplainAGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/support/explain/group",
        "headers": {
          "Authorization": "{outsiderAuthHeader}",
          "x-client-id": "{outsiderClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "comparison": "exact",
        "body": {
          "error": "Forbidden: platform admin authorization required"
        }
      }
    },
    {
