        }
      }
    },
    {
      "name": "anUnauthorizedAdminMutationIsReportedAsAServerFault",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/maintenance/prune-expired/requests/adminboundary-15-mutation-{runId}",
        "headers": {
          "Authorization": "{outsiderAuthHeader}",
          "x-client-id": "{outsiderClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 500,
        "comparison": "exact",
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "api-mutation-unexpected",
          "status": 500,
          "message": "API mutation failed unexpectedly",
          "issues": null,
          "denial": null,
          "retry": null
        }
      }
    },
    {
      "name": "theSameFaultShapeOnASecondAdminMutation",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/topology/recompute/requests/adminboundary-16-mutation-{runId}",
        "headers": {
          "Authorization": "{outsiderAuthHeader}",
          "x-client-id": "{outsiderClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 500,
        "comparison": "exact",
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "api-mutation-unexpected",
          "status": 500,
          "message": "API mutation failed unexpectedly",
          "issues": null,
          "denial": null,
          "retry": null
        }
      }
    }
  ],
  "postRunAssertions": [
    {
      "name": "no failed steps",
      "path": "summary.failure",
      "eq": 0
    }
  ]
}
