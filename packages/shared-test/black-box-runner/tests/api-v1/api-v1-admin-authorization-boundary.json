        "body": {
          "error": "Forbidden: platform admin authorization required"
        }
      }
    },
    {
      "name": "aNonAdminCannotReadTheQueueBreakdown",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/queues",
        "headers": {
