{
  "description": "API-v1 group presence lifecycle with the publication key on the presence row. The connect names RFC 7517 Appendix A.1's public P-256 key under its RFC 7638 thumbprint cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s; a heartbeat with the same key is a lease renewal, a heartbeat with the generated test key rZ7cyMEmbfKmfbgktAq0VhUU27CfL9ABhsUWyr3t91o replaces it, a heartbeat with null clears it, a connect whose JWK carries the private member d is refused, and the disconnect takes the session and its key out of activeSessions.",
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "api-v1-bb-group-{runId}"
    },
    "groupName": {
      "env": "RALLAR_BB_GROUP_NAME",
      "default": "API v1 black-box {runId}"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-presence",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "aliceSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "username": "{aliceUsername}",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "createGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-scope-{runId}-group-presence",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "{groupName}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "statusCode": [
          201,
          409
        ],
        "bodyAnyOf": [
          {
            "group": {
              "groupId": "{groupId}",
              "displayName": "{groupName}",
              "kind": "room"
            }
          },
          {
            "error": "string"
          }
        ]
      }
    },
    {
      "name": "rejectDuplicateGroupCreate",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-duplicate-{runId}-group-presence",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "{groupName}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "group-already-exists",
          "status": 409
        }
      }
    },
    {
      "name": "joinAliceToGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{aliceClientId}/requests/join-scope-scope-{runId}-group-presence",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          },
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "connectAliceGroupPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/presence-scope-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "connectionGenerationId": "connection-generation-{runId}",
          "publicationKey": {
            "keyId": "cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s",
            "publicJwk": {
              "kty": "EC",
              "crv": "P-256",
              "x": "MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
              "y": "4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM"
            }
          },
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "heartbeatAliceGroupPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/heartbeat/requests/heartbeat-scope-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "publicationKey": {
            "keyId": "cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s",
            "publicJwk": {
              "kty": "EC",
              "crv": "P-256",
              "x": "MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
              "y": "4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM"
            }
          },
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "pollGroupPresenceAttempt1",
      "type": "parallel",
      "nonBlockingFailure": true,
      "maxConcurrency": 1,
      "timeoutMs": 10000,
      "groups": [
        {
          "name": "presence-attempt-1",
          "steps": [
            {
              "name": "readPresenceAttempt1",
              "type": "http",
              "connection": "api",
              "request": {
                "method": "GET",
                "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
                "headers": {
                  "Authorization": "{aliceAuthHeader}",
                  "x-client-id": "{aliceClientId}"
                }
              },
              "expect": {
                "status": 200,
                "body": {
                  "activeSessions": [
                    {
                      "sessionId": "{aliceSessionId}",
                      "principalId": "{aliceClientId}",
                      "generationId": "generation-{runId}"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "delayBeforePresencePoll2",
      "type": "set",
      "output": "presencePollDelay2",
      "value": { "attempt": 2, "delayMs": 500 },
      "request": { "delayMs": 500 }
    },
    {
      "name": "pollGroupPresenceAttempt2",
      "type": "parallel",
      "nonBlockingFailure": true,
      "maxConcurrency": 1,
      "timeoutMs": 10000,
      "groups": [
        {
          "name": "presence-attempt-2",
          "steps": [
            {
              "name": "readPresenceAttempt2",
              "type": "http",
              "connection": "api",
              "request": {
                "method": "GET",
                "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
                "headers": {
                  "Authorization": "{aliceAuthHeader}",
                  "x-client-id": "{aliceClientId}"
                }
              },
              "expect": {
                "status": 200,
                "body": {
                  "activeSessions": [
                    {
                      "sessionId": "{aliceSessionId}",
                      "principalId": "{aliceClientId}",
                      "generationId": "generation-{runId}"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "delayBeforeFinalPresencePoll",
      "type": "set",
      "output": "presenceFinalPollDelay",
      "value": { "attempt": 3, "delayMs": 1000 },
      "request": { "delayMs": 1000 }
    },
    {
      "name": "readGroupSnapshot",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          },
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "active"
            }
          ],
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}",
              "principalId": "{aliceClientId}",
              "generationId": "generation-{runId}",
              "publicationKey": {
                "keyId": "cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s",
                "publicJwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
                  "y": "4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM"
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "listGroupEvents",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/events",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "listGroupEventPage",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/events/page",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "heartbeatAliceWithRotatedPublicationKey",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/heartbeat/requests/heartbeat-rotated-key-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "publicationKey": {
            "keyId": "rZ7cyMEmbfKmfbgktAq0VhUU27CfL9ABhsUWyr3t91o",
            "publicJwk": {
              "kty": "EC",
              "crv": "P-256",
              "x": "Nm2QxCrM4kTiPOiaH6lR82miJ0_zi6f1BlvTCNMRV9M",
              "y": "sB_-ygUxxhY4YLuYwL610i1uj3gwJNb1TqhRZ-VuTN8"
            }
          },
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "pollRotatedPublicationKey",
      "type": "http.poll-until",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 12,
          "maxDurationMs": 10000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}",
              "publicationKey": {
                "keyId": "rZ7cyMEmbfKmfbgktAq0VhUU27CfL9ABhsUWyr3t91o",
                "publicJwk": {
                  "kty": "EC",
                  "crv": "P-256",
                  "x": "Nm2QxCrM4kTiPOiaH6lR82miJ0_zi6f1BlvTCNMRV9M",
                  "y": "sB_-ygUxxhY4YLuYwL610i1uj3gwJNb1TqhRZ-VuTN8"
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "heartbeatAliceWithoutPublicationKey",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/heartbeat/requests/heartbeat-null-key-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "publicationKey": null,
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "pollClearedPublicationKey",
      "type": "http.poll-until",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 12,
          "maxDurationMs": 10000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}",
              "publicationKey": null
            }
          ]
        }
      }
    },
    {
      "name": "refuseConnectWithPrivateKeyMember",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/presence-private-key-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "connectionGenerationId": "connection-generation-{runId}",
          "publicationKey": {
            "keyId": "cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s",
            "publicJwk": {
              "kty": "EC",
              "crv": "P-256",
              "x": "MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4",
              "y": "4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM",
              "d": "870MB6gfuTJ4HtUnUvYMyJpr5eUZNP4Bk43bVdj3eAE"
            }
          },
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "api-mutation-request-invalid",
          "status": 400
        }
      }
    },
    {
      "name": "disconnectAliceGroupPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/disconnect/requests/disconnect-scope-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "pollDisconnectedSessionGone",
      "type": "http.poll-until",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 12,
          "maxDurationMs": 10000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": []
        },
        "comparison": "compatible-complete"
      }
    },
    {
      "name": "logoutAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/logout/requests/bb-logout-alice-007-{runId}-group-presence",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "loggedOut": true
        }
      }
    }
  ]
}
