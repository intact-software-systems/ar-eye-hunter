{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default-{runId}"
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "setDisposableUsername",
      "type": "set",
      "output": "disposableUsername",
      "value": "api-v1-bb-user-{runId}"
    },
    {
      "name": "registerDisposableUser",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/bb-register-disposable-user-001-{runId}",
        "body": {
          "username": "{disposableUsername}",
          "password": "api-v1-bb-password-{runId}",
          "displayName": "API v1 black-box user {runId}"
        },
        "outputs": {
          "disposableRegisteredClientId": "body.clientId"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string",
          "username": "{disposableUsername}",
          "registeredAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "loginDisposableUser",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-disposable-user-002-{runId}",
        "body": {
          "username": "{disposableUsername}",
          "password": "api-v1-bb-password-{runId}"
        },
        "outputs": {
          "disposableClientId": "body.clientId",
          "disposableAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "disposableSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "{disposableRegisteredClientId}",
          "accessToken": "string",
          "username": "{disposableUsername}",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveDisposableAuthHeader",
      "type": "set",
      "output": "disposableAuthHeader",
      "secret": true,
      "redactAs": "disposableAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.disposableAccessToken"
          }
        ]
      }
    },
    {
      "name": "issueSingleUseAgentTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/agent-session-tickets/requests/bb-issue-single-use-agent-ticket-003-{runId}",
        "headers": {
          "Authorization": "{disposableAuthHeader}",
          "x-client-id": "{disposableClientId}"
        },
        "body": { "agentIds": ["ticket-race-{runId}"] },
        "outputs": {
          "singleUseAgentTicket": { "path": "body.tickets.0.ticket", "secret": true }
        }
      },
      "expect": { "status": 200, "body": { "tickets": [{ "ticket": "string" }] } }
    },
    {
      "name": "raceSingleUseAgentTicket",
      "type": "parallel",
      "maxConcurrency": 2,
      "timeoutMs": 10000,
      "groups": [
        {
          "name": "ticket-consumer-one",
          "steps": [{
            "name": "consumeSingleUseAgentTicketOne",
            "type": "http",
            "connection": "api",
            "request": {
              "method": "POST",
              "path": "/api/auth/agent-session-tickets/consume/requests/bb-consume-single-use-agent-ticket-one-004-{runId}",
              "body": { "ticket": "{singleUseAgentTicket}" }
            },
            "expect": { "statusCode": [200, 404] }
          }]
        },
        {
          "name": "ticket-consumer-two",
          "steps": [{
            "name": "consumeSingleUseAgentTicketTwo",
            "type": "http",
            "connection": "api",
            "request": {
              "method": "POST",
              "path": "/api/auth/agent-session-tickets/consume/requests/bb-consume-single-use-agent-ticket-two-005-{runId}",
              "body": { "ticket": "{singleUseAgentTicket}" }
            },
            "expect": { "statusCode": [200, 404] }
          }]
        }
      ]
    },
    {
      "name": "assertSingleTicketConsumption",
      "type": "assert",
      "actual": {
        "statuses": [
          "{resultsByName.consumeSingleUseAgentTicketOne.0.actual.statusCode}",
          "{resultsByName.consumeSingleUseAgentTicketTwo.0.actual.statusCode}"
        ]
      },
      "expect": { "anyOf": [{ "statuses": [200, 404] }, { "statuses": [404, 200] }] }
    },
    {
      "name": "exposeStateWriteEvidence",
      "type": "set.state-write-evidence",
      "output": "stateWriteEvidence",
      "request": {
        "stateWriteEvidence": {
          "match": "{singleUseAgentTicket}",
          "commandTypes": ["AUTH_AGENT_SESSION_TICKET_CONSUME"],
          "minimumMatchedRows": 2,
          "expectedEffectsByCommandType": {
            "AUTH_AGENT_SESSION_TICKET_CONSUME": []
          }
        }
      }
    },
    {
      "name": "assertAtomicAppInboxCompletion",
      "type": "assert",
      "actual": {
        "atomicCompletionFailures": "{stateWriteEvidence.atomicCompletionFailures}",
        "intermediateMutationIntentCount": "{stateWriteEvidence.intermediateMutationIntentCount}",
        "completedAppInboxCount": "{stateWriteEvidence.completedAppInboxCount}",
        "failedAppInboxCount": "{stateWriteEvidence.failedAppInboxCount}"
      },
      "expect": {
        "body": {
          "atomicCompletionFailures": 0,
          "intermediateMutationIntentCount": 0,
          "completedAppInboxCount": 1,
          "failedAppInboxCount": 1
        }
      }
    },
    {
      "name": "logoutDisposableUser",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/logout/requests/bb-logout-disposable-user-006-{runId}",
        "headers": {
          "Authorization": "{disposableAuthHeader}",
          "x-client-id": "{disposableClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "loggedOut": true
        }
      }
    },
    {
      "name": "rejectWrongPassword",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-reject-wrong-password-007-{runId}",
        "body": {
          "username": "{disposableUsername}",
          "password": "wrong-password-{runId}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "authentication-required",
          "status": 401
        }
      }
    },
    {
      "name": "rejectMissingBearerToken",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups"
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "Unauthorized: Missing bearer token"
        }
      }
    },
    {
      "name": "rejectMissingClientIdHeader",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{disposableAuthHeader}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "Unauthorized: Missing x-client-id header"
        }
      }
    },
    {
      "name": "rejectWebSocketTicketWithoutAuth",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-reject-web-socket-ticket-without-auth-008-{runId}"
      },
      "expect": {
        "status": 401,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "authentication-required",
          "status": 401
        }
      }
    }
  ]
}
