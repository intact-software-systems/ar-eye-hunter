            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "closedFreezesTheRosterOutsideForming",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{lobbyGroupId}/join/requests/join-match-lobby-carol-denied-{runId}",
