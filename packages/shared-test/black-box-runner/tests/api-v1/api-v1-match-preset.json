    {
      "name": "blockedSendIsNackedWhileForming",
      "type": "ws.send",
      "connection": "wsBob",
      "request": {
        "send": {
          "id": {
            "v": 2,
            "msgId": "match-lobby-blocked-{runId}",
            "ts": 0,
            "senderId": "{bobSessionId}",
            "sessionId": "{bobSessionId}"
          },
          "route": {
            "topicId": "room.match",
            "resourceId": "match-lobby-blocked-resource-{runId}",
            "contextId": "{applicationId}:{workspaceId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{lobbyGroupId}"
            }
          },
          "delivery": {
            "reliability": "best-effort",
            "ack": "none"
          },
          "payload": {
            "typeId": "room.match.v1",
            "contentType": "application/json",
            "resource": "{\"move\":\"early\",\"runId\":\"{runId}\"}"
          }
        }
      },
      "expect": {
        "connection": "wsBob",
        "withinMs": 20000,
        "message": {
          "payload": {
            "typeId": "al.control.nack.v1"
          }
        }
      }
    },
    {
