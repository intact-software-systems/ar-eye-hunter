{
  "variables": {
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "rallarApiBaseUrlSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "rallarApiBaseUrlTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "api-v1-churn-{runId}"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "cluster-churn-{runId}"
    },
    "sharedGroupId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "shared-churn-{runId}"
    },
    "churnGroupId": {
      "env": "RALLAR_BB_SECONDARY_GROUP_ID",
      "default": "presence-churn-{runId}"
    },
    "ownerUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "ownerPassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "clientPassword": {
      "env": "RALLAR_BB_CHURN_PASSWORD",
      "default": "api-v1-churn-password",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "apiPrimary": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "apiSecondary": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrlSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "apiTertiary": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrlTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    }
  },
  "steps": [
    {
      "name": "loginOwner",
      "type": "http",
      "connection": "apiPrimary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-owner-001-{runId}-state-topology-churn",
        "body": {
          "username": "{ownerUsername}",
          "password": "{ownerPassword}"
        },
        "outputs": {
          "ownerClientId": "body.clientId",
          "ownerAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "ownerSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveOwnerAuthHeader",
      "type": "set",
      "output": "ownerAuthHeader",
      "secret": true,
      "redactAs": "ownerAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.ownerAccessToken"
          }
        ]
      }
    },
    {
      "name": "createSharedGroup",
      "type": "http",
      "connection": "apiPrimary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-scope-{runId}-state-topology-churn",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "groupId": "{sharedGroupId}",
          "displayName": "Shared churn {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{ownerClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "stateRevision": "integer",
          "group": {
            "groupId": "{sharedGroupId}"
          }
        }
      }
    },
    {
      "name": "createPresenceChurnGroup",
      "type": "http",
      "connection": "apiSecondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-scope-{runId}-state-topology-churn",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "groupId": "{churnGroupId}",
          "displayName": "Presence churn {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{ownerClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "stateRevision": "integer",
          "group": {
            "groupId": "{churnGroupId}"
          }
        }
      }
    },
    {
      "name": "activateOwnerInSharedGroup",
      "type": "http",
      "connection": "apiPrimary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/members/{ownerClientId}/requests/activate-owner-scope-{runId}-state-topology-churn",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "stateRevision": "integer"
        }
      }
    },
    {
      "name": "activateOwnerInChurnGroup",
      "type": "http",
      "connection": "apiSecondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/members/{ownerClientId}/requests/activate-owner-scope-{runId}-state-topology-churn",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "stateRevision": "integer"
        }
      }
    },
    {
      "name": "connectOwnerToSharedGroup",
      "type": "http",
      "connection": "apiPrimary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/sessions/{ownerSessionId}/requests/presence-owner-scope-{runId}",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{ownerClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "stateRevision": "integer"
        }
      }
    },
    {
      "name": "connectOwnerToChurnGroup",
      "type": "http",
      "connection": "apiSecondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{ownerSessionId}/requests/presence-owner-scope-{runId}",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{ownerClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "stateRevision": "integer"
        }
      }
    },
    {
      "name": "runConcurrentClientChurn",
      "type": "parallel",
      "maxConcurrency": 2,
      "timeoutMs": 120000,
      "groups": [
        {
          "name": "primary-client-lane",
          "steps": [
            {
              "name": "primaryClientLoop",
              "type": "loop",
              "count": 4,
              "steps": [
                {
                  "name": "registerPrimaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/register/requests/bb-register-primary-client-token0-token-008-{runId}",
                    "body": {
                      "username": "churn-primary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}",
                      "displayName": "Primary churn client {loop.iteration}"
                    }
                  },
                  "expect": {
                    "status": 201,
                    "body": {
                      "clientId": "string"
                    }
                  }
                },
                {
                  "name": "loginPrimaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/login/requests/bb-login-primary-client-token0-token-009-{runId}",
                    "body": {
                      "username": "churn-primary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}"
                    },
                    "outputs": {
                      "primaryClientId": "body.clientId",
                      "primaryAccessToken": {
                        "path": "body.accessToken",
                        "secret": true
                      },
                      "primarySessionId": "body.sessionId"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "clientId": "string",
                      "sessionId": "string"
                    }
                  }
                },
                {
                  "name": "derivePrimaryAuthHeader{loop.iteration}",
                  "type": "set",
                  "output": "primaryAuthHeader",
                  "secret": true,
                  "redactAs": "primaryAuthHeader",
                  "transform": {
                    "concat": [
                      "Bearer ",
                      {
                        "path": "outputs.primaryAccessToken"
                      }
                    ]
                  }
                },
                {
                  "name": "joinPrimaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/members/{primaryClientId}/requests/join-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "joinPrimaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/members/{primaryClientId}/requests/join-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "connectPrimaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/sessions/{primarySessionId}/requests/presence-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{primaryClientId}"
                    },
                    "outputs": {
                      "primarySharedGroupRevision": "body.causalRevision.groupRevision",
                      "primarySharedPresenceRevision": "body.causalRevision.presenceRevision",
                      "primarySharedOnlineMemberCount": "body.onlineMemberCount"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "connectPrimaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{primarySessionId}/requests/presence-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{primaryClientId}"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "disconnectPrimaryClientFromChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "POST",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{primarySessionId}/disconnect/requests/disconnect-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{primaryClientId}"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "reconnectPrimaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiPrimary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{primarySessionId}/requests/reconnect-primary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{primaryAuthHeader}",
                      "x-client-id": "{primaryClientId}"
                    },
                    "body": {
                      "generationId": "reconnect-generation-{loop.iteration}-{runId}",
                      "principalId": "{primaryClientId}"
                    },
                    "outputs": {
                      "primaryChurnGroupRevision": "body.causalRevision.groupRevision",
                      "primaryChurnPresenceRevision": "body.causalRevision.presenceRevision",
                      "primaryChurnOnlineMemberCount": "body.onlineMemberCount"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "secondary-client-lane",
          "steps": [
            {
              "name": "secondaryClientLoop",
              "type": "loop",
              "count": 4,
              "steps": [
                {
                  "name": "registerSecondaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/register/requests/bb-register-secondary-client-token0-token-016-{runId}",
                    "body": {
                      "username": "churn-secondary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}",
                      "displayName": "Secondary churn client {loop.iteration}"
                    }
                  },
                  "expect": {
                    "status": 201,
                    "body": {
                      "clientId": "string"
                    }
                  }
                },
                {
                  "name": "loginSecondaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/login/requests/bb-login-secondary-client-token0-token-017-{runId}",
                    "body": {
                      "username": "churn-secondary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}"
                    },
                    "outputs": {
                      "secondaryClientId": "body.clientId",
                      "secondaryAccessToken": {
                        "path": "body.accessToken",
                        "secret": true
                      },
                      "secondarySessionId": "body.sessionId"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "clientId": "string",
                      "sessionId": "string"
                    }
                  }
                },
                {
                  "name": "deriveSecondaryAuthHeader{loop.iteration}",
                  "type": "set",
                  "output": "secondaryAuthHeader",
                  "secret": true,
                  "redactAs": "secondaryAuthHeader",
                  "transform": {
                    "concat": [
                      "Bearer ",
                      {
                        "path": "outputs.secondaryAccessToken"
                      }
                    ]
                  }
                },
                {
                  "name": "joinSecondaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/members/{secondaryClientId}/requests/join-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "joinSecondaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/members/{secondaryClientId}/requests/join-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "connectSecondaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/sessions/{secondarySessionId}/requests/presence-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{secondaryClientId}"
                    },
                    "outputs": {
                      "secondarySharedGroupRevision": "body.causalRevision.groupRevision",
                      "secondarySharedPresenceRevision": "body.causalRevision.presenceRevision",
                      "secondarySharedOnlineMemberCount": "body.onlineMemberCount"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "connectSecondaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{secondarySessionId}/requests/presence-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{secondaryClientId}"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "disconnectSecondaryClientFromChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "POST",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{secondarySessionId}/disconnect/requests/disconnect-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "generationId": "generation-{runId}",
                      "principalId": "{secondaryClientId}"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "reconnectSecondaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiSecondary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/sessions/{secondarySessionId}/requests/reconnect-secondary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{secondaryAuthHeader}",
                      "x-client-id": "{secondaryClientId}"
                    },
                    "body": {
                      "generationId": "reconnect-generation-{loop.iteration}-{runId}",
                      "principalId": "{secondaryClientId}"
                    },
                    "outputs": {
                      "secondaryChurnGroupRevision": "body.causalRevision.groupRevision",
                      "secondaryChurnPresenceRevision": "body.causalRevision.presenceRevision",
                      "secondaryChurnOnlineMemberCount": "body.onlineMemberCount"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "tertiary-client-lane",
          "steps": [
            {
              "name": "tertiaryClientLoop",
              "type": "loop",
              "count": 4,
              "steps": [
                {
                  "name": "registerTertiaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiTertiary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/register/requests/bb-register-tertiary-client-token0-token-024-{runId}",
                    "body": {
                      "username": "churn-tertiary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}",
                      "displayName": "Tertiary churn client {loop.iteration}"
                    }
                  },
                  "expect": {
                    "status": 201,
                    "body": {
                      "clientId": "string"
                    }
                  }
                },
                {
                  "name": "loginTertiaryClient{loop.iteration}",
                  "type": "http",
                  "connection": "apiTertiary",
                  "request": {
                    "method": "POST",
                    "path": "/api/auth/login/requests/bb-login-tertiary-client-token0-token-025-{runId}",
                    "body": {
                      "username": "churn-tertiary-{loop.iteration}-{runId}",
                      "password": "{clientPassword}"
                    },
                    "outputs": {
                      "tertiaryClientId": "body.clientId",
                      "tertiaryAccessToken": {
                        "path": "body.accessToken",
                        "secret": true
                      },
                      "tertiarySessionId": "body.sessionId"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "clientId": "string",
                      "sessionId": "string"
                    }
                  }
                },
                {
                  "name": "deriveTertiaryAuthHeader{loop.iteration}",
                  "type": "set",
                  "output": "tertiaryAuthHeader",
                  "secret": true,
                  "redactAs": "tertiaryAuthHeader",
                  "transform": {
                    "concat": [
                      "Bearer ",
                      {
                        "path": "outputs.tertiaryAccessToken"
                      }
                    ]
                  }
                },
                {
                  "name": "joinTertiaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiTertiary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{sharedGroupId}/members/{tertiaryClientId}/requests/join-tertiary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{tertiaryAuthHeader}",
                      "x-client-id": "{tertiaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "joinTertiaryClientToChurn{loop.iteration}",
                  "type": "http",
                  "connection": "apiTertiary",
                  "request": {
                    "method": "PUT",
                    "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{churnGroupId}/members/{tertiaryClientId}/requests/join-tertiary-{loop.iteration}-scope-{runId}",
                    "headers": {
                      "Authorization": "{tertiaryAuthHeader}",
                      "x-client-id": "{tertiaryClientId}"
                    },
                    "body": {
                      "status": "active"
                    }
                  },
                  "expect": {
                    "status": 200,
                    "body": {
                      "stateRevision": "integer"
                    }
                  }
                },
                {
                  "name": "connectTertiaryClientToShared{loop.iteration}",
                  "type": "http",
                  "connection": "apiTertiary",
                  "request": {
                    "method": "PUT",
