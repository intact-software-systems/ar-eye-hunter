{
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "rallarWsBaseUrlSecondary": {
      "env": "RALLAR_WS_BASE_URL_SECONDARY",
      "default": "ws://127.0.0.1:18081"
    },
    "rallarWsBaseUrlTertiary": {
      "env": "RALLAR_WS_BASE_URL_TERTIARY",
      "default": "ws://127.0.0.1:18082"
    },
    "applicationId": "cluster-instance-loss-{runId}",
    "workspaceId": "default-{runId}",
    "groupId": "cluster-instance-loss-room-{runId}",
    "clientPassword": {
      "env": "RALLAR_BB_CIL_PASSWORD",
      "default": "api-v1-cil-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "tertiary": {
      "type": "http",
      "baseUrl": "{apiTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "wsAlicePrimary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsBobTertiary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsCarolSecondary": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/cil-register-alice-{runId}",
        "body": {
          "username": "cil-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/cil-login-alice-{runId}",
        "body": {
          "username": "cil-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/cil-register-bob-{runId}",
        "body": {
          "username": "cil-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/cil-login-bob-{runId}",
        "body": {
          "username": "cil-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "aliceCreatesTheRoom",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/cil-create-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Cluster instance loss {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bobJoinsTheRoomOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/cil-join-room-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "alicePresenceOnThePrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/cil-presence-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "cil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "cil-connection-generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "bobPresenceOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{bobSessionId}/requests/cil-presence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "cil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "cil-connection-generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/cil-ws-ticket-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAlicePrimaryWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openAliceSocketOnThePrimary",
      "type": "ws.open",
      "connection": "wsAlicePrimary",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/cil-ws-ticket-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobTertiaryWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlTertiary"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openBobSocketOnTheTertiary",
      "type": "ws.open",
      "connection": "wsBobTertiary",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "theSecondaryCrashes",
      "type": "server.stop",
      "request": {
        "target": "secondary",
        "mode": "crash"
      }
    },
    {
      "name": "aliceSendsBroadcastOne",
      "type": "ws.send",
      "connection": "wsAlicePrimary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "cil-broadcast-one-{runId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "cil-broadcast-one-trace-{runId}"
          },
          "route": {
            "topicId": "room.chat",
            "resourceId": "cil-broadcast-one-{runId}",
            "contextId": "{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "chat.message.v1",
            "contentType": "application/json",
            "resource": "{\"text\":\"while the secondary is lost\",\"runId\":\"{runId}\"}"
          }
        }
      }
    },
    {
      "name": "bobReceivesBroadcastOne",
      "type": "ws.wait",
      "connection": "wsBobTertiary",
      "expect": {
        "connection": "wsBobTertiary",
        "withinMs": 15000,
        "message": {
          "id": {
            "msgId": "cil-broadcast-one-{runId}"
          },
          "route": {
            "topicId": "room.chat"
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          }
        }
      }
    },
    {
      "name": "bobAcknowledgesBroadcastOne",
      "type": "ws.send",
      "connection": "wsBobTertiary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "ack-bob-cil-broadcast-one-{runId}",
            "ts": 0,
            "senderId": "{bobSessionId}",
            "traceId": "trace-cil-ack-bob-one"
          },
          "route": {
            "topicId": "al-control",
            "resourceId": "cil-broadcast-one-{runId}",
            "contextId": "{aliceSessionId}"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "qos": {
            "delivery": {
              "algo": "best-effort"
            },
            "durability": {
              "algo": "volatile"
            },
            "ack": {
              "algo": "none",
              "opts": {
                "timeoutMs": 250
              }
            }
          },
          "payload": {
            "typeId": "al.control.ack.v3",
            "contentType": "application/json",
            "resource": "{\"ackedMsgId\":\"cil-broadcast-one-{runId}\",\"fromPeerId\":\"{bobSessionId}\",\"toPeerId\":\"{aliceSessionId}\",\"originPeerId\":\"{aliceSessionId}\",\"logicalRecipientPeerId\":\"{bobSessionId}\",\"carrier\":\"ws\",\"status\":\"delivered\",\"observedAtEpochMs\":0,\"proof\":null}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheCompleteReceiptOne",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
          "completeReceiptOneResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 15000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1",
            "resource": {
              "msgId": "cil-broadcast-one-{runId}",
              "phase": "complete"
            }
          }
        },
        "consume": true,
        "decodeJsonPaths": [
          "payload.resource"
        ]
      }
    },
    {
      "name": "parseCompleteReceiptOne",
      "type": "set",
      "output": "completeReceiptOne",
      "transform": {
        "jsonParse": {
          "path": "outputs.completeReceiptOneResource"
        }
      }
    },
    {
      "name": "deriveBobConfirmedOne",
      "type": "set",
      "output": "bobConfirmedOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.completeReceiptOne.confirmedRecipientPeerIds"
          },
          {
            "path": "outputs.bobSessionId"
          }
        ]
      }
    },
    {
      "name": "assertEveryReceiverConfirmedBroadcastOne",
      "type": "assert",
      "actual": {
        "msgId": "{completeReceiptOne.msgId}",
        "phase": "{completeReceiptOne.phase}",
        "bobConfirmedOne": "{bobConfirmedOne}",
        "confirmedBeyondTheReceivers": "{completeReceiptOne.confirmedRecipientPeerIds.1}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "msgId": "cil-broadcast-one-{runId}",
          "phase": "complete",
          "bobConfirmedOne": true,
          "confirmedBeyondTheReceivers": "MISSING"
        }
      }
    },
    {
      "name": "theSecondaryRestarts",
      "type": "server.restart",
      "request": {
        "target": "secondary"
      }
    },
    {
      "name": "registerCarol",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/cil-register-carol-{runId}",
        "body": {
          "username": "cil-carol-{runId}",
          "password": "{clientPassword}",
          "displayName": "carol client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginCarol",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/cil-login-carol-{runId}",
        "body": {
          "username": "cil-carol-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "carolClientId": "body.clientId",
          "carolSessionId": "body.sessionId",
          "carolAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveCarolAuthHeader",
      "type": "set",
      "output": "carolAuthHeader",
      "secret": true,
      "redactAs": "carolAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.carolAccessToken"
          }
        ]
      }
    },
    {
      "name": "carolJoinsTheRoomOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/cil-join-room-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{carolClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "carolPresenceOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{carolSessionId}/requests/cil-presence-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "generationId": "cil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "cil-connection-generation-{runId}",
          "principalId": "{carolClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createCarolWsTicket",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/cil-ws-ticket-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "outputs": {
          "carolWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveCarolSecondaryWsUrl",
      "type": "set",
      "output": "carolWsUrl",
      "secret": true,
      "redactAs": "carolWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlSecondary"
          },
          "/api/ws/",
          {
            "path": "outputs.carolSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.carolWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openCarolSocketOnTheSecondary",
      "type": "ws.open",
      "connection": "wsCarolSecondary",
      "request": {
        "url": "{carolWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "aliceSendsBroadcastTwo",
      "type": "ws.send",
      "connection": "wsAlicePrimary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "cil-broadcast-two-{runId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "cil-broadcast-two-trace-{runId}"
          },
          "route": {
            "topicId": "room.chat",
            "resourceId": "cil-broadcast-two-{runId}",
            "contextId": "{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "chat.message.v1",
            "contentType": "application/json",
            "resource": "{\"text\":\"after the secondary returned\",\"runId\":\"{runId}\"}"
          }
        }
      }
    },
    {
      "name": "bobReceivesBroadcastTwo",
      "type": "ws.wait",
      "connection": "wsBobTertiary",
      "expect": {
        "connection": "wsBobTertiary",
        "withinMs": 15000,
        "message": {
          "id": {
            "msgId": "cil-broadcast-two-{runId}"
          },
          "route": {
            "topicId": "room.chat"
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          }
        }
      }
    },
    {
      "name": "bobAcknowledgesBroadcastTwo",
      "type": "ws.send",
      "connection": "wsBobTertiary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "ack-bob-cil-broadcast-two-{runId}",
            "ts": 0,
            "senderId": "{bobSessionId}",
            "traceId": "trace-cil-ack-bob-two"
          },
          "route": {
            "topicId": "al-control",
            "resourceId": "cil-broadcast-two-{runId}",
            "contextId": "{aliceSessionId}"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "qos": {
            "delivery": {
              "algo": "best-effort"
            },
            "durability": {
              "algo": "volatile"
            },
            "ack": {
              "algo": "none",
              "opts": {
                "timeoutMs": 250
              }
            }
          },
          "payload": {
            "typeId": "al.control.ack.v3",
            "contentType": "application/json",
            "resource": "{\"ackedMsgId\":\"cil-broadcast-two-{runId}\",\"fromPeerId\":\"{bobSessionId}\",\"toPeerId\":\"{aliceSessionId}\",\"originPeerId\":\"{aliceSessionId}\",\"logicalRecipientPeerId\":\"{bobSessionId}\",\"carrier\":\"ws\",\"status\":\"delivered\",\"observedAtEpochMs\":0,\"proof\":null}"
