{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "group-transitions-{runId}",
    "workspaceId": "default-{runId}",
    "managedGroupId": "managed-room-{runId}",
    "plainGroupId": "plain-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "wsAlice": {
      "type": "ws",
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-lifecycle-transitions",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-bob-002-{runId}-group-lifecycle-transitions",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createAliceClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-create-alice-{runId}-group-lifecycle-transitions",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Lifecycle manager {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createManagedGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-managed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{managedGroupId}",
          "displayName": "Managed group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{managedGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": ["{aliceClientId}"]
          }
        }
      }
    },
    {
      "name": "topologyHeldWhileForming",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "bodyAnyOf": [
          {
            "snapshot": null
          },
          {
            "snapshot": {
              "state": "removed"
            }
          }
        ]
      }
    },
    {
      "name": "formationViewWhileForming",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "forming",
          "formationEpoch": 0,
          "formationAttemptCount": 0,
          "establishmentStartedAtEpochMs": null,
          "managerPrincipalIds": ["{aliceClientId}"]
        }
      }
    },
    {
      "name": "aliceInvitesBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/invites/{bobClientId}/requests/invite-bob-managed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "invited"
            }
          ]
        }
      }
    },
    {
      "name": "bobAcceptsTheInvite",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/invites/accept/requests/accept-bob-managed-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "connectAlicePresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/sessions/{aliceSessionId}/requests/presence-alice-managed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/sessions/{bobSessionId}/requests/presence-bob-managed-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-9668ac9c8a49a4b7fc4b1799-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "openAliceWs",
      "type": "ws.open",
      "connection": "wsAlice",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "formingTopologyHydrationArrives",
      "type": "ws.wait",
      "connection": "wsAlice",
      "request": {
        "outputs": {
          "formingTopologyResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlice",
        "withinMs": 10000,
        "message": {
          "route": {
            "topicId": "overlay.topology"
          }
        }
      }
    },
    {
      "name": "parseFormingTopology",
      "type": "set",
      "output": "formingTopology",
      "transform": {
        "jsonParse": {
          "path": "outputs.formingTopologyResource"
        }
      }
    },
    {
      "name": "formingTopologyAnnouncesRemoved",
      "type": "assert",
      "actual": {
        "state": "{formingTopology.state}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "state": "removed"
        }
      }
    },
    {
      "name": "bobCannotStartEstablishment",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/establish/requests/bob-start-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "forbidden-role",
          "status": 403
        }
      }
    },
    {
      "name": "startEstablishment",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/establish/requests/start-establishment-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "establishing",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "topologyPlannedAfterEstablish",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "closeAliceWs",
      "type": "ws.close",
      "connection": "wsAlice",
      "request": {
        "code": 1000,
        "reason": "lifecycle transitions ws checks done"
      }
    },
    {
      "name": "formationViewAfterEstablish",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "establishing",
          "formationEpoch": 1,
          "establishmentStartedAtEpochMs": "integer",
          "readiness": {
            "plannedEdgeCount": 1,
            "observedEdgeCount": 0,
            "observedRate": 0
          },
          "managerPrincipalIds": ["{aliceClientId}"]
        }
      }
    },
    {
      "name": "activateGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/activate/requests/activate-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "active",
            "formationEpoch": 2
          }
        }
      }
    },
    {
      "name": "reopenEstablishment",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/reopen/requests/bb-request-reopen-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "reconfiguring",
            "formationEpoch": 3
          }
        }
      }
    },
    {
      "name": "reactivateGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/activate/requests/reactivate-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "active",
            "formationEpoch": 4
          }
        }
      }
    },
    {
      "name": "startFromActiveIsDenied",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managedGroupId}/lifecycle/establish/requests/start-from-active-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "lifecycle-transition-invalid",
          "status": 403
        }
      }
    },
    {
      "name": "createPlainGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-plain-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{plainGroupId}",
          "displayName": "Plain group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{plainGroupId}",
            "lifecycleState": "active",
            "formationEpoch": 0
          }
        }
      }
    }
  ]
}
