{
  "description": "The connect fence (product decision 32): a manager plans a managed group with manual triggers and the layout is published; a second member's arrival replans it, so the first identity is a layout the store has replaced. A connect naming a stale formation epoch is refused 409 group-connect-stale-epoch, a connect naming the replaced layout is refused 409 group-connect-planned-layout-superseded, the group row and the formation view are unchanged by both, and the connect naming the current plan under the current epoch dials it. The no-planned-layout refusal needs a planned slot no topology work has written yet: the forming stage's first follow-up stores a removed tombstone, which the fence reads as planned-layout-superseded, and no recipe can order a plan and its connect ahead of that follow-up, so the compute tests own the third code.",
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "connect-fence-{runId}",
    "workspaceId": "default-{runId}",
    "fenceGroupId": "fence-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-7c1f2e9a4b3d5c6e8f0a1b2c-{runId}",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-3e8d1a6f0c2b4957a1d3e5f7-{runId}",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createFenceGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-fence-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{fenceGroupId}",
          "displayName": "Connect fence group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "establishment": {
              "planTrigger": {
                "kind": "manual"
              },
              "connectTrigger": {
                "kind": "manual"
              }
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "lifecycleState": "forming",
            "formationEpoch": 0
          }
        }
      }
    },
    {
      "name": "connectAlicePresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/sessions/{aliceSessionId}/requests/presence-fence-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-fence-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "managerPlansTheGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/lifecycle/plan/requests/plan-fence-group-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "firstLayoutIsPublished",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "firstLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "firstLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "firstLayoutVersion": "body.snapshot.version",
          "firstLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "aliceInvitesBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/invites/{bobClientId}/requests/invite-fence-bob-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "invited"
            }
          ]
        }
      }
    },
    {
      "name": "bobAcceptsTheInvite",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/invites/accept/requests/accept-fence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "bobArrivesAndTheStoreReplans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/sessions/{bobSessionId}/requests/presence-fence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-fence-{runId}",
          "principalId": "{bobClientId}"
        },
        "outputs": {
          "bobPresenceRevision": "body.causalRevision.presenceRevision"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "replacementLayoutIsPublished",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 250,
          "backoffMultiplier": 1
        },
        "outputs": {
          "currentLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "currentLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "currentLayoutVersion": "body.snapshot.version",
          "currentLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active",
            "sourceGroupStateCausalRevision": {
              "presenceRevision": "{bobPresenceRevision}"
            }
          }
        }
      }
    },
    {
      "name": "nothingPendsBeforeTheConnects",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "planned",
          "formationEpoch": 1,
          "formationAttemptCount": 0,
          "establishmentStartedAtEpochMs": null,
          "pending": null
        }
      }
    },
    {
      "name": "groupRowBeforeTheRefusals",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "groupRevisionBeforeTheRefusals": "body.causalRevision.groupRevision",
          "snapshotVersionBeforeTheRefusals": "body.group.snapshotVersion"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "connectWithAStaleEpochIsRefused",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/lifecycle/connect/requests/connect-fence-stale-epoch-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": 0,
          "expectedLayout": {
            "groupRevision": "{currentLayoutGroupRevision}",
            "presenceRevision": "{currentLayoutPresenceRevision}",
            "version": "{currentLayoutVersion}",
            "state": "{currentLayoutState}"
          }
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "group-connect-stale-epoch",
          "status": 409
        }
      }
    },
    {
      "name": "connectNamingTheReplacedLayoutIsRefused",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/lifecycle/connect/requests/connect-fence-superseded-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": 1,
          "expectedLayout": {
            "groupRevision": "{firstLayoutGroupRevision}",
            "presenceRevision": "{firstLayoutPresenceRevision}",
            "version": "{firstLayoutVersion}",
            "state": "{firstLayoutState}"
          }
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "group-connect-planned-layout-superseded",
          "status": 409
        }
      }
    },
    {
      "name": "refusalsWroteNothing",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "causalRevision": {
            "groupRevision": "{groupRevisionBeforeTheRefusals}"
          },
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1,
            "formationAttemptCount": 0,
            "establishmentStartedAtEpochMs": null,
            "snapshotVersion": "{snapshotVersionBeforeTheRefusals}"
          }
        }
      }
    },
    {
      "name": "connectNamingTheCurrentLayoutDials",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{fenceGroupId}/lifecycle/connect/requests/connect-fence-published-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": 1,
          "expectedLayout": {
            "groupRevision": "{currentLayoutGroupRevision}",
            "presenceRevision": "{currentLayoutPresenceRevision}",
            "version": "{currentLayoutVersion}",
            "state": "{currentLayoutState}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "connecting",
            "formationEpoch": 2
          }
        }
      }
    }
  ]
}
