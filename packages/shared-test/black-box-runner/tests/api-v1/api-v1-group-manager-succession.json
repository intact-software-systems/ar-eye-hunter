{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "manager-succession-{runId}",
    "workspaceId": "default-{runId}",
    "managerGroupId": "succession-room-{runId}",
    "zeroManagerGroupId": "zero-manager-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createBobClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{bobClientId}/principal",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "client-create-bob-{runId}",
          "username": "{bobUsername}",
          "displayName": "Succession owner {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAssignedGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "group-create-succession-{runId}",
          "groupId": "{managerGroupId}",
          "displayName": "Succession group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": [
                "{aliceClientId}",
                "{bobClientId}"
              ],
              "count": 1
            },
            "admission": {
              "mode": "open"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{managerGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": [
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "joinAliceToAssignedGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/join",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "join-alice-succession-{runId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "formationViewManagerIsAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "forming",
          "managerPrincipalIds": [
            "{aliceClientId}"
          ]
        }
      }
    },
    {
      "name": "ownerCannotEstablishPastAssignedManager",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/establish",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "establish-bob-denied-{runId}"
        }
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "assignedManagerEstablishes",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/establish",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "establish-alice-{runId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "establishing",
            "formationEpoch": 1,
            "formationElectorate": [
              "{aliceClientId}",
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "ownerRemovesTheManager",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/members/{aliceClientId}/remove",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "remove-alice-{runId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "successionPassesToBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "managerPrincipalIds": [
            "{bobClientId}"
          ]
        }
      }
    },
    {
      "name": "successorCompletesThePhase",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/activate",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "activate-bob-{runId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "active",
            "formationEpoch": 2
          }
        }
      }
    },
    {
      "name": "createZeroManagerGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "group-create-zero-{runId}",
          "groupId": "{zeroManagerGroupId}",
          "displayName": "Zero manager group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": [
                "{aliceClientId}"
              ],
              "count": 1
            },
            "admission": {
              "mode": "open"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "lifecycleState": "forming"
          }
        }
      }
    },
    {
      "name": "zeroManagerViewIsEmpty",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroManagerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "managerPrincipalIds": []
        }
      }
    },
    {
      "name": "zeroManagerBlocksOnlyManagerActions",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroManagerGroupId}/lifecycle/establish",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "establish-zero-denied-{runId}"
        }
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "membershipStaysSafeWithZeroManagers",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroManagerGroupId}/join",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "join-alice-zero-{runId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "joiningTheAssignedMemberRestoresTheManager",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroManagerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "managerPrincipalIds": [
            "{aliceClientId}"
          ]
        }
      }
    }
  ]
}
