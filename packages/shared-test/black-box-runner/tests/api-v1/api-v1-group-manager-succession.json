      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroConnectingGroupId}/lifecycle/connect/requests/connect-plan-zero-connecting-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": "{soleManagerPlansPlannedEpoch}",
          "expectedLayout": {
            "groupRevision": "{soleManagerPlansLayoutGroupRevision}",
            "presenceRevision": "{soleManagerPlansLayoutPresenceRevision}",
            "version": "{soleManagerPlansLayoutVersion}",
            "state": "{soleManagerPlansLayoutState}"
