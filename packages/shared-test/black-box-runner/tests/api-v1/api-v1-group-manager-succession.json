{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "manager-succession-{runId}",
    "workspaceId": "default-{runId}",
    "managerGroupId": "succession-room-{runId}",
    "zeroManagerGroupId": "zero-manager-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "leaveGroupId": "succession-leave-room-{runId}",
    "zeroConnectingGroupId": "zero-connecting-room-{runId}"
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-manager-succession",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-bob-002-{runId}-group-manager-succession",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createBobClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{bobClientId}/principal/requests/client-create-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "username": "{bobUsername}",
          "displayName": "Succession owner {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAssignedGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-succession-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "groupId": "{managerGroupId}",
          "displayName": "Succession group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": [
                "{aliceClientId}",
                "{bobClientId}"
              ],
              "count": 1
            },
            "admission": {
              "mode": "open"
            },
            "establishment": {
              "planTrigger": {
                "kind": "manual"
              },
              "connectTrigger": {
                "kind": "manual"
              }
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{managerGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": [
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "joinAliceToAssignedGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/join/requests/join-alice-succession-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "formationViewManagerIsAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "forming",
          "managerPrincipalIds": [
            "{aliceClientId}"
          ]
        }
      }
    },
    {
      "name": "ownerCannotPlansPastAssignedManager",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/plan/requests/plan-bob-denied-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "forbidden-role",
          "status": 403
        }
      }
    },
    {
      "name": "assignedManagerPlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/plan/requests/plan-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
          "assignedManagerPlansPlannedEpoch": "body.group.formationEpoch"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1,
            "formationElectorate": [
              "{aliceClientId}",
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "assignedManagerPlansPublication",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "assignedManagerPlansLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "assignedManagerPlansLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "assignedManagerPlansLayoutVersion": "body.snapshot.version",
          "assignedManagerPlansLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "assignedManagerPlansConnectsPublishedLayout",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/connect/requests/connect-plan-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": "{assignedManagerPlansPlannedEpoch}",
          "expectedLayout": {
            "groupRevision": "{assignedManagerPlansLayoutGroupRevision}",
            "presenceRevision": "{assignedManagerPlansLayoutPresenceRevision}",
            "version": "{assignedManagerPlansLayoutVersion}",
            "state": "{assignedManagerPlansLayoutState}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "connecting",
            "formationEpoch": 2
          }
        }
      }
    },
    {
      "name": "ownerRemovesTheManager",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/members/{aliceClientId}/remove/requests/remove-alice-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "successionPassesToBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "managerPrincipalIds": [
            "{bobClientId}"
          ]
        }
      }
    },
    {
      "name": "successorCompletesThePhase",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{managerGroupId}/lifecycle/activate/requests/activate-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "active",
            "formationEpoch": 3
          }
        }
      }
    },
    {
      "name": "createLeaveTwinGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-leave-twin-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "groupId": "{leaveGroupId}",
          "displayName": "Voluntary leave twin {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": [
                "{aliceClientId}",
                "{bobClientId}"
              ],
              "count": 1
            },
            "admission": {
              "mode": "open"
            },
            "establishment": {
              "planTrigger": {
                "kind": "manual"
              },
              "connectTrigger": {
                "kind": "manual"
              }
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "lifecycleState": "forming"
          }
        }
      }
    },
    {
      "name": "aliceJoinsTheLeaveTwin",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/join/requests/join-alice-leave-twin-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "leaveTwinManagerPlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/lifecycle/plan/requests/plan-leave-twin-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
          "leaveTwinManagerPlansPlannedEpoch": "body.group.formationEpoch"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "leaveTwinManagerPlansPublication",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "leaveTwinManagerPlansLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "leaveTwinManagerPlansLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "leaveTwinManagerPlansLayoutVersion": "body.snapshot.version",
          "leaveTwinManagerPlansLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "leaveTwinManagerPlansConnectsPublishedLayout",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/lifecycle/connect/requests/connect-plan-leave-twin-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "expectedFormationEpoch": "{leaveTwinManagerPlansPlannedEpoch}",
          "expectedLayout": {
            "groupRevision": "{leaveTwinManagerPlansLayoutGroupRevision}",
            "presenceRevision": "{leaveTwinManagerPlansLayoutPresenceRevision}",
            "version": "{leaveTwinManagerPlansLayoutVersion}",
            "state": "{leaveTwinManagerPlansLayoutState}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "connecting",
            "formationEpoch": 2
          }
        }
      }
    },
    {
      "name": "managerLeavesMidConnecting",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/members/{aliceClientId}/requests/leave-twin-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "status": "left"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "left"
            }
          ]
        }
      }
    },
    {
      "name": "leaveSuccessionPassesToBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/formation",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "managerPrincipalIds": [
            "{bobClientId}"
          ]
        }
      }
    },
    {
      "name": "leaveSuccessorCompletesThePhase",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{leaveGroupId}/lifecycle/activate/requests/activate-leave-twin-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "active",
            "formationEpoch": 3
          }
        }
      }
    },
    {
      "name": "createZeroConnectingGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-zero-connecting-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "groupId": "{zeroConnectingGroupId}",
          "displayName": "Zero manager connecting {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "manual"
            },
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": [
                "{aliceClientId}"
              ],
              "count": 1
            },
            "admission": {
              "mode": "open"
            },
            "establishment": {
              "planTrigger": {
                "kind": "manual"
              },
              "connectTrigger": {
                "kind": "manual"
              }
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "lifecycleState": "forming"
          }
        }
      }
    },
    {
      "name": "aliceJoinsTheZeroConnectingGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroConnectingGroupId}/join/requests/join-alice-zero-connecting-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "soleManagerPlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{zeroConnectingGroupId}/lifecycle/plan/requests/plan-zero-connecting-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
