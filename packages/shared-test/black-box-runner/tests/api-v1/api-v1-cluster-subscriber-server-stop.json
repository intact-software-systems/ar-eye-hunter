{
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "rallarWsBaseUrlSecondary": {
      "env": "RALLAR_WS_BASE_URL_SECONDARY",
      "default": "ws://127.0.0.1:18081"
    },
    "rallarWsBaseUrlTertiary": {
      "env": "RALLAR_WS_BASE_URL_TERTIARY",
      "default": "ws://127.0.0.1:18082"
    },
    "applicationId": "cluster-subscriber-server-stop-{runId}",
    "workspaceId": "default-{runId}",
    "groupId": "cluster-subscriber-server-stop-room-{runId}",
    "clientPassword": {
      "env": "RALLAR_BB_CSSS_PASSWORD",
      "default": "api-v1-csss-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "tertiary": {
      "type": "http",
      "baseUrl": "{apiTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "wsAlicePrimary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsBobSecondary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsCarolTertiary": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csss-register-alice-{runId}",
        "body": {
          "username": "csss-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csss-login-alice-{runId}",
        "body": {
          "username": "csss-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csss-register-bob-{runId}",
        "body": {
          "username": "csss-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csss-login-bob-{runId}",
        "body": {
          "username": "csss-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerCarol",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csss-register-carol-{runId}",
        "body": {
          "username": "csss-carol-{runId}",
          "password": "{clientPassword}",
          "displayName": "carol client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginCarol",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csss-login-carol-{runId}",
        "body": {
          "username": "csss-carol-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "carolClientId": "body.clientId",
          "carolSessionId": "body.sessionId",
          "carolAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveCarolAuthHeader",
      "type": "set",
      "output": "carolAuthHeader",
      "secret": true,
      "redactAs": "carolAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.carolAccessToken"
          }
        ]
      }
    },
    {
      "name": "aliceCreatesTheRoom",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/csss-create-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Cluster subscriber server stop {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bobJoinsTheRoomOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/csss-join-room-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "carolJoinsTheRoomOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/csss-join-room-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{carolClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csss-ws-ticket-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAlicePrimaryWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openAliceSocketOnThePrimary",
      "type": "ws.open",
      "connection": "wsAlicePrimary",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "captureAliceSocketGeneration",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "aliceSocketGenerationId": "body.activeSessions.0.generationId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}",
              "transport": "ws"
            }
          ]
        }
      }
    },
    {
      "name": "alicePresenceOnThePrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/csss-presence-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "csss-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "{aliceSocketGenerationId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csss-ws-ticket-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobSecondaryWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlSecondary"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openBobSocketOnTheSecondary",
      "type": "ws.open",
      "connection": "wsBobSecondary",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "captureBobSocketGeneration",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{bobClientId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "bobSocketGenerationId": "body.activeSessions.0.generationId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{bobSessionId}",
              "transport": "ws"
            }
          ]
        }
      }
    },
    {
      "name": "bobPresenceOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{bobSessionId}/requests/csss-presence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "csss-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "{bobSocketGenerationId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createCarolWsTicket",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csss-ws-ticket-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "outputs": {
          "carolWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveCarolTertiaryWsUrl",
      "type": "set",
      "output": "carolWsUrl",
      "secret": true,
      "redactAs": "carolWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlTertiary"
          },
          "/api/ws/",
          {
            "path": "outputs.carolSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.carolWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openCarolSocketOnTheTertiary",
      "type": "ws.open",
      "connection": "wsCarolTertiary",
      "request": {
        "url": "{carolWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "captureCarolSocketGeneration",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{carolClientId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "carolSocketGenerationId": "body.activeSessions.0.generationId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "activeSessions": [
            {
              "sessionId": "{carolSessionId}",
              "transport": "ws"
            }
          ]
        }
      }
    },
    {
      "name": "carolPresenceOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{carolSessionId}/requests/csss-presence-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "generationId": "csss-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "{carolSocketGenerationId}",
          "principalId": "{carolClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "theRosterListsAllThreeBeforeTheStop",
      "type": "http.poll-until",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}"
            },
            {
              "sessionId": "{bobSessionId}"
            },
            {
              "sessionId": "{carolSessionId}"
            }
          ]
        }
      }
    },
    {
      "name": "theSecondaryStopsGracefully",
      "type": "server.stop",
      "request": {
        "target": "secondary",
        "mode": "graceful"
      }
    },
    {
      "name": "bobLeavesTheRosterAfterTheStop",
      "type": "http.poll-until",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "activeSessions": [
            {
              "sessionId": "{aliceSessionId}"
            },
            {
              "sessionId": "{carolSessionId}"
            }
          ]
        }
      }
    },
    {
      "name": "aliceSendsTheBroadcast",
      "type": "ws.send",
      "connection": "wsAlicePrimary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "csss-broadcast-{runId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "csss-broadcast-trace-{runId}"
          },
          "route": {
            "topicId": "room.chat",
            "resourceId": "csss-broadcast-{runId}",
            "contextId": "{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "chat.message.v1",
            "contentType": "application/json",
            "resource": "{\"text\":\"after a subscriber server stopped\",\"runId\":\"{runId}\"}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheAdmittedReceipt",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
          "admittedReceiptResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 15000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1",
            "resource": {
              "msgId": "csss-broadcast-{runId}",
              "phase": "admitted"
            }
          }
        },
        "consume": true,
        "decodeJsonPaths": [
          "payload.resource"
        ]
      }
    },
    {
      "name": "parseAdmittedReceipt",
      "type": "set",
      "output": "admittedReceipt",
      "transform": {
        "jsonParse": {
          "path": "outputs.admittedReceiptResource"
        }
      }
    },
    {
      "name": "deriveBobExpectedAdmittedReceipt",
      "type": "set",
      "output": "bobExpectedAdmittedReceipt",
      "transform": {
        "includes": [
          {
            "path": "outputs.admittedReceipt.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.bobSessionId"
          }
        ]
      }
    },
    {
      "name": "deriveCarolExpectedAdmittedReceipt",
      "type": "set",
      "output": "carolExpectedAdmittedReceipt",
      "transform": {
        "includes": [
          {
            "path": "outputs.admittedReceipt.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.carolSessionId"
          }
        ]
      }
    },
    {
      "name": "assertTheAdmittedReceiptExpectsCarolAlone",
      "type": "assert",
      "actual": {
        "phase": "{admittedReceipt.phase}",
        "bobExpectedAdmittedReceipt": "{bobExpectedAdmittedReceipt}",
        "carolExpectedAdmittedReceipt": "{carolExpectedAdmittedReceipt}",
        "expectedBeyond": "{admittedReceipt.expectedRecipientPeerIds.1}",
        "confirmedBeyond": "{admittedReceipt.confirmedRecipientPeerIds.0}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "phase": "admitted",
          "bobExpectedAdmittedReceipt": false,
          "carolExpectedAdmittedReceipt": true,
          "expectedBeyond": "MISSING",
          "confirmedBeyond": "MISSING"
        }
      }
    },
    {
      "name": "carolReceivesTheBroadcast",
      "type": "ws.wait",
      "connection": "wsCarolTertiary",
      "expect": {
        "connection": "wsCarolTertiary",
        "withinMs": 15000,
        "message": {
          "id": {
            "msgId": "csss-broadcast-{runId}"
          },
          "route": {
            "topicId": "room.chat"
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          }
        }
      }
    },
    {
      "name": "carolAcknowledgesTheBroadcast",
      "type": "ws.send",
      "connection": "wsCarolTertiary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "ack-carol-csss-broadcast-{runId}",
            "ts": 0,
            "senderId": "{carolSessionId}",
            "traceId": "trace-csss-ack-carol"
          },
          "route": {
            "topicId": "al-control",
            "resourceId": "csss-broadcast-{runId}",
            "contextId": "{aliceSessionId}"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "qos": {
            "delivery": {
              "algo": "best-effort"
            },
            "durability": {
              "algo": "volatile"
            },
            "ack": {
              "algo": "none",
              "opts": {
                "timeoutMs": 250
              }
            }
          },
          "payload": {
            "typeId": "al.control.ack.v3",
            "contentType": "application/json",
            "resource": "{\"ackedMsgId\":\"csss-broadcast-{runId}\",\"fromPeerId\":\"{carolSessionId}\",\"toPeerId\":\"{aliceSessionId}\",\"originPeerId\":\"{aliceSessionId}\",\"logicalRecipientPeerId\":\"{carolSessionId}\",\"carrier\":\"ws\",\"status\":\"delivered\",\"observedAtEpochMs\":0,\"proof\":null}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheCompleteReceipt",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
