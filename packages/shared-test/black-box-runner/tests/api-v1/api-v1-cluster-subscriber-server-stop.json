        "carolConfirmedCompleteReceipt": "{carolConfirmedCompleteReceipt}",
        "bobExpectedCompleteReceipt": "{bobExpectedCompleteReceipt}",
        "expectedBeyond": "{completeReceipt.expectedRecipientPeerIds.1}",
        "confirmedBeyond": "{completeReceipt.confirmedRecipientPeerIds.1}"
