                "variables": {
                  "i": 6,
                  "clientIp": "10.21.6.1"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "captureBurstEndedAt",
      "type": "set",
      "output": "burstEndedAtEpochMs",
      "transform": {
        "timestamp": true
      }
    },
    {
      "name": "delayBeforeConvergenceAttempt1",
      "type": "set",
      "output": "convergenceAttempt1Delay",
      "value": {
        "attempt": 1,
        "delayMs": 1000
      },
