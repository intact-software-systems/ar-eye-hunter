          ]
        },
        {
          "name": "convergence-2-client-3",
          "steps": [
            {
              "include": {
                "fragment": "convergence-check",
                "variables": {
                  "i": 3,
                  "attempt": 2,
                  "expectedMemberCount": 7,
                  "expectedOnlineMemberCount": 6
                }
              }
            }
          ]
        },
        {
          "name": "convergence-2-client-4",
          "steps": [
