{
  "description": "Formation-burst baseline tier small (N=6): 6 clients register, join one group, connect WS + presence inside one parallel burst, then the recipe polls until every client observes full membership and at least one overlay.topology publication, holds a ~60s steady-state heartbeat window, and captures admin group-formation metrics at T0/T1/T2. Assertions are correctness/liveness only; storm quantities are recorded, never judged (Phase 0 zero-behavior-change discipline). Authored with the recipe fragments mechanism (one per-client flow fragment per phase); this file is generated so the three tiers stay mechanically identical.",
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "rallarApiBaseUrlSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18080"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "applicationId": {
      "env": "RALLAR_BB_FORMATION_APPLICATION_ID",
      "default": "formation-small-{runId}"
    },
    "workspaceId": {
      "env": "RALLAR_BB_FORMATION_WORKSPACE_ID",
      "default": "default"
    },
    "groupId": {
      "env": "RALLAR_BB_FORMATION_GROUP_ID",
      "default": "formation-burst-small-{runId}"
    },
    "groupName": {
      "env": "RALLAR_BB_FORMATION_GROUP_NAME",
      "default": "Formation burst small {runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_FORMATION_CLIENT_PASSWORD",
      "default": "formation-burst-password",
      "secret": true
    },
    "adminUsername": {
      "env": "RALLAR_BB_ADMIN_USERNAME",
      "default": "admin"
    },
    "adminPassword": {
      "env": "RALLAR_BB_ADMIN_PASSWORD",
      "default": "admin",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    },
    "artifact": {
      "maxEvents": 200,
      "maxReportResults": 400
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 45000
    },
    "apiSecondary": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrlSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 45000
    },
    "ws-client-1": {
      "type": "ws",
      "timeoutMs": 30000
    },
    "ws-client-2": {
      "type": "ws",
      "timeoutMs": 30000
    },
    "ws-client-3": {
      "type": "ws",
      "timeoutMs": 30000
    },
    "ws-client-4": {
      "type": "ws",
      "timeoutMs": 30000
    },
    "ws-client-5": {
      "type": "ws",
      "timeoutMs": 30000
    },
    "ws-client-6": {
      "type": "ws",
      "timeoutMs": 30000
    }
  },
  "postRunAssertions": [
    {
      "name": "no failed steps",
      "path": "summary.failure",
      "eq": 0
    }
  ],
  "fragments": {
    "burst-client-flow": {
      "steps": [
        {
          "name": "registerClient{i}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/auth/register/requests/bb-register-client-token0-token-001-{runId}-group-formation-burst-small",
            "headers": {
              "x-forwarded-for": "{clientIp}"
            },
            "body": {
              "username": "formation-small-client-{i}-{runId}",
              "password": "{clientPassword}",
              "displayName": "Formation small client {i}"
            }
          },
          "expect": {
            "status": 201,
            "body": {
              "clientId": "string"
            }
          }
        },
        {
          "name": "loginClient{i}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/auth/login/requests/bb-login-client-token0-token-002-{runId}-group-formation-burst-small",
            "headers": {
              "x-forwarded-for": "{clientIp}"
            },
            "body": {
              "username": "formation-small-client-{i}-{runId}",
              "password": "{clientPassword}"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "clientId": "string",
              "accessToken": "string",
              "sessionId": "string"
            }
          }
        },
        {
          "name": "captureClient{i}ClientId",
          "type": "set",
          "output": "client{i}ClientId",
          "transform": {
            "path": "resultsByName.loginClient{i}.0.actual.body.clientId"
          }
        },
        {
          "name": "captureClient{i}SessionId",
          "type": "set",
          "output": "client{i}SessionId",
          "transform": {
            "path": "resultsByName.loginClient{i}.0.actual.body.sessionId"
          }
        },
        {
          "name": "deriveClient{i}AuthHeader",
          "type": "set",
          "output": "client{i}AuthHeader",
          "secret": true,
          "redactAs": "client{i}AuthHeader",
          "transform": {
            "concat": [
              "Bearer ",
              {
                "path": "resultsByName.loginClient{i}.0.actual.body.accessToken"
              }
            ]
          }
        },
        {
          "name": "upsertClient{i}Principal",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "PUT",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{client{i}ClientId}/principal/requests/principal-client-{i}-{runId}-group-formation-burst-small",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            },
            "body": {
              "username": "formation-small-client-{i}-{runId}",
              "displayName": "Formation small client {i}",
              "status": "active",
              "roles": ["black-box"]
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "name": "joinClient{i}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/join-client-{i}-{runId}-group-formation-burst-small",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            },
            "body": {

            },
            "retry": {
              "maxAttempts": 3,
              "backoffMs": 2000,
              "onStatus": [500, 502, 503, 504]
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "group": {
                "groupId": "{groupId}"
              }
            }
          }
        },
        {
          "name": "createClient{i}WsTicket",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/auth/ws-ticket/requests/bb-create-client-token0-tokenws-ticket-005-{runId}-group-formation-burst-small",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "ticket": "string",
              "sessionId": "{client{i}SessionId}"
            }
          }
        },
        {
          "name": "deriveClient{i}WsUrl",
          "type": "set",
          "output": "client{i}WsUrl",
          "secret": true,
          "redactAs": "client{i}WsUrl",
          "transform": {
            "concat": [
              {
                "path": "variables.rallarWsBaseUrl"
              },
              "/api/ws/",
              {
                "path": "outputs.client{i}SessionId"
              },
              "?ticket=",
              {
                "urlEncode": {
                  "path": "resultsByName.createClient{i}WsTicket.0.actual.body.ticket"
                }
              }
            ]
          }
        },
        {
          "name": "openClient{i}Ws",
          "type": "ws.open",
          "connection": "ws-client-{i}",
          "request": {
            "url": "{client{i}WsUrl}",
            "timeoutMs": 30000
          }
        },
        {
          "name": "connectClient{i}Presence",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "PUT",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{client{i}SessionId}/requests/presence-client-{i}-{runId}-group-formation-burst-small",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            },
            "body": {
              "generationId": "generation-{runId}",
              "principalId": "{client{i}ClientId}"
            },
            "retry": {
              "maxAttempts": 3,
              "backoffMs": 2000,
              "onStatus": [500, 502, 503, 504]
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "group": {
                "groupId": "{groupId}"
              }
            }
          }
        }
      ]
    },
    "convergence-check": {
      "steps": [
        {
          "name": "readClient{i}GroupAttempt{attempt}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "GET",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "memberCount": "{expectedMemberCount}",
              "onlineMemberCount": "{expectedOnlineMemberCount}"
            }
          }
        },
        {
          "name": "waitClient{i}OverlayAttempt{attempt}",
          "type": "ws.wait",
          "connection": "ws-client-{i}",
          "expect": {
            "connection": "ws-client-{i}",
            "withinMs": 5000,
            "consume": true,
            "messages": [
              {
                "route": {
                  "topicId": "overlay.topology",
                  "contextId": "{groupId}"
                },
                "payload": {
                  "typeId": "overlay.topology"
                }
              }
            ]
          }
        },
        {
          "name": "captureClient{i}OverlayTopicAttempt{attempt}",
          "type": "set",
          "output": "client{i}OverlayTopicId",
          "transform": {
            "path": "resultsByName.waitClient{i}OverlayAttempt{attempt}.0.actual.matchedMessages.0.matchedMessage.data.route.topicId"
          }
        }
      ]
    },
    "heartbeat-round": {
      "steps": [
        {
          "name": "heartbeatClient{i}Round{round}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{client{i}SessionId}/heartbeat/requests/heartbeat-client-{i}-round-{round}-{runId}-group-formation-burst-small",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            },
            "body": {
              "generationId": "generation-{runId}",
              "principalId": "{client{i}ClientId}"
            },
            "retry": {
              "maxAttempts": 3,
              "backoffMs": 2000,
              "onStatus": [500, 502, 503, 504]
            }
          },
          "expect": {
            "status": 200
          }
        }
      ]
    },
    "final-client-check": {
      "steps": [
        {
          "name": "readClient{i}GroupFinal",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "GET",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
            "headers": {
              "Authorization": "{client{i}AuthHeader}",
              "x-client-id": "{client{i}ClientId}"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "memberCount": "{expectedMemberCount}",
              "onlineMemberCount": "{expectedOnlineMemberCount}"
            }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "name": "registerCreator",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/bb-register-creator-008-{runId}-group-formation-burst-small",
        "body": {
          "username": "formation-small-creator-{runId}",
          "password": "{clientPassword}",
          "displayName": "Formation small creator"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginCreator",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-creator-009-{runId}-group-formation-burst-small",
        "body": {
          "username": "formation-small-creator-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "creatorClientId": "body.clientId",
          "creatorAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "creatorSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveCreatorAuthHeader",
      "type": "set",
      "output": "creatorAuthHeader",
      "secret": true,
      "redactAs": "creatorAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.creatorAccessToken"
          }
        ]
      }
    },
    {
      "name": "createFormationGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-scope-{runId}-group-formation-burst-small",
        "headers": {
          "Authorization": "{creatorAuthHeader}",
          "x-client-id": "{creatorClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "{groupName}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{creatorClientId}",
          "lifecyclePolicy": {
            "preset": "optimistic"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}",
            "kind": "room"
          }
        }
      }
    },
    {
      "name": "loginAdmin",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-admin-011-{runId}-group-formation-burst-small",
        "body": {
          "username": "{adminUsername}",
          "password": "{adminPassword}"
        },
        "outputs": {
          "adminClientId": "body.clientId",
          "adminAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string"
        }
      }
    },
    {
      "name": "deriveAdminAuthHeader",
      "type": "set",
      "output": "adminAuthHeader",
      "secret": true,
      "redactAs": "adminAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.adminAccessToken"
          }
        ]
      }
    },
    {
      "name": "captureFormationMetricsT0Primary",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/realtime",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "outputs": {
          "formationMetricsT0Primary": "body.groupFormation.metrics",
          "topologyMetricsT0Primary": "body.rtcTopology.metrics"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "groupFormation": {
            "processLocal": true
          }
        }
      }
    },
    {
      "name": "captureFormationMetricsT0Secondary",
      "type": "http",
      "connection": "apiSecondary",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/realtime",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "outputs": {
          "formationMetricsT0Secondary": "body.groupFormation.metrics",
          "topologyMetricsT0Secondary": "body.rtcTopology.metrics"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "groupFormation": {
            "processLocal": true
          }
        }
      }
    },
    {
      "name": "captureQueuesT0Primary",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/queues",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "outputs": {
          "queueRowsT0": "body.queueRows.total",
          "queueResultRowsT0": "body.resultRows.total"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "captureBurstStartedAt",
      "type": "set",
      "output": "burstStartedAtEpochMs",
      "transform": {
        "timestamp": true
      }
    },
    {
      "name": "formationBurst",
      "type": "parallel",
      "maxConcurrency": 6,
      "timeoutMs": 120000,
      "groups": [
        {
          "name": "client-1",
          "steps": [
            {
              "include": {
                "fragment": "burst-client-flow",
                "variables": {
                  "i": 1,
                  "clientIp": "10.21.1.1"
                }
              }
            }
          ]
        },
        {
          "name": "client-2",
          "steps": [
            {
              "include": {
                "fragment": "burst-client-flow",
                "variables": {
                  "i": 2,
                  "clientIp": "10.21.2.1"
                }
              }
            }
          ]
        },
        {
          "name": "client-3",
          "steps": [
            {
              "include": {
                "fragment": "burst-client-flow",
                "variables": {
                  "i": 3,
                  "clientIp": "10.21.3.1"
                }
              }
            }
          ]
        },
        {
          "name": "client-4",
          "steps": [
            {
              "include": {
                "fragment": "burst-client-flow",
                "variables": {
                  "i": 4,
                  "clientIp": "10.21.4.1"
                }
              }
            }
          ]
        },
        {
          "name": "client-5",
          "steps": [
            {
