{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "formation-criterion-{runId}",
    "workspaceId": "default-{runId}",
    "autoGroupId": "auto-room-{runId}",
    "deadlineGroupId": "deadline-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "thresholdGroupId": "threshold-room-{runId}",
    "degradedGroupId": "degraded-room-{runId}",
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "retryGroupId": "retry-room-{runId}"
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "wsAlice": {
      "type": "ws",
      "timeoutMs": 10000
    },
    "wsBob": {
      "type": "ws",
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-formation-criterion",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-bob-002-{runId}-group-formation-criterion",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createAliceClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-create-alice-{runId}-group-formation-criterion",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Criterion manager {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAutoGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-auto-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{autoGroupId}",
          "displayName": "Auto-activating group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "threshold",
              "successRate": 1,
              "minimumViableRate": 0
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{autoGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0
          }
        }
      }
    },
    {
      "name": "startAutoPlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{autoGroupId}/lifecycle/plan/requests/plan-auto-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
          "startAutoPlanEpoch": "body.group.formationEpoch"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "startAutoPlansPublication",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{autoGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "startAutoPlanLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "startAutoPlanLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "startAutoPlanLayoutVersion": "body.snapshot.version",
          "startAutoPlanLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "startAutoPlansConnectsPublishedLayout",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{autoGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 8000,
          "backoffMs": 100,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "formationEpoch": 2
        }
      }
    },
    {
      "name": "formationAutoActivated",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{autoGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "active",
          "formationEpoch": 3,
          "formationAttemptCount": 0,
          "lastFormationOutcome": {
            "outcome": "activated",
            "observedRate": 1
          },
          "managerPrincipalIds": [
            "{aliceClientId}"
          ],
          "condition": "active",
          "remediation": "none"
        }
      }
    },
    {
      "name": "createDeadlineGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-deadline-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{deadlineGroupId}",
          "displayName": "Deadline group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "deadline",
              "successRate": 1,
              "minimumViableRate": 1,
              "deadlineMs": 3000,
              "maxFormationAttempts": 1
            },
            "admission": {
              "mode": "open"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{deadlineGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": [
              "{aliceClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "joinBobToDeadlineGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/join/requests/join-bob-deadline-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectAliceDeadlinePresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/sessions/{aliceSessionId}/requests/presence-alice-deadline-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobDeadlinePresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/sessions/{bobSessionId}/requests/presence-bob-deadline-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "startDeadlinePlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/lifecycle/plan/requests/plan-deadline-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
          "startDeadlinePlanEpoch": "body.group.formationEpoch"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1,
            "formationElectorate": [
              "{aliceClientId}",
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "startDeadlinePlansPublication",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "startDeadlinePlanLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "startDeadlinePlanLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "startDeadlinePlanLayoutVersion": "body.snapshot.version",
          "startDeadlinePlanLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "startDeadlinePlansConnectsPublishedLayout",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 8000,
          "backoffMs": 100,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "formationEpoch": 2
        }
      }
    },
    {
      "name": "formationBelowFloorAtDeadlineParksTheSpentSeries",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{deadlineGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 250,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "dormant",
          "formationEpoch": 3,
          "formationAttemptCount": 1,
          "lastFormationOutcome": {
            "outcome": "below-floor",
            "observedRate": 0
          },
          "managerPrincipalIds": [
            "{aliceClientId}"
          ],
          "maxFormationAttempts": 1,
          "condition": "failed",
          "remediation": "awaiting-application"
        }
      }
    },
    {
      "name": "createAutomaticRetryGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-automatic-retry-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{retryGroupId}",
          "displayName": "Automatic retry group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "deadline",
              "successRate": 1,
              "minimumViableRate": 1,
              "deadlineMs": 3000,
              "maxFormationAttempts": 2
            },
            "admission": {
              "mode": "open"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{retryGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0,
            "formationElectorate": [
              "{aliceClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "joinBobToAutomaticRetryGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/join/requests/join-bob-automatic-retry-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "connectAliceRetryPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/sessions/{aliceSessionId}/requests/presence-alice-retry-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobRetryPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/sessions/{bobSessionId}/requests/presence-bob-retry-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "planAutomaticRetryGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/lifecycle/plan/requests/plan-automatic-retry-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {},
        "outputs": {
          "retryPlannedEpoch": "body.group.formationEpoch"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1,
            "formationElectorate": [
              "{aliceClientId}",
              "{bobClientId}"
            ]
          }
        }
      }
    },
    {
      "name": "publishedRetryLayoutBeforeInitialDial",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        },
        "outputs": {
          "retryLayoutGroupRevision": "body.snapshot.sourceGroupStateCausalRevision.groupRevision",
          "retryLayoutPresenceRevision": "body.snapshot.sourceGroupStateCausalRevision.presenceRevision",
          "retryLayoutVersion": "body.snapshot.version",
          "retryLayoutState": "body.snapshot.state"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "connectAutomaticRetryGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 8000,
          "backoffMs": 100,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "formationEpoch": 2
        }
      }
    },
    {
      "name": "automaticRetryReplansPublishesAndReconnects",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 1000,
          "backoffMultiplier": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "formationEpoch": 5,
          "formationAttemptCount": 1,
          "lastFormationOutcome": {
            "outcome": "below-floor",
            "observedRate": 0
          },
          "managerPrincipalIds": [
            "{aliceClientId}"
          ]
        }
      }
    },
    {
      "name": "retryPublicationIsDurablyVisible",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "automaticRetryExhaustsOnlyAfterSecondFailedDial",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{retryGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 1000,
          "backoffMultiplier": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "dormant",
          "formationEpoch": 6,
          "formationAttemptCount": 2,
          "lastFormationOutcome": {
            "outcome": "below-floor",
            "observedRate": 0
          },
          "managerPrincipalIds": [
            "{aliceClientId}"
          ]
        }
      }
    },
    {
      "name": "createThresholdGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-threshold-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{thresholdGroupId}",
          "displayName": "Threshold group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "threshold-or-deadline",
