{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "group-policy-{runId}",
    "workspaceId": "default-{runId}",
    "policyGroupId": "policy-room-{runId}",
    "plainGroupId": "plain-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "optimisticGroupId": "optimistic-room-{runId}",
    "strictGroupId": "strict-room-{runId}",
    "noneManagerGroupId": "none-manager-room-{runId}",
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-lifecycle-policy",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-create-{runId}-group-lifecycle-policy",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Snapshot reader initial {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createGroupWithLifecyclePolicy",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-createGroupWithLifecyclePolicy-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{policyGroupId}",
          "displayName": "Policy group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "admission": {
              "mode": "closed"
            },
            "activation": {
              "successRate": 0.9,
              "minimumViableRate": 0.4
            }
          }
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "createGroupWithoutLifecyclePolicy",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-createGroupWithoutLifecyclePolicy-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{plainGroupId}",
          "displayName": "Plain group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{plainGroupId}",
            "lifecycleState": "active",
            "formationEpoch": 0
          }
        }
      }
    },
    {
      "name": "createGroupWithOptimisticPreset",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "group-create-optimistic-{runId}",
          "groupId": "{optimisticGroupId}",
          "displayName": "Optimistic group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "optimistic"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{optimisticGroupId}",
            "lifecycleState": "active",
            "formationEpoch": 0
          }
        }
      }
    },
    {
      "name": "optimisticFormationViewMatchesTheDefault",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{optimisticGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "active",
          "formationEpoch": 0,
          "formationAttemptCount": 0,
          "lastFormationOutcome": null,
          "establishmentStartedAtEpochMs": null,
          "readiness": {
            "plannedEdgeCount": 0,
            "observedEdgeCount": 0,
            "observedRate": 1
          },
          "managerPrincipalIds": []
        }
      }
    },
    {
      "name": "absentPolicyFormationViewMatchesOptimistic",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{plainGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "active",
          "formationEpoch": 0,
          "formationAttemptCount": 0,
          "lastFormationOutcome": null,
          "establishmentStartedAtEpochMs": null,
          "readiness": {
            "plannedEdgeCount": 0,
            "observedEdgeCount": 0,
            "observedRate": 1
          },
          "managerPrincipalIds": []
        }
      }
    },
    {
      "name": "optimisticJoinAdmitsInstantly",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{optimisticGroupId}/join",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "join-bob-optimistic-{runId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "absentPolicyJoinAdmitsInstantly",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{plainGroupId}/join",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "join-bob-plain-{runId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "strictConfirmationIsRejected",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "group-create-strict-{runId}",
          "groupId": "{strictGroupId}",
          "displayName": "Strict confirmation group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "strictConfirmation": true
            }
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "app-inbox-malformed-command"
        }
      }
    },
    {
      "name": "strictConfirmationGroupWasNotCreated",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{strictGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 404
      }
    },
    {
      "name": "managerInitiatorWithoutManagerIsRejected",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "group-create-none-manager-{runId}",
          "groupId": "{noneManagerGroupId}",
          "displayName": "None manager group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "manager": {
              "selection": "none",
              "assignedPrincipalIds": [],
              "count": 1,
              "succession": "none"
            }
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "app-inbox-malformed-command"
        }
      }
    },
    {
      "name": "noneManagerGroupWasNotCreated",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{noneManagerGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 404
      }
    }
  ]
}
