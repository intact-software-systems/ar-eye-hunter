{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "rallarWsBaseUrlSecondary": {
      "env": "RALLAR_WS_BASE_URL_SECONDARY",
      "default": "ws://127.0.0.1:18081"
    },
    "applicationId": "live-only-cluster-{runId}",
    "workspaceId": "default-{runId}",
    "groupId": "live-only-cluster-room-{runId}",
    "clientPassword": {
      "env": "RALLAR_BB_LWOC_PASSWORD",
      "default": "api-v1-lwoc-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "wsAlicePrimary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsBobSecondary": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/lwoc-register-alice-{runId}",
        "body": {
          "username": "lwoc-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/lwoc-login-alice-{runId}",
        "body": {
          "username": "lwoc-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/lwoc-register-bob-{runId}",
        "body": {
          "username": "lwoc-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/lwoc-login-bob-{runId}",
        "body": {
          "username": "lwoc-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "aliceCreatesTheRoom",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/lwoc-create-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Live-only cluster {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bobJoinsTheRoomOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/lwoc-join-room-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "alicePresenceOnThePrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/lwoc-presence-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "lwoc-generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "bobPresenceOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{bobSessionId}/requests/lwoc-presence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "lwoc-generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/lwoc-ws-ticket-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAlicePrimaryWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openAliceSocketOnThePrimary",
      "type": "ws.open",
      "connection": "wsAlicePrimary",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/lwoc-ws-ticket-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobSecondaryWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlSecondary"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openBobSocketOnTheSecondary",
      "type": "ws.open",
      "connection": "wsBobSecondary",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "aliceSendsAnAtLeastOnceRoomBroadcastOnAnUndeclaredTopic",
      "type": "ws.send",
      "connection": "wsAlicePrimary",
      "request": {
        "send": {
          "id": {
            "v": 3,
            "msgId": "live-only-cluster-broadcast-{runId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "live-only-cluster-broadcast-trace-{runId}"
          },
          "route": {
            "topicId": "room.chat",
            "resourceId": "live-only-cluster-broadcast-{runId}",
            "contextId": "{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "chat.message.v1",
            "contentType": "application/json",
            "resource": "{\"text\":\"across processes\",\"runId\":\"{runId}\"}"
          }
        },
        "outputs": {
          "admittedReceiptResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 10000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1"
          }
        },
        "consume": true
      }
    },
    {
      "name": "parseAdmittedReceipt",
      "type": "set",
      "output": "admittedReceipt",
      "transform": {
        "jsonParse": {
          "path": "outputs.admittedReceiptResource"
        }
      }
    },
    {
      "name": "assertTheAdmittedReceiptExpectsBobOnTheSecondary",
      "type": "assert",
      "actual": {
        "msgId": "{admittedReceipt.msgId}",
        "phase": "{admittedReceipt.phase}",
        "firstExpected": "{admittedReceipt.expectedRecipientPeerIds.0}",
        "secondExpected": "{admittedReceipt.expectedRecipientPeerIds.1}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "msgId": "live-only-cluster-broadcast-{runId}",
          "phase": "admitted",
          "firstExpected": "{bobSessionId}",
          "secondExpected": "MISSING"
        }
      }
    },
    {
      "name": "bobOnTheSecondaryReceivesTheBroadcastLive",
      "type": "ws.wait",
      "connection": "wsBobSecondary",
      "expect": {
        "connection": "wsBobSecondary",
        "withinMs": 10000,
        "message": {
          "id": {
            "msgId": "live-only-cluster-broadcast-{runId}"
          },
          "route": {
            "topicId": "room.chat"
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          }
        }
      }
    },
    {
      "name": "bobAcknowledgesOnTheSecondary",
      "type": "ws.send",
      "connection": "wsBobSecondary",
      "request": {
        "send": {
          "id": {
            "v": 3,
            "msgId": "ack-live-only-cluster-broadcast-{runId}",
            "ts": 0,
            "senderId": "{bobSessionId}"
          },
          "route": {
            "topicId": "al-control",
            "resourceId": "live-only-cluster-broadcast-{runId}",
            "contextId": "{aliceSessionId}"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "qos": {
            "delivery": {
              "algo": "best-effort"
            },
            "durability": {
              "algo": "volatile"
            },
            "ack": {
              "algo": "none",
              "opts": {
                "timeoutMs": 250
              }
            }
          },
          "payload": {
            "typeId": "al.control.ack.v2",
            "contentType": "application/json",
            "resource": "{\"ackedMsgId\":\"live-only-cluster-broadcast-{runId}\",\"fromPeerId\":\"{bobSessionId}\",\"toPeerId\":\"{aliceSessionId}\",\"originPeerId\":\"{aliceSessionId}\",\"logicalRecipientPeerId\":\"{bobSessionId}\",\"carrier\":\"ws\",\"status\":\"delivered\",\"observedAtEpochMs\":0}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheTerminalReceipt",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
          "terminalReceiptResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 10000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1"
          }
        },
        "consume": true
      }
    },
    {
      "name": "parseTerminalReceipt",
      "type": "set",
      "output": "terminalReceipt",
      "transform": {
        "jsonParse": {
          "path": "outputs.terminalReceiptResource"
        }
      }
    },
    {
      "name": "assertBobsCrossProcessAckCompletesTheReceipt",
      "type": "assert",
      "actual": {
        "msgId": "{terminalReceipt.msgId}",
        "phase": "{terminalReceipt.phase}",
        "firstExpected": "{terminalReceipt.expectedRecipientPeerIds.0}",
        "firstConfirmed": "{terminalReceipt.confirmedRecipientPeerIds.0}",
        "secondConfirmed": "{terminalReceipt.confirmedRecipientPeerIds.1}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "msgId": "live-only-cluster-broadcast-{runId}",
          "phase": "complete",
          "firstExpected": "{bobSessionId}",
          "firstConfirmed": "{bobSessionId}",
          "secondConfirmed": "MISSING"
        }
      }
    },
    {
      "name": "closeBobSocket",
      "type": "ws.close",
      "connection": "wsBobSecondary",
      "request": {
        "code": 1000,
        "reason": "live-only cluster recipe done"
      }
    },
    {
      "name": "closeAliceSocket",
      "type": "ws.close",
      "connection": "wsAlicePrimary",
      "request": {
        "code": 1000,
        "reason": "live-only cluster recipe done"
      }
    }
  ]
}
