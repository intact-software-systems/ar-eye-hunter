{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_BANGOV_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-bangov"
    },
    "workspaceId": {
      "env": "RALLAR_BB_BANGOV_WORKSPACE_ID",
      "default": "workspace-bangov-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_BANGOV_GROUP_ID",
      "default": "bangov-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_BANGOV_PASSWORD",
      "default": "api-v1-bangov-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "registerFounder",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/bb-95e4d82a442d7c20d087d35b-{runId}",
        "body": {
          "username": "bangov-founder-{runId}",
          "password": "{clientPassword}",
          "displayName": "founder client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginFounder",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-ec4e66d77b28745c3e5aaa31-{runId}",
        "body": {
          "username": "bangov-founder-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "founderClientId": "body.clientId",
          "founderAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "founderSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveFounderAuthHeader",
      "type": "set",
      "output": "founderAuthHeader",
      "secret": true,
      "redactAs": "founderAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.founderAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerOffender",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/bb-0c80cece2b208ea32f81d260-{runId}",
        "body": {
          "username": "bangov-offender-{runId}",
          "password": "{clientPassword}",
          "displayName": "offender client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginOffender",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-d56ce74df22ec6e7d508b468-{runId}",
        "body": {
          "username": "bangov-offender-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "offenderClientId": "body.clientId",
          "offenderAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "offenderSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveOffenderAuthHeader",
      "type": "set",
      "output": "offenderAuthHeader",
      "secret": true,
      "redactAs": "offenderAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.offenderAccessToken"
          }
        ]
      }
    },
    {
      "name": "createGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/create-bangov-{runId}",
        "headers": {
          "Authorization": "{founderAuthHeader}",
          "x-client-id": "{founderClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Ban governance group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{founderClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "offenderJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/requests/bangov-join-{runId}",
        "headers": {
          "Authorization": "{offenderAuthHeader}",
          "x-client-id": "{offenderClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "founderBansOffender",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/ban/requests/bangov-ban-{runId}",
        "headers": {
          "Authorization": "{founderAuthHeader}",
          "x-client-id": "{founderClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bannedSelfLeaveCannotShedTheBan",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/requests/bangov-self-left-{runId}",
        "headers": {
          "Authorization": "{offenderAuthHeader}",
          "x-client-id": "{offenderClientId}"
        },
        "body": {
          "status": "left"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "member-banned",
          "status": 403
        }
      }
    },
    {
      "name": "bannedRejoinStaysDenied",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/requests/bangov-self-rejoin-{runId}",
        "headers": {
          "Authorization": "{offenderAuthHeader}",
          "x-client-id": "{offenderClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "member-banned",
          "status": 403
        }
      }
    },
    {
      "name": "founderUnbansOffender",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/unban/requests/bangov-unban-{runId}",
        "headers": {
          "Authorization": "{founderAuthHeader}",
          "x-client-id": "{founderClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "unbannedMemberRejoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{offenderClientId}/requests/bangov-rejoin-{runId}",
        "headers": {
          "Authorization": "{offenderAuthHeader}",
          "x-client-id": "{offenderClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    }
  ]
}
