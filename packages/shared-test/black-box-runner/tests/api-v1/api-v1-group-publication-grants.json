          "password": "{clientPassword}",
          "displayName": "dave client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginDave",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/pubgrant-login-user-dave-{runId}",
        "body": {
          "username": "pubgrant-dave-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "daveClientId": "body.clientId",
          "daveSessionId": "body.sessionId",
          "daveAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveDaveAuthHeader",
      "type": "set",
      "output": "daveAuthHeader",
      "secret": true,
      "redactAs": "daveAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.daveAccessToken"
          }
        ]
      }
    },
    {
      "name": "createGroupWithDeclaredGrant",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/pubgrant-create-group-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Publication grants {runId}",
          "kind": "room",
          "joinMode": "open",
          "publicationGrants": {
            "room.pubgrant-feed": {
              "publish": true,
              "subscribe": true
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "comparison": "compatible-complete",
        "body": {
          "group": {
            "groupId": "{groupId}"
          },
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}",
              "topics": {
                "room.pubgrant-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "bobJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{bobClientId}/requests/pubgrant-join-member-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "carolJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{carolClientId}/requests/pubgrant-join-member-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{carolClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "daveJoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{daveClientId}/requests/pubgrant-join-member-dave-{runId}",
        "headers": {
          "Authorization": "{daveAuthHeader}",
          "x-client-id": "{daveClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
