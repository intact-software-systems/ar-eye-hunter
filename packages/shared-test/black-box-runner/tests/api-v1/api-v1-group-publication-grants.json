{
  "description": "No-browser API-v1 publication grants over REST. The creator's declared initial grant is on the 201 snapshot; an owner grants a member publish on one exact topic, the 200 snapshot and a later read carry the row, the group revision advances, and the event log names publication-grant-changed with the resulting permissions. An equal replay answers the first result and a changed body under the same requestId is an idempotency conflict. An admin cannot grant an admin and a member cannot grant itself (forbidden-role); a principal holds at most 64 topics, so the 65th is refused capacity with limit topics-per-principal. A revoke removes the row, and a member who leaves, or is banned, unbanned and rejoins, comes back holding no grant.",
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_PUBGRANT_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-pubgrant"
    },
    "workspaceId": {
      "env": "RALLAR_BB_PUBGRANT_WORKSPACE_ID",
      "default": "workspace-pubgrant-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_PUBGRANT_GROUP_ID",
      "default": "pubgrant-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_PUBGRANT_PASSWORD",
      "default": "api-v1-pubgrant-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/pubgrant-register-alice-{runId}",
        "body": {
          "username": "pubgrant-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/pubgrant-login-user-alice-{runId}",
        "body": {
          "username": "pubgrant-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
