          "members": [
            {
              "principalId": "{daveClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "daveIsPromotedToAdmin",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{daveClientId}/role/requests/pubgrant-promote-dave-admin-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "role": "admin"
        },
        "outputs": {
          "groupRevisionBeforeGrant": "body.causalRevision.groupRevision"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{daveClientId}",
              "role": "admin"
            }
          ]
        }
      }
    },
    {
      "name": "grantBobPublish",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrant-grant-bob-publish-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": true,
          "subscribe": false
        },
        "outputs": {
          "groupRevisionAfterGrant": "body.causalRevision.groupRevision"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrant-feed": {
                  "publish": true,
                  "subscribe": false
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "theGrantAdvancesTheGroupRevision",
      "type": "assert",
      "actual": {
        "before": "{groupRevisionBeforeGrant}",
        "after": "{groupRevisionAfterGrant}"
      },
      "expect": {
        "comparators": [
          {
            "path": "after",
            "gt": "{groupRevisionBeforeGrant}"
          }
        ]
      }
    },
    {
      "name": "readBackGrant",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}",
              "topics": {
                "room.pubgrant-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            },
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrant-feed": {
                  "publish": true,
                  "subscribe": false
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "grantEmitsPublicationGrantChanged",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/events",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": [
          {
            "eventType": "publication-grant-changed",
            "requestId": "pubgrant-grant-bob-publish-{runId}",
            "payload": {
              "principalId": "{bobClientId}",
              "topicId": "room.pubgrant-feed",
              "permissions": {
                "publish": true,
                "subscribe": false
              }
            }
          }
        ]
      }
    },
    {
      "name": "replayGrantSameBody",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrant-grant-bob-publish-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": true,
          "subscribe": false
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "causalRevision": {
            "groupRevision": "{groupRevisionAfterGrant}"
          },
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrant-feed": {
                  "publish": true,
                  "subscribe": false
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "changedBodySameRequestId",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrant-grant-bob-publish-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": true,
          "subscribe": true
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "app-inbox-idempotency-conflict",
          "status": 409
        }
      }
    },
    {
      "name": "adminGrantsAdmin",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{daveClientId}/grant/requests/pubgrant-admin-grants-admin-{runId}",
        "headers": {
          "Authorization": "{daveAuthHeader}",
          "x-client-id": "{daveClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": false,
          "subscribe": true
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "forbidden-role",
          "status": 403
        }
      }
    },
    {
      "name": "memberSelfGrants",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrant-member-self-grants-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": false,
          "subscribe": true
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "forbidden-role",
          "status": 403
        }
      }
    },
    {
      "name": "grantSixtyFourTopicsToCarol",
      "type": "loop",
      "count": 64,
      "steps": [
        {
          "name": "grantCarolTopic{loop.iteration}",
          "type": "http",
          "connection": "api",
          "request": {
            "method": "POST",
            "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{carolClientId}/grant/requests/pubgrant-carol-capacity-{loop.iteration}-{runId}",
            "headers": {
              "Authorization": "{aliceAuthHeader}",
              "x-client-id": "{aliceClientId}"
            },
            "body": {
              "topicId": "room.pubgrant-capacity-{loop.iteration}",
              "publish": false,
              "subscribe": true
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "publicationGrants": [
                {
                  "principalId": "{carolClientId}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "grantSixtyFifthTopic",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{carolClientId}/grant/requests/pubgrant-carol-capacity-overflow-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-capacity-overflow",
          "publish": false,
          "subscribe": true
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "capacity",
          "status": 403,
          "denial": {
            "code": "capacity",
            "details": {
              "limit": "topics-per-principal",
              "max": 64
            }
          }
        }
      }
    },
    {
      "name": "revokeBobPublish",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/revoke/requests/pubgrant-revoke-bob-publish-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": true,
          "subscribe": false
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}"
            },
            {
              "principalId": "{carolClientId}"
            }
          ]
        }
      }
    },
    {
      "name": "grantBobSubscribeBeforeLeaving",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrant-grant-bob-subscribe-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrant-feed",
          "publish": false,
          "subscribe": true
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}"
            },
            {
              "principalId": "{bobClientId}"
            },
            {
              "principalId": "{carolClientId}"
            }
          ]
        }
      }
    },
    {
      "name": "bobLeaves",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{bobClientId}/requests/pubgrant-leave-member-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "left"
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}"
            },
            {
              "principalId": "{carolClientId}"
            }
          ]
        }
      }
    },
    {
      "name": "bobLeavesThenRejoins",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{bobClientId}/requests/pubgrant-rejoin-member-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{aliceClientId}"
            },
            {
              "principalId": "{carolClientId}"
            }
          ]
        }
      }
    },
    {
      "name": "carolIsBanned",
      "type": "http",
      "connection": "api",
      "request": {
