{
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "rallarWsBaseUrlSecondary": {
      "env": "RALLAR_WS_BASE_URL_SECONDARY",
      "default": "ws://127.0.0.1:18081"
    },
    "rallarWsBaseUrlTertiary": {
      "env": "RALLAR_WS_BASE_URL_TERTIARY",
      "default": "ws://127.0.0.1:18082"
    },
    "applicationId": "cluster-subscriber-instance-loss-{runId}",
    "workspaceId": "default-{runId}",
    "groupId": "cluster-subscriber-instance-loss-room-{runId}",
    "clientPassword": {
      "env": "RALLAR_BB_CSIL_PASSWORD",
      "default": "api-v1-csil-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "tertiary": {
      "type": "http",
      "baseUrl": "{apiTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "wsAlicePrimary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsBobSecondary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsCarolTertiary": {
      "type": "ws",
      "timeoutMs": 20000
    },
    "wsDaveSecondary": {
      "type": "ws",
      "timeoutMs": 20000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csil-register-alice-{runId}",
        "body": {
          "username": "csil-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csil-login-alice-{runId}",
        "body": {
          "username": "csil-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csil-register-bob-{runId}",
        "body": {
          "username": "csil-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csil-login-bob-{runId}",
        "body": {
          "username": "csil-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerCarol",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/csil-register-carol-{runId}",
        "body": {
          "username": "csil-carol-{runId}",
          "password": "{clientPassword}",
          "displayName": "carol client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginCarol",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/csil-login-carol-{runId}",
        "body": {
          "username": "csil-carol-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "carolClientId": "body.clientId",
          "carolSessionId": "body.sessionId",
          "carolAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveCarolAuthHeader",
      "type": "set",
      "output": "carolAuthHeader",
      "secret": true,
      "redactAs": "carolAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.carolAccessToken"
          }
        ]
      }
    },
    {
      "name": "aliceCreatesTheRoom",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/csil-create-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Cluster subscriber instance loss {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bobJoinsTheRoomOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/csil-join-room-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "carolJoinsTheRoomOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/join/requests/csil-join-room-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{carolClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "alicePresenceOnThePrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/csil-presence-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "csil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "csil-connection-generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "bobPresenceOnTheSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{bobSessionId}/requests/csil-presence-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "csil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "csil-connection-generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "carolPresenceOnTheTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{carolSessionId}/requests/csil-presence-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "generationId": "csil-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "csil-connection-generation-{runId}",
          "principalId": "{carolClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csil-ws-ticket-alice-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAlicePrimaryWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openAliceSocketOnThePrimary",
      "type": "ws.open",
      "connection": "wsAlicePrimary",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csil-ws-ticket-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobSecondaryWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlSecondary"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openBobSocketOnTheSecondary",
      "type": "ws.open",
      "connection": "wsBobSecondary",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "createCarolWsTicket",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/csil-ws-ticket-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "outputs": {
          "carolWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveCarolTertiaryWsUrl",
      "type": "set",
      "output": "carolWsUrl",
      "secret": true,
      "redactAs": "carolWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlTertiary"
          },
          "/api/ws/",
          {
            "path": "outputs.carolSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.carolWsTicket"
            }
          },
          "&applicationId={applicationId}&workspaceId={workspaceId}"
        ]
      }
    },
    {
      "name": "openCarolSocketOnTheTertiary",
      "type": "ws.open",
      "connection": "wsCarolTertiary",
      "request": {
        "url": "{carolWsUrl}",
        "timeoutMs": 20000
      }
    },
    {
      "name": "theSecondaryCrashes",
      "type": "server.stop",
      "request": {
        "target": "secondary",
        "mode": "crash"
      }
    },
    {
      "name": "aliceSendsBroadcastOne",
      "type": "ws.send",
      "connection": "wsAlicePrimary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "csil-broadcast-one-{runId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "csil-broadcast-one-trace-{runId}"
          },
          "route": {
            "topicId": "room.chat",
            "resourceId": "csil-broadcast-one-{runId}",
            "contextId": "{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "chat.message.v1",
            "contentType": "application/json",
            "resource": "{\"text\":\"while a subscriber server is lost\",\"runId\":\"{runId}\"}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheAdmittedReceiptOne",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
          "admittedReceiptOneResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 15000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1",
            "resource": {
              "msgId": "csil-broadcast-one-{runId}",
              "phase": "admitted"
            }
          }
        },
        "consume": true,
        "decodeJsonPaths": [
          "payload.resource"
        ]
      }
    },
    {
      "name": "parseAdmittedReceiptOne",
      "type": "set",
      "output": "admittedReceiptOne",
      "transform": {
        "jsonParse": {
          "path": "outputs.admittedReceiptOneResource"
        }
      }
    },
    {
      "name": "deriveBobExpectedAdmittedReceiptOne",
      "type": "set",
      "output": "bobExpectedAdmittedReceiptOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.admittedReceiptOne.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.bobSessionId"
          }
        ]
      }
    },
    {
      "name": "deriveCarolExpectedAdmittedReceiptOne",
      "type": "set",
      "output": "carolExpectedAdmittedReceiptOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.admittedReceiptOne.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.carolSessionId"
          }
        ]
      }
    },
    {
      "name": "assertTheAdmittedReceiptOne",
      "type": "assert",
      "actual": {
        "phase": "{admittedReceiptOne.phase}",
        "bobExpectedAdmittedReceiptOne": "{bobExpectedAdmittedReceiptOne}",
        "carolExpectedAdmittedReceiptOne": "{carolExpectedAdmittedReceiptOne}",
        "expectedBeyond": "{admittedReceiptOne.expectedRecipientPeerIds.2}",
        "confirmedBeyond": "{admittedReceiptOne.confirmedRecipientPeerIds.0}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "body": {
          "phase": "admitted",
          "bobExpectedAdmittedReceiptOne": true,
          "carolExpectedAdmittedReceiptOne": true,
          "expectedBeyond": "MISSING",
          "confirmedBeyond": "MISSING"
        }
      }
    },
    {
      "name": "carolReceivesBroadcastOne",
      "type": "ws.wait",
      "connection": "wsCarolTertiary",
      "expect": {
        "connection": "wsCarolTertiary",
        "withinMs": 15000,
        "message": {
          "id": {
            "msgId": "csil-broadcast-one-{runId}"
          },
          "route": {
            "topicId": "room.chat"
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          }
        }
      }
    },
    {
      "name": "carolAcknowledgesBroadcastOne",
      "type": "ws.send",
      "connection": "wsCarolTertiary",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "ack-carol-csil-broadcast-one-{runId}",
            "ts": 0,
            "senderId": "{carolSessionId}",
            "traceId": "trace-csil-ack-carol-one"
          },
          "route": {
            "topicId": "al-control",
            "resourceId": "csil-broadcast-one-{runId}",
            "contextId": "{aliceSessionId}"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "qos": {
            "delivery": {
              "algo": "best-effort"
            },
            "durability": {
              "algo": "volatile"
            },
            "ack": {
              "algo": "none",
              "opts": {
                "timeoutMs": 250
              }
            }
          },
          "payload": {
            "typeId": "al.control.ack.v3",
            "contentType": "application/json",
            "resource": "{\"ackedMsgId\":\"csil-broadcast-one-{runId}\",\"fromPeerId\":\"{carolSessionId}\",\"toPeerId\":\"{aliceSessionId}\",\"originPeerId\":\"{aliceSessionId}\",\"logicalRecipientPeerId\":\"{carolSessionId}\",\"carrier\":\"ws\",\"status\":\"delivered\",\"observedAtEpochMs\":0,\"proof\":null}"
          }
        }
      }
    },
    {
      "name": "aliceReceivesTheTimedOutReceiptOne",
      "type": "ws.wait",
      "connection": "wsAlicePrimary",
      "request": {
        "outputs": {
          "timedOutReceiptOneResource": "matchedMessage.data.payload.resource"
        }
      },
      "expect": {
        "connection": "wsAlicePrimary",
        "withinMs": 15000,
        "message": {
          "route": {
            "topicId": "al-control"
          },
          "targets": {
            "mode": "unicast",
            "toPeerId": "{aliceSessionId}"
          },
          "payload": {
            "typeId": "al.control.receipt.v1",
            "resource": {
              "msgId": "csil-broadcast-one-{runId}",
              "phase": "timed-out"
            }
          }
        },
        "consume": true,
        "decodeJsonPaths": [
          "payload.resource"
        ]
      }
    },
    {
      "name": "parseTimedOutReceiptOne",
      "type": "set",
      "output": "timedOutReceiptOne",
      "transform": {
        "jsonParse": {
          "path": "outputs.timedOutReceiptOneResource"
        }
      }
    },
    {
      "name": "deriveBobExpectedTimedOutReceiptOne",
      "type": "set",
      "output": "bobExpectedTimedOutReceiptOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.timedOutReceiptOne.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.bobSessionId"
          }
        ]
      }
    },
    {
      "name": "deriveCarolExpectedTimedOutReceiptOne",
      "type": "set",
      "output": "carolExpectedTimedOutReceiptOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.timedOutReceiptOne.expectedRecipientPeerIds"
          },
          {
            "path": "outputs.carolSessionId"
          }
        ]
      }
    },
    {
      "name": "deriveCarolConfirmedTimedOutReceiptOne",
      "type": "set",
      "output": "carolConfirmedTimedOutReceiptOne",
      "transform": {
        "includes": [
          {
            "path": "outputs.timedOutReceiptOne.confirmedRecipientPeerIds"
          },
          {
            "path": "outputs.carolSessionId"
          }
        ]
      }
    },
    {
      "name": "deriveBobConfirmedTimedOutReceiptOne",
      "type": "set",
      "output": "bobConfirmedTimedOutReceiptOne",
      "transform": {
        "includes": [
          {
