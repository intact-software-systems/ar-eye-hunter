{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "scopeAApplicationId": {
      "env": "RALLAR_BB_SCOPE_A_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-ws-a"
    },
    "scopeAWorkspaceId": {
      "env": "RALLAR_BB_SCOPE_A_WORKSPACE_ID",
      "default": "workspace-ws-a-{runId}"
    },
    "scopeBApplicationId": {
      "env": "RALLAR_BB_SCOPE_B_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-ws-b"
    },
    "scopeBWorkspaceId": {
      "env": "RALLAR_BB_SCOPE_B_WORKSPACE_ID",
      "default": "workspace-ws-b-{runId}"
    },
    "sharedGroupId": {
      "env": "RALLAR_BB_SHARED_GROUP_ID",
      "default": "shared-ws-group-{runId}"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "wsAlice": {
      "type": "ws",
      "timeoutMs": 10000
    },
    "wsBob": {
      "type": "ws",
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "aliceSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "username": "{aliceUsername}",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "bobSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "username": "{bobUsername}",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createScopeAGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{scopeAApplicationId}/workspaces/{scopeAWorkspaceId}/groups",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "create-ws-iso-a-{sharedGroupId}-{runId}",
          "groupId": "{sharedGroupId}",
          "displayName": "WS isolation scope A {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "statusCode": [
          201,
          409
        ],
        "bodyAnyOf": [
          {
            "group": {
              "applicationId": "{scopeAApplicationId}",
              "workspaceId": "{scopeAWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          },
          {
            "error": "string"
          }
        ]
      }
    },
    {
      "name": "joinAliceScopeAGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{scopeAApplicationId}/workspaces/{scopeAWorkspaceId}/groups/{sharedGroupId}/members/{aliceClientId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "join-ws-iso-a-{sharedGroupId}-{aliceClientId}-{runId}",
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "applicationId": "{scopeAApplicationId}",
            "workspaceId": "{scopeAWorkspaceId}",
            "groupId": "{sharedGroupId}"
          },
          "members": [
            {
              "principalId": "{aliceClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "createScopeBGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{scopeBApplicationId}/workspaces/{scopeBWorkspaceId}/groups",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "create-ws-iso-b-{sharedGroupId}-{runId}",
          "groupId": "{sharedGroupId}",
          "displayName": "WS isolation scope B {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{bobClientId}"
        }
      },
      "expect": {
        "statusCode": [
          201,
          409
        ],
        "bodyAnyOf": [
          {
            "group": {
              "applicationId": "{scopeBApplicationId}",
              "workspaceId": "{scopeBWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          },
          {
            "error": "string"
          }
        ]
      }
    },
    {
      "name": "joinBobScopeBGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{scopeBApplicationId}/workspaces/{scopeBWorkspaceId}/groups/{sharedGroupId}/members/{bobClientId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "join-ws-iso-b-{sharedGroupId}-{bobClientId}-{runId}",
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "applicationId": "{scopeBApplicationId}",
            "workspaceId": "{scopeBWorkspaceId}",
            "groupId": "{sharedGroupId}"
          },
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "createAliceWebSocketTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "ticket": "string",
          "sessionId": "{aliceSessionId}",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveAliceWebSocketUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "openAliceWebSocket",
      "type": "ws.open",
      "connection": "wsAlice",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "createBobWebSocketTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "ticket": "string",
          "sessionId": "{bobSessionId}",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveBobWebSocketUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "openBobWebSocket",
      "type": "ws.open",
      "connection": "wsBob",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "connectBobPresenceScopeB",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{scopeBApplicationId}/workspaces/{scopeBWorkspaceId}/groups/{sharedGroupId}/sessions/{bobSessionId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "presence-ws-iso-b-{bobSessionId}-{runId}",
          "generationId": "generation-ws-iso-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{sharedGroupId}"
          }
        }
      }
    },
    {
      "name": "observeScopeBGroupFrameOnBob",
      "type": "ws.wait",
      "connection": "wsBob",
      "expect": {
        "connection": "wsBob",
        "withinMs": 20000,
        "message": {
          "route": {
            "topicId": "group-state.snapshot"
          },
          "payload": {
            "typeId": "group-state.snapshot"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{scopeBApplicationId}",
              "workspaceId": "{scopeBWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          }
        }
      }
    },
    {
      "name": "connectAlicePresenceScopeA",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{scopeAApplicationId}/workspaces/{scopeAWorkspaceId}/groups/{sharedGroupId}/sessions/{aliceSessionId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "presence-ws-iso-a-{aliceSessionId}-{runId}",
          "generationId": "generation-ws-iso-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{sharedGroupId}"
          }
        }
      }
    },
    {
      "name": "observeScopeAGroupFrameOnAlice",
      "type": "ws.wait",
      "connection": "wsAlice",
      "expect": {
        "connection": "wsAlice",
        "withinMs": 20000,
        "message": {
          "route": {
            "topicId": "group-state.snapshot"
          },
          "payload": {
            "typeId": "group-state.snapshot"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{scopeAApplicationId}",
              "workspaceId": "{scopeAWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          }
        }
      }
    },
    {
      "name": "assertNoScopeAGroupFrameOnBob",
      "type": "ws.wait",
      "connection": "wsBob",
      "expect": {
        "connection": "wsBob",
        "withinMs": 4000,
        "absent": {
          "targets": {
            "groupRef": {
              "applicationId": "{scopeAApplicationId}",
              "workspaceId": "{scopeAWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          }
        }
      }
    },
    {
      "name": "assertNoScopeBGroupFrameOnAlice",
      "type": "ws.wait",
      "connection": "wsAlice",
      "expect": {
        "connection": "wsAlice",
        "withinMs": 2000,
        "absent": {
          "targets": {
            "groupRef": {
              "applicationId": "{scopeBApplicationId}",
              "workspaceId": "{scopeBWorkspaceId}",
              "groupId": "{sharedGroupId}"
            }
          }
        }
      }
    },
    {
      "name": "closeAliceWebSocket",
      "type": "ws.close",
      "connection": "wsAlice",
      "request": {
        "code": 1000,
        "reason": "api-v1 cross-application ws isolation recipe done"
      }
    },
    {
      "name": "closeBobWebSocket",
      "type": "ws.close",
      "connection": "wsBob",
      "request": {
        "code": 1000,
        "reason": "api-v1 cross-application ws isolation recipe done"
      }
    },
    {
      "name": "disconnectAlicePresenceScopeA",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{scopeAApplicationId}/workspaces/{scopeAWorkspaceId}/groups/{sharedGroupId}/sessions/{aliceSessionId}/disconnect",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "requestId": "disconnect-ws-iso-a-{aliceSessionId}-{runId}",
          "generationId": "generation-ws-iso-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{sharedGroupId}"
          }
        }
      }
    },
    {
      "name": "disconnectBobPresenceScopeB",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{scopeBApplicationId}/workspaces/{scopeBWorkspaceId}/groups/{sharedGroupId}/sessions/{bobSessionId}/disconnect",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "requestId": "disconnect-ws-iso-b-{bobSessionId}-{runId}",
          "generationId": "generation-ws-iso-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{sharedGroupId}"
          }
        }
      }
    },
    {
      "name": "logoutAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/logout",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "loggedOut": true
        }
      }
    },
    {
      "name": "logoutBob",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/logout",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "loggedOut": true
        }
      }
    }
  ]
}
