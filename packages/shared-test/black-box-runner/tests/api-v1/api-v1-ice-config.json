{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "rejectMissingIceAuth",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/webrtc/ice"
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "Unauthorized: Missing bearer token"
        }
      }
    },
    {
      "name": "loginDemoAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-demo-alice-001-0001",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "username": "{aliceUsername}",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "readAuthenticatedIceConfig",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/webrtc/ice",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "maxDurationMs": 10000,
        "body": {
          "iceServers": [],
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "openApiListsIceConfig",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/openapi.json"
      },
      "expect": {
        "status": 200,
        "body": {
          "paths": {
            "/api/webrtc/ice": {
              "get": {
                "security": [
                  {
                    "bearerAuth": [],
                    "clientIdHeader": []
                  }
                ],
                "responses": {
                  "200": "any",
                  "401": "any",
                  "429": "any",
                  "502": "any"
                }
              }
            }
          }
        }
      }
    }
  ]
}
