      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{reopenGroupId}/join/requests/join-reopen-forming-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
