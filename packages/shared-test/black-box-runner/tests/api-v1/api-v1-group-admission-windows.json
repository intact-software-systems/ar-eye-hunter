    },
    {
      "name": "bobLeavesTheReopenedLobby",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{reopenGroupId}/members/{bobClientId}/requests/leave-reopen-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "left"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
