          "lifecyclePolicy": {
            "formation": "phased",
            "manager": {
              "selection": "assigned",
              "assignedPrincipalIds": ["{aliceClientId}"],
              "count": 1
            },
            "establishment": {
              "initiator": "manager"
            },
            "activation": {
              "mode": "deadline",
              "successRate": 1,
              "minimumViableRate": 1,
              "deadlineMs": 3000,
              "maxFormationAttempts": 1
            },
