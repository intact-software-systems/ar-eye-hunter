      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobReopenPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{reopenGroupId}/sessions/{bobSessionId}/requests/presence-bob-reopen-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "managerEstablishesTheReopenGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{reopenGroupId}/lifecycle/establish/requests/establish-reopen-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
