        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}",
            "guestInvitation": {
              "verifier": "4e1edf064f82c30abb5bba36bc1759c625c7b818796361705d109bdaa8a6ff4e",
