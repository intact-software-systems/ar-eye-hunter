{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "applicationId": "state-read-{runId}",
    "workspaceId": "default-{runId}",
    "groupId": "snapshot-room-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "tertiary": {
      "type": "http",
      "baseUrl": "{apiTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-state-read-convergence",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "createClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-create-{runId}-state-read-convergence",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Snapshot reader initial {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "warmPrimaryClient",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "warmClientSource": "headers.rallar-state-source"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "mutateClientOnSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-update-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Snapshot reader updated {runId}",
          "status": "active",
          "roles": []
        },
        "outputs": {
          "clientFloor": "body.stateRevision"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "readClientFloorOnTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}?minStateRevision={clientFloor}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "clientRevisionBodyString": {
            "transform": {
              "string": {
                "path": "body.stateRevision"
              }
            }
          },
          "clientRevisionBodyIsNumeric": {
            "transform": {
              "equals": [
                {
                  "path": "body.stateRevision"
                },
                {
                  "number": {
                    "path": "body.stateRevision"
                  }
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "Rallar-State-Revision": "string",
          "Rallar-State-Source": "string"
        },
        "body": {
          "stateRevision": "integer"
        }
      }
    },
    {
      "name": "rejectUnsatisfiedClientFloor",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}?minStateRevision=9007199254740991",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "code": "state-revision-floor-not-satisfied"
        }
      }
    },
    {
      "name": "createGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Snapshot group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "warmPrimaryGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "warmGroupSource": "headers.rallar-state-source"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "mutatePresenceOnSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/presence-connect-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "connectionGenerationId": "connection-generation-{runId}",
          "principalId": "{aliceClientId}"
        },
        "outputs": {
          "groupFloor": "body.causalRevision.groupRevision",
          "presenceFloor": "body.causalRevision.presenceRevision"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "readGroupFloorOnTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}?minGroupRevision={groupFloor}&minPresenceRevision={presenceFloor}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "groupRevisionBodyString": {
            "transform": {
              "string": {
                "path": "body.causalRevision.groupRevision"
              }
            }
          },
          "presenceRevisionBodyString": {
            "transform": {
              "string": {
                "path": "body.causalRevision.presenceRevision"
              }
            }
          },
          "groupRevisionBodyIsNumeric": {
            "transform": {
              "equals": [
                {
                  "path": "body.causalRevision.groupRevision"
                },
                {
                  "number": {
                    "path": "body.causalRevision.groupRevision"
                  }
                }
              ]
            }
          },
          "presenceRevisionBodyIsNumeric": {
            "transform": {
              "equals": [
                {
                  "path": "body.causalRevision.presenceRevision"
                },
                {
                  "number": {
                    "path": "body.causalRevision.presenceRevision"
                  }
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "Rallar-Group-Revision": "string",
          "Rallar-Presence-Revision": "string",
          "Rallar-State-Source": "string"
        },
        "body": {
          "causalRevision": {
            "groupRevision": "integer",
            "presenceRevision": "integer"
          }
        }
      }
    },
    {
      "name": "rejectPartialGroupFloor",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}?minGroupRevision={groupFloor}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "invalid-group-causal-revision"
        }
      }
    },
    {
      "name": "assertReadConvergenceEvidence",
      "type": "assert",
      "actual": {
        "warmClientSource": "{warmClientSource}",
        "warmGroupSource": "{warmGroupSource}",
        "clientRevisionBody": "{resultsByName.readClientFloorOnTertiary.0.actual.body.stateRevision}",
        "groupRevisionBody": "{resultsByName.readGroupFloorOnTertiary.0.actual.body.causalRevision.groupRevision}",
        "presenceRevisionBody": "{resultsByName.readGroupFloorOnTertiary.0.actual.body.causalRevision.presenceRevision}",
        "clientRevisionHeader": "{resultsByName.readClientFloorOnTertiary.0.actual.headers.rallar-state-revision}",
        "groupRevisionHeader": "{resultsByName.readGroupFloorOnTertiary.0.actual.headers.rallar-group-revision}",
        "presenceRevisionHeader": "{resultsByName.readGroupFloorOnTertiary.0.actual.headers.rallar-presence-revision}",
        "clientRevisionBodyIsNumeric": "{clientRevisionBodyIsNumeric}",
        "groupRevisionBodyIsNumeric": "{groupRevisionBodyIsNumeric}",
        "presenceRevisionBodyIsNumeric": "{presenceRevisionBodyIsNumeric}"
      },
      "expect": {
        "body": {
          "warmClientSource": "durable",
          "warmGroupSource": "durable",
          "clientRevisionHeader": "{clientRevisionBodyString}",
          "groupRevisionHeader": "{groupRevisionBodyString}",
          "presenceRevisionHeader": "{presenceRevisionBodyString}",
          "clientRevisionBodyIsNumeric": true,
          "groupRevisionBodyIsNumeric": true,
          "presenceRevisionBodyIsNumeric": true
        },
        "comparators": [
          {
            "path": "clientRevisionBody",
            "gte": "{clientFloor}",
            "lte": 9007199254740991
          },
          {
            "path": "clientRevisionHeader",
            "gte": "{clientFloor}",
            "lte": 9007199254740991
          },
          {
            "path": "groupRevisionBody",
            "gte": "{groupFloor}",
            "lte": 9007199254740991
          },
          {
            "path": "groupRevisionHeader",
            "gte": "{groupFloor}",
            "lte": 9007199254740991
          },
          {
            "path": "presenceRevisionBody",
            "gte": "{presenceFloor}",
            "lte": 9007199254740991
          },
          {
            "path": "presenceRevisionHeader",
            "gte": "{presenceFloor}",
            "lte": 9007199254740991
          }
        ]
      }
    }
  ]
}
