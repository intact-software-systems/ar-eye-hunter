{
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": "status-lifecycle-{runId}",
    "workspaceId": "default-{runId}",
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://127.0.0.1:18080"
    },
    "statusGroupId": "status-room-{runId}",
    "carolUsername": "carol-sl-{runId}",
    "carolPassword": {
      "env": "RALLAR_CAROL_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "wsAlice": {
      "type": "ws",
      "timeoutMs": 10000
    },
    "wsBob": {
      "type": "ws",
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-001-{runId}-group-status-lifecycle",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-bob-002-{runId}-group-status-lifecycle",
        "body": {
          "username": "{bobUsername}",
          "password": "{bobPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createAliceClientState",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/clients/{aliceClientId}/principal/requests/client-create-alice-{runId}-group-status-lifecycle",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "username": "{aliceUsername}",
          "displayName": "Status lifecycle manager {runId}",
          "status": "active",
          "roles": []
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createStatusGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/group-create-status-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{statusGroupId}",
          "displayName": "Status lifecycle group {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}",
          "lifecyclePolicy": {
            "preset": "managed",
            "activation": {
              "mode": "threshold-or-deadline",
              "successRate": 0.95,
              "minimumViableRate": 0.5,
              "deadlineMs": 60000,
              "maxFormationAttempts": 3
            },
            "admission": {
              "mode": "open"
            }
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{statusGroupId}",
            "lifecycleState": "forming",
            "formationEpoch": 0
          }
        }
      }
    },
    {
      "name": "joinBobToStatusGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/join/requests/join-status-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "connectAliceStatusPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/sessions/{aliceSessionId}/requests/presence-alice-status-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectBobStatusPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/sessions/{bobSessionId}/requests/presence-bob-status-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{bobClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "theFormingGroupReportsInactive",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "forming",
          "condition": "inactive",
          "coverageBasisLayoutIdentity": null
        }
      }
    },
    {
      "name": "startStatusPlans",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/lifecycle/plan/requests/plan-status-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "lifecycleState": "planned",
            "formationEpoch": 1
          }
        }
      }
    },
    {
      "name": "startStatusPlansPublication",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/topology",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 15000,
          "backoffMs": 100,
          "backoffMultiplier": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "snapshot": {
            "state": "active"
          }
        }
      }
    },
    {
      "name": "startStatusPlansConnectsPublishedLayout",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 8000,
          "backoffMs": 100,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "formationEpoch": 2
        }
      }
    },
    {
      "name": "theDialingGroupReportsInitialising",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "connecting",
          "condition": "initialising"
        }
      }
    },
    {
      "name": "createAliceWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-status-lifecycle-presence-01-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "aliceWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveAliceWsUrl",
      "type": "set",
      "output": "aliceWsUrl",
      "secret": true,
      "redactAs": "aliceWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.aliceSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.aliceWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "openAliceWs",
      "type": "ws.open",
      "connection": "wsAlice",
      "request": {
        "url": "{aliceWsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "createBobWsTicket",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-status-lifecycle-bob-ws-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "outputs": {
          "bobWsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveBobWsUrl",
      "type": "set",
      "output": "bobWsUrl",
      "secret": true,
      "redactAs": "bobWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrl"
          },
          "/api/ws/",
          {
            "path": "outputs.bobSessionId"
          },
          "?ticket=",
          {
            "urlEncode": {
              "path": "outputs.bobWsTicket"
            }
          }
        ]
      }
    },
    {
      "name": "openBobWs",
      "type": "ws.open",
      "connection": "wsBob",
      "request": {
        "url": "{bobWsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "deriveRttCreatedAt",
      "type": "set",
      "output": "rttCreatedAtEpochMs",
      "transform": {
        "timestamp": true
      }
    },
    {
      "name": "deriveRttReporter",
      "type": "set",
      "output": "rttReporter",
      "transform": {
        "if": {
          "condition": {
            "operator": "lexicallyBefore",
            "values": [
              {
                "path": "outputs.aliceSessionId"
              },
              {
                "path": "outputs.bobSessionId"
              }
            ]
          },
          "then": {
            "connection": "wsAlice",
            "sessionIdFrom": {
              "path": "outputs.aliceSessionId"
            },
            "sessionIdTo": {
              "path": "outputs.bobSessionId"
            }
          },
          "else": {
            "connection": "wsBob",
            "sessionIdFrom": {
              "path": "outputs.bobSessionId"
            },
            "sessionIdTo": {
              "path": "outputs.aliceSessionId"
            }
          }
        }
      }
    },
    {
      "name": "deriveRttResource",
      "type": "set",
      "output": "rttResource",
      "transform": {
        "concat": [
          "{\"sessionIdFrom\":\"",
          {
            "path": "outputs.rttReporter.sessionIdFrom"
          },
          "\",\"sessionIdTo\":\"",
          {
            "path": "outputs.rttReporter.sessionIdTo"
          },
          "\",\"rttMs\":42,\"createdAtEpochMs\":",
          {
            "path": "outputs.rttCreatedAtEpochMs"
          },
          ",\"version\":1}"
        ]
      }
    },
    {
      "name": "reportTheObservedEdge",
      "type": "ws.send",
      "connection": "{rttReporter.connection}",
      "request": {
        "send": {
          "id": {
            "v": 2,
            "msgId": "rtt-report-status-lifecycle-{runId}",
            "ts": 0,
            "senderId": "{rttReporter.sessionIdFrom}",
            "sessionId": "{rttReporter.sessionIdFrom}"
          },
          "route": {
            "topicId": "rtt",
            "resourceId": "{aliceSessionId} {bobSessionId}",
            "contextId": "1"
          },
          "delivery": {
            "reliability": "best-effort",
            "ack": "none"
          },
          "payload": {
            "typeId": "rtt",
            "contentType": "application/json",
            "resource": "{rttResource}"
          }
        }
      }
    },
    {
      "name": "theObservedEdgeActivatesAndPublishesActive",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 20,
          "maxDurationMs": 8000,
          "backoffMs": 100,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "lifecycleState": "active",
          "condition": "active",
          "remediation": "none"
        }
      }
    },
    {
      "name": "theWriterStoredTheActiveStatusOnTheRow",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 25000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "activationStatus": {
              "condition": "active",
              "coverageRate": 1
            }
          }
        }
      }
    },
    {
      "name": "registerCarol",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/bb-status-lifecycle-1b523385-{runId}",
        "body": {
          "username": "{carolUsername}",
          "password": "{carolPassword}",
          "displayName": "Status lifecycle carol {runId}"
        }
      },
      "expect": {
        "statusCode": [
          201,
          409
        ]
      }
    },
    {
      "name": "loginCarol",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-status-lifecycle-c7652d91-{runId}",
        "body": {
          "username": "{carolUsername}",
          "password": "{carolPassword}"
        },
        "outputs": {
          "carolClientId": "body.clientId",
          "carolSessionId": "body.sessionId",
          "carolAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveCarolAuthHeader",
      "type": "set",
      "output": "carolAuthHeader",
      "secret": true,
      "redactAs": "carolAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.carolAccessToken"
          }
        ]
      }
    },
    {
      "name": "joinCarolToStatusGroup",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/join/requests/join-status-carol-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{carolClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "connectCarolStatusPresence",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/sessions/{carolSessionId}/requests/presence-carol-status-lifecycle-{runId}",
        "headers": {
          "Authorization": "{carolAuthHeader}",
          "x-client-id": "{carolClientId}"
        },
        "body": {
          "generationId": "generation-{runId}",
          "principalId": "{carolClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "theWidenedLayoutFallsBelowTheViableFloor",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}/formation",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 25000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "condition": "failed",
          "readiness": {
            "plannedEdgeCount": 3,
            "observedEdgeCount": 1
          },
          "lifecycleState": "active",
          "remediation": "none"
        }
      }
    },
    {
      "name": "theClockStoredTheFailedStatusOnTheRow",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{statusGroupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 40,
          "maxDurationMs": 25000,
          "backoffMs": 150,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "activationStatus": {
              "condition": "failed"
            }
          }
        }
      }
    },
    {
      "name": "closeAliceWs",
      "type": "ws.close",
      "connection": "wsAlice",
      "request": {
        "code": 1000,
        "reason": "formation criterion ws checks done"
      }
    },
    {
      "name": "closeBobWs",
      "type": "ws.close",
      "connection": "wsBob",
      "request": {
        "code": 1000,
        "reason": "formation criterion ws checks done"
      }
    }
  ],
  "description": "The observed activation condition walked across a formation. Three of the four condition reads are satisfied by the formation view whether or not the writer ran, because that read falls back to computing the condition when no status is stored -- so the two group reads are what actually prove the writer: they assert `activationStatus` on the group row itself, which only the writer can put there. The walk is `inactive` with no coverage basis while forming, `initialising` while dialing the frozen planned candidate, `active` once the one planned edge is observed, and `failed` once a third session widens the planned edge set to three with one edge observed -- a third, below the viable floor. That last transition is the durable dwell clock reporting a decay no evidence arrival could report, and it pins `lifecycleState: active` so the exhausted-in-dormant route to the same value is excluded. The `failed` poll must stay well under the 60s evidence freshness window, or the single sample ages out and the failure presents as a readiness bug rather than a timeout. `degraded` and the recovery above it need a further clock cycle to set `dwellSatisfied` and are left to a recipe that can observe the clock rather than race it."
}
