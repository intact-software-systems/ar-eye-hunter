        },
        "body": {
          "generationId": "dirapt-generation-{runId}",
          "publicationKey": null,
          "connectionGenerationId": "dirapt-connection-generation-{runId}",
          "principalId": "{ownerClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "connectMemberAPresence",
