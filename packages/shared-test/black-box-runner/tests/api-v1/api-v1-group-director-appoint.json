{
  "description": "No-browser API-v1 browser-director appointment: the route no recipe calls. Every eligibility branch is observed -- a non-member, a member without an active room session, a plain member while an owner is online, and a second member against an active fallback director are each refused with the reason that names the branch, since all four share one code. Each accepted appointment advances the director epoch and the metadata version by exactly one, pins the heartbeat TTL default, and leaves the group fields and the seeded metadata entry it must not touch unchanged. A generic metadata replacement that leaves the director out keeps the appointment when another principal or another session of the appointed principal writes it, and removes it, in one metadata version, when the appointed session itself writes it.",
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "applicationId": {
      "env": "RALLAR_BB_DIRAPT_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-dirapt"
    },
    "workspaceId": {
      "env": "RALLAR_BB_DIRAPT_WORKSPACE_ID",
      "default": "workspace-dirapt-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_DIRAPT_GROUP_ID",
      "default": "dirapt-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_DIRAPT_PASSWORD",
      "default": "api-v1-dirapt-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "registerOwner",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/dirapt-register-owner-{runId}",
        "body": {
          "username": "dirapt-owner-{runId}",
          "password": "{clientPassword}",
          "displayName": "owner client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginOwner",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/dirapt-login-owner-{runId}",
        "body": {
          "username": "dirapt-owner-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "ownerClientId": "body.clientId",
          "ownerSessionId": "body.sessionId",
          "ownerAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveOwnerAuthHeader",
      "type": "set",
      "output": "ownerAuthHeader",
      "secret": true,
      "redactAs": "ownerAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.ownerAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerMemberA",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/dirapt-register-membera-{runId}",
        "body": {
          "username": "dirapt-membera-{runId}",
          "password": "{clientPassword}",
          "displayName": "membera client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginMemberA",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
