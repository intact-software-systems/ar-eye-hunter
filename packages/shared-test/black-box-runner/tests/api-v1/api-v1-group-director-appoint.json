        },
        "outputs": {
          "outsiderClientId": "body.clientId",
          "outsiderSessionId": "body.sessionId",
          "outsiderAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveOutsiderAuthHeader",
      "type": "set",
      "output": "outsiderAuthHeader",
      "secret": true,
      "redactAs": "outsiderAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
