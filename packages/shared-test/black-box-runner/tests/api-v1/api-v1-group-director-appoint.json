    {
      "name": "publishMatchDeadline",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/requests/publishMatchDeadline-{runId}",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "body": {
          "roomDeadline": {
            "name": "match",
            "expectedRevision": 0,
            "atEpochMs": 4102444800000
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "group": {
            "metadata": {
              "rallarRoomDeadlines": [
                {
                  "name": "match",
                  "revision": 1,
                  "atEpochMs": 4102444800000
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "metadataReplacementKeepsCurrentAppointment",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/requests/dirapt-replace-room-topic-{runId}",
