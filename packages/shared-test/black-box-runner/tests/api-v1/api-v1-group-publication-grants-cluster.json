        "status": 200
      }
    },
    {
      "name": "deriveCarolTertiaryWsUrl",
      "type": "set",
      "output": "carolWsUrl",
      "secret": true,
      "redactAs": "carolWsUrl",
      "transform": {
        "concat": [
          {
            "path": "variables.rallarWsBaseUrlTertiary"
          },
