{
  "description": "No-browser API-v1 publication grants across a three-node cluster. A grant written on the primary is read back on the secondary and the tertiary through the polled cross-node read, since group snapshots are served through a node-local cache; a revoke written on the secondary is read back on the primary and the tertiary. Replaying the primary's grant requestId on the tertiary answers the first result -- the granted row at the grant's group revision -- although the grant has since been revoked.",
  "variables": {
    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "applicationId": {
      "env": "RALLAR_BB_PUBGRANTCL_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-pubgrantcl"
    },
    "workspaceId": {
      "env": "RALLAR_BB_PUBGRANTCL_WORKSPACE_ID",
      "default": "workspace-pubgrantcl-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_PUBGRANTCL_GROUP_ID",
      "default": "pubgrantcl-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_PUBGRANTCL_PASSWORD",
      "default": "api-v1-pubgrantcl-password",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "primary": {
      "type": "http",
      "baseUrl": "{apiPrimary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "secondary": {
      "type": "http",
      "baseUrl": "{apiSecondary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    },
    "tertiary": {
      "type": "http",
      "baseUrl": "{apiTertiary}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 15000
    }
  },
  "steps": [
    {
      "name": "registerAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/pubgrantcl-register-alice-{runId}",
        "body": {
          "username": "pubgrantcl-alice-{runId}",
          "password": "{clientPassword}",
          "displayName": "alice client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginAlice",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/pubgrantcl-login-user-alice-{runId}",
        "body": {
          "username": "pubgrantcl-alice-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceSessionId": "body.sessionId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "secret": true,
      "redactAs": "aliceAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.aliceAccessToken"
          }
        ]
      }
    },
    {
      "name": "registerBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/pubgrantcl-register-bob-{runId}",
        "body": {
          "username": "pubgrantcl-bob-{runId}",
          "password": "{clientPassword}",
          "displayName": "bob client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginBob",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/pubgrantcl-login-user-bob-{runId}",
        "body": {
          "username": "pubgrantcl-bob-{runId}",
          "password": "{clientPassword}"
        },
        "outputs": {
          "bobClientId": "body.clientId",
          "bobSessionId": "body.sessionId",
          "bobAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveBobAuthHeader",
      "type": "set",
      "output": "bobAuthHeader",
      "secret": true,
      "redactAs": "bobAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.bobAccessToken"
          }
        ]
      }
    },
    {
      "name": "createGroupOnPrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/pubgrantcl-create-group-room-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "Publication grants cluster {runId}",
          "kind": "room",
          "joinMode": "open"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "group": {
            "groupId": "{groupId}"
          }
        }
      }
    },
    {
      "name": "bobJoinsOnPrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{bobClientId}/requests/pubgrantcl-join-member-bob-{runId}",
        "headers": {
          "Authorization": "{bobAuthHeader}",
          "x-client-id": "{bobClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "members": [
            {
              "principalId": "{bobClientId}",
              "status": "active"
            }
          ]
        }
      }
    },
    {
      "name": "grantOnPrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrantcl-grant-bob-feed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrantcl-feed",
          "publish": true,
          "subscribe": true
        },
        "outputs": {
          "groupRevisionAfterGrant": "body.causalRevision.groupRevision"
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrantcl-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "readGrantOnSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 30,
          "maxDurationMs": 20000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrantcl-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "readGrantOnTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 30,
          "maxDurationMs": 20000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrantcl-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "revokeOnSecondary",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/revoke/requests/pubgrantcl-revoke-bob-feed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrantcl-feed",
          "publish": true,
          "subscribe": true
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": []
        }
      }
    },
    {
      "name": "readRevokeOnPrimary",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 30,
          "maxDurationMs": 20000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": []
        }
      }
    },
    {
      "name": "readRevokeOnTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "poll": {
          "maxAttempts": 30,
          "maxDurationMs": 20000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "publicationGrants": []
        }
      }
    },
    {
      "name": "replayGrantOnTertiary",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/publication-grants/{bobClientId}/grant/requests/pubgrantcl-grant-bob-feed-{runId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "topicId": "room.pubgrantcl-feed",
          "publish": true,
          "subscribe": true
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "causalRevision": {
            "groupRevision": "{groupRevisionAfterGrant}"
          },
          "publicationGrants": [
            {
              "principalId": "{bobClientId}",
              "topics": {
                "room.pubgrantcl-feed": {
                  "publish": true,
                  "subscribe": true
                }
              }
            }
          ]
        }
      }
    }
  ],
  "postRunAssertions": [
    {
      "name": "no failed steps",
      "path": "summary.failure",
      "eq": 0
    }
  ]
}
