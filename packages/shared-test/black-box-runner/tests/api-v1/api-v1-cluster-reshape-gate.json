    },
    {
      "name": "computeWhenTheGateOpens",
      "type": "set",
      "output": "gateOpensAt",
      "transform": {
        "add": [
          {
            "path": "outputs.firstReshapeAt"
          },
          15000
        ]
      }
    },
    {
      "name": "theKindChangeBackToAStarIsHeld",
      "type": "http",
      "connection": "secondary",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/rooms/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology-plans",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "poll": {
          "maxAttempts": 50,
          "maxDurationMs": 10000,
          "backoffMs": 200,
          "backoffMultiplier": 1
        },
        "outputs": {
          "heldAt": "body.reshapeGate.gate.heldAtEpochMs",
          "heldWantedReasons": "body.reshapeGate.wantedReasons"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "plans": [
            {
              "topology": "tree",
              "memberCount": 4,
              "plan": {
                "change": {
                  "kind": "repair"
                },
                "heldReshapeReasons": [
                  "kind-change"
                ]
              }
            }
          ],
          "reshapeGate": {
            "gate": {
              "lastPassAtEpochMs": "{firstReshapeAt}",
              "consecutiveHeldPasses": 0,
              "heldAtEpochMs": "integer"
            },
            "wantedReasons": [
              "kind-change"
            ],
            "intervalMs": 15000,
            "opensAtEpochMs": "{gateOpensAt}"
          }
        }
      }
    },
    {
      "name": "theRoomKeepsItsTreeWhileHeld",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology",
        "headers": {
          "Authorization": "{ownerAuthHeader}",
          "x-client-id": "{ownerClientId}"
        },
        "poll": {
          "maxAttempts": 25,
          "maxDurationMs": 5000,
          "backoffMs": 200,
          "backoffMultiplier": 1
        }
      },
      "expect": {
        "status": 200,
        "comparison": "compatible-complete",
        "body": {
          "groupRef": {
            "groupId": "{groupId}"
          },
          "snapshot": {
            "state": "active",
            "topology": "tree",
            "activeSessionIds": [
              "{ownerSessionId}",
              "{secondSessionId}",
              "{thirdSessionId}",
              "{fourthSessionId}"
            ]
          }
        }
      }
    },
    {
      "name": "theFirstReshapeOpenedTheGateAndTheHoldFellInsideIt",
      "type": "assert",
      "actual": {
        "firstReshapeAt": "{firstReshapeAt}",
        "firstGateOpensAt": "{firstGateOpensAt}",
        "firstWantedReasons": "{firstWantedReasons}",
        "gateOpensAt": "{gateOpensAt}",
        "heldAt": "{heldAt}",
        "heldWantedReasons": "{heldWantedReasons}"
      },
      "expect": {
        "comparators": [
          {
            "path": "firstGateOpensAt",
            "equals": "{gateOpensAt}"
          },
          {
            "path": "firstWantedReasons",
            "length": 0
          },
          {
            "path": "heldAt",
            "gte": "{firstReshapeAt}"
          },
          {
            "path": "heldAt",
            "lt": "{gateOpensAt}"
          },
          {
            "path": "heldWantedReasons",
            "equals": [
              "kind-change"
            ]
          }
        ]
      }
    },
    {
      "name": "theOpenedGateReleasesTheHeldKindChange",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/rooms/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology-plans",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "poll": {
          "maxAttempts": 60,
          "maxDurationMs": 25000,
          "backoffMs": 500,
          "backoffMultiplier": 1
        },
        "outputs": {
          "secondReshapeAt": "body.reshapeGate.gate.lastPassAtEpochMs",
          "releasedWantedReasons": "body.reshapeGate.wantedReasons"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "plans": [
            {
              "topology": "star",
              "memberCount": 4,
              "plan": {
                "change": {
                  "kind": "reshape",
                  "reason": "kind-change"
                }
              }
            }
          ],
          "reshapeGate": {
            "gate": {
              "lastPassAtEpochMs": "integer",
              "consecutiveHeldPasses": 1,
              "heldAtEpochMs": null
            },
            "intervalMs": 30000
          }
        }
      }
    },
    {
      "name": "bothReshapesArePlannedAtTheirGatePasses",
      "type": "http",
      "connection": "primary",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/rooms/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology-plans",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "poll": {
          "maxAttempts": 25,
          "maxDurationMs": 5000,
          "backoffMs": 200,
          "backoffMultiplier": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "plans": [
            {
              "topology": "tree",
              "memberCount": 5,
              "plan": {
                "plannedAtEpochMs": "{firstReshapeAt}",
                "change": {
                  "kind": "reshape",
                  "reason": "kind-change"
                }
              }
            },
            {
              "topology": "star",
              "memberCount": 4,
              "plan": {
                "plannedAtEpochMs": "{secondReshapeAt}",
                "change": {
                  "kind": "reshape",
                  "reason": "kind-change"
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "theReleaseWaitedForTheGateAndOwesNothing",
      "type": "assert",
      "actual": {
        "secondReshapeAt": "{secondReshapeAt}",
        "gateOpensAt": "{gateOpensAt}",
        "releasedWantedReasons": "{releasedWantedReasons}"
      },
      "expect": {
        "comparators": [
          {
            "path": "secondReshapeAt",
            "gte": "{gateOpensAt}"
          },
          {
            "path": "releasedWantedReasons",
            "length": 0
          }
        ]
      }
    }
  ]
}
