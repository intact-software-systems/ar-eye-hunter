    "apiPrimary": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "apiSecondary": {
      "env": "RALLAR_API_BASE_URL_SECONDARY",
      "default": "http://127.0.0.1:18081"
    },
    "apiTertiary": {
      "env": "RALLAR_API_BASE_URL_TERTIARY",
      "default": "http://127.0.0.1:18082"
    },
    "applicationId": {
      "env": "RALLAR_BB_RESHAPEGATECL_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-reshapegatecl"
    },
    "workspaceId": {
      "env": "RALLAR_BB_RESHAPEGATECL_WORKSPACE_ID",
      "default": "workspace-reshapegatecl-{runId}"
    },
    "groupId": {
      "env": "RALLAR_BB_RESHAPEGATECL_GROUP_ID",
      "default": "reshapegatecl-group-{runId}"
    },
    "clientPassword": {
      "env": "RALLAR_BB_RESHAPEGATECL_PASSWORD",
      "default": "api-v1-reshapegatecl-password",
      "secret": true
    },
    "adminUsername": {
      "env": "RALLAR_BB_ADMIN_USERNAME",
      "default": "admin"
    },
    "adminPassword": {
      "env": "RALLAR_BB_ADMIN_PASSWORD",
      "default": "admin",
      "secret": true
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
