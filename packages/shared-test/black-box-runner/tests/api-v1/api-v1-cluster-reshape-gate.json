    {
      "name": "theKindChangeToATreePassesTheOpenGate",
      "type": "http",
      "connection": "tertiary",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/rooms/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/topology-plans",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "poll": {
          "maxAttempts": 60,
          "maxDurationMs": 20000,
          "backoffMs": 200,
          "backoffMultiplier": 1.2
        },
        "outputs": {
          "firstReshapeAt": "body.reshapeGate.gate.lastPassAtEpochMs",
          "firstGateOpensAt": "body.reshapeGate.opensAtEpochMs",
          "firstWantedReasons": "body.reshapeGate.wantedReasons"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "roomRef": {
            "applicationId": "{applicationId}",
            "workspaceId": "{workspaceId}",
            "groupId": "{groupId}"
          },
          "plans": [
            {
              "topology": "tree",
              "memberCount": 5,
              "plan": {
                "change": {
                  "kind": "reshape",
                  "reason": "kind-change"
                }
              }
            }
          ],
          "reshapeGate": {
            "gate": {
              "lastPassAtEpochMs": "integer",
              "consecutiveHeldPasses": 0,
              "heldAtEpochMs": null
            },
            "intervalMs": 15000,
            "opensAtEpochMs": "integer"
          }
        }
      }
