{
  "variables": {
    "executionToken": {
      "env": "RALLAR_BB_EXECUTION_TOKEN",
      "required": true
    },
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://127.0.0.1:18080"
    },
    "runId": {
      "env": "RALLAR_BB_RUN_ID",
      "default": "local"
    },
    "scopeApplicationId": {
      "env": "RALLAR_BB_ADMINOPS_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-adminops"
    },
    "scopeWorkspaceId": {
      "env": "RALLAR_BB_ADMINOPS_WORKSPACE_ID",
      "default": "workspace-adminops-{runId}"
    },
    "emptyApplicationId": {
      "env": "RALLAR_BB_ADMINOPS_EMPTY_APPLICATION_ID",
      "default": "api-v1-black-box-{runId}-adminops-empty"
    },
    "emptyWorkspaceId": {
      "env": "RALLAR_BB_ADMINOPS_EMPTY_WORKSPACE_ID",
      "default": "workspace-adminops-empty-{runId}"
    },
    "scopePassword": {
      "env": "RALLAR_BB_ADMINOPS_PASSWORD",
      "default": "api-v1-adminops-password",
      "secret": true
    }
  },
  "execution": {
    "correlation": {
      "injectHeaders": true,
      "injectPayloads": false
    }
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    }
  },
  "steps": [
    {
      "name": "rejectMissingAdminAuth",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/overview"
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "Unauthorized: Missing bearer token"
        }
      }
    },
    {
      "name": "rejectMissingCrdtMutationAuth",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/lifecycle/requests/bb-reject-missing-crdt-mutation-auth-001-0001",
        "body": {
          "document": {
            "applicationId": "app-1",
            "workspaceId": "workspace-1",
            "scope": "principal",
            "documentType": "checklist",
            "documentId": "doc-1",
            "principalId": "principal-1"
          },
          "lifecycle": "active"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "authentication-required",
          "status": 401
        }
      }
    },
    {
      "name": "loginDemoAdmin",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-demo-admin-002-0001-admin-operations",
        "body": {
          "username": "admin",
          "password": "admin"
        },
        "outputs": {
          "adminClientId": "body.clientId",
          "adminAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "admin",
          "accessToken": "string",
          "username": "admin",
          "sessionId": "string",
          "expiresAtEpochMs": "integer"
        }
      }
    },
    {
      "name": "deriveAdminAuthHeader",
      "type": "set",
      "output": "adminAuthHeader",
      "secret": true,
      "redactAs": "adminAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.adminAccessToken"
          }
        ]
      }
    },
    {
      "name": "readAdminOverview",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/overview",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "generatedAtEpochMs": "integer",
          "serverId": "string",
          "health": {
            "status": "string"
          }
        }
      }
    },
    {
      "name": "dryRunPruneExpired",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/maintenance/prune-expired/requests/bb-dry-run-prune-expired-003-0001",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "dryRun": true,
          "categories": [
            "runtime-state",
            "resource-inbox-results"
          ],
          "reason": "black-box-admin-operations-dry-run"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "generatedAtEpochMs": "integer",
          "operation": "maintenance.prune-expired",
          "status": "dry-run",
          "changed": false
        }
      }
    },
    {
      "name": "runBoundedPruneToCompletion",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/maintenance/prune-expired/requests/bb-request-prune-{executionToken}",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "dryRun": false,
          "categories": [
            "runtime-state",
            "resource-inbox-results"
          ],
          "reason": "black-box-bounded-prune"
        },
        "outputs": {
          "boundedPruneStatus": "body.status",
          "boundedPruneResults": "body.results"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "operation": "maintenance.prune-expired",
          "status": "completed",
          "jobId": "string",
          "results": [
            {
              "category": "runtime-state",
              "expiredRows": "integer",
              "deletedRows": "integer",
              "dryRun": false
            },
            {
              "category": "resource-inbox-results",
              "expiredRows": "integer",
              "deletedRows": "integer",
              "dryRun": false
            }
          ]
        }
      }
    },
    {
      "name": "exposeStateWriteEvidence",
      "type": "set.state-write-evidence",
      "output": "stateWriteEvidence",
      "request": {
        "stateWriteEvidence": {
          "match": "bb-request-prune-{executionToken}",
          "commandTypes": [
            "ADMIN_PRUNE_EXPIRED"
          ],
          "minimumMatchedRows": 1
        }
      }
    },
    {
      "name": "assertAtomicAppInboxCompletion",
      "type": "assert",
      "actual": {
        "atomicCompletionFailures": "{stateWriteEvidence.atomicCompletionFailures}",
        "intermediateMutationIntentCount": "{stateWriteEvidence.intermediateMutationIntentCount}",
        "completedAppInboxStatus": "{stateWriteEvidence.completedAppInboxStatus}",
        "pruneStatus": "{boundedPruneStatus}",
        "boundedPages": "{boundedPruneResults}"
      },
      "expect": {
        "body": {
          "atomicCompletionFailures": 0,
          "intermediateMutationIntentCount": 0,
          "completedAppInboxStatus": "COMPLETED",
          "pruneStatus": "completed",
          "boundedPages": [
            {
              "category": "runtime-state",
              "expiredRows": "integer",
              "deletedRows": "integer",
              "dryRun": false
            },
            {
              "category": "resource-inbox-results",
              "expiredRows": "integer",
              "deletedRows": "integer",
              "dryRun": false
            }
          ]
        }
      }
    },
    {
      "name": "rejectInvalidCrdtLifecycle",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/lifecycle/requests/bb-reject-invalid-crdt-lifecycle-005-0001",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "document": {
            "applicationId": "app-1",
            "workspaceId": "workspace-1",
            "scope": "room",
            "documentType": "map",
            "documentId": "doc-1"
          },
          "lifecycle": "destroy"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "api-mutation-request-invalid",
          "status": 400
        }
      }
    },
    {
      "name": "rejectInvalidCrdtErasureMode",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/erase/requests/bb-reject-invalid-crdt-erasure-mode-006-0001",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "document": {
            "applicationId": "app-1",
            "workspaceId": "workspace-1",
            "scope": "room",
            "documentType": "map",
            "documentId": "doc-1"
          },
          "mode": "redact-payload"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "type": "api-mutation-failure",
          "version": "canonical.v2",
          "code": "api-mutation-request-invalid",
          "status": 400
        }
      }
    },
    {
      "name": "openApiListsAdminOperations",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/openapi.json"
      },
      "expect": {
        "status": 200,
        "body": {
          "paths": {
            "/api/admin/operations/overview": {
              "get": {
                "security": [
                  {
                    "bearerAuth": [],
                    "clientIdHeader": []
                  }
                ],
                "responses": {
                  "200": "any",
                  "401": "any",
                  "403": "any"
                }
              }
            },
            "/api/admin/operations/maintenance/prune-expired/requests/{requestId}": {
              "post": {
                "security": [
                  {
                    "bearerAuth": [],
                    "clientIdHeader": []
                  }
                ],
                "responses": {
                  "200": "any",
                  "401": "any",
                  "403": "any"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "theStateReadIsEmptyForAnUntouchedScope",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/state/apps/{emptyApplicationId}/workspaces/{emptyWorkspaceId}",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "scope": {
            "applicationId": "{emptyApplicationId}",
            "workspaceId": "{emptyWorkspaceId}"
          },
          "clients": {
            "totalPrincipals": 0,
            "onlinePrincipals": 0,
            "activeSessions": 0
          },
          "groups": {
            "activeGroups": 0,
            "totalActiveMembers": 0,
            "onlineMembers": 0
          },
          "events": {
            "recentClientEvents": 0,
            "recentGroupEvents": 0
          }
        }
      }
    },
    {
      "name": "theCrdtReadIsEmptyForAnUntouchedScope",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/crdt/apps/{emptyApplicationId}/workspaces/{emptyWorkspaceId}",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "scope": {
            "applicationId": "{emptyApplicationId}",
            "workspaceId": "{emptyWorkspaceId}"
          },
          "documents": {
            "total": 0
          },
          "storage": {
            "updates": 0,
            "snapshots": 0,
            "storedUpdateBytes": 0
          }
        }
      }
    },
    {
      "name": "registerScopeClient",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/register/requests/adminops-register-scope-{runId}",
        "body": {
          "username": "adminops-scope-{runId}",
          "password": "{scopePassword}",
          "displayName": "Admin operations scope client"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "clientId": "string"
        }
      }
    },
    {
      "name": "loginScopeClient",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/adminops-login-scope-{runId}",
        "body": {
          "username": "adminops-scope-{runId}",
          "password": "{scopePassword}"
        },
        "outputs": {
          "scopeClientId": "body.clientId",
          "scopeSessionId": "body.sessionId",
          "scopeAccessToken": {
            "path": "body.accessToken",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveScopeAuthHeader",
      "type": "set",
      "output": "scopeAuthHeader",
      "secret": true,
      "redactAs": "scopeAuthHeader",
      "transform": {
        "concat": [
          "Bearer ",
          {
            "path": "outputs.scopeAccessToken"
          }
        ]
      }
    },
    {
      "name": "createTheScopedGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{scopeApplicationId}/workspaces/{scopeWorkspaceId}/groups/requests/adminops-create-group-{runId}",
        "headers": {
          "Authorization": "{scopeAuthHeader}",
          "x-client-id": "{scopeClientId}"
        },
        "body": {
          "groupId": "adminops-group-{runId}",
          "displayName": "Admin operations scope {runId}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{scopeClientId}"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "connectScopedPresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{scopeApplicationId}/workspaces/{scopeWorkspaceId}/groups/adminops-group-{runId}/sessions/{scopeSessionId}/requests/adminops-presence-{runId}",
        "headers": {
          "Authorization": "{scopeAuthHeader}",
          "x-client-id": "{scopeClientId}"
        },
        "body": {
          "generationId": "adminops-generation-{runId}",
          "principalId": "{scopeClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "theStateReadSeesOnlyThePopulatedScope",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/state/apps/{scopeApplicationId}/workspaces/{scopeWorkspaceId}",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "poll": {
          "maxAttempts": 25,
          "maxDurationMs": 15000,
          "backoffMs": 150,
          "backoffMultiplier": 1.25
        },
        "outputs": {
          "scopedPrincipals": "body.clients.totalPrincipals"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "scope": {
            "applicationId": "{scopeApplicationId}",
            "workspaceId": "{scopeWorkspaceId}"
          },
          "groups": {
            "activeGroups": 1
          }
        }
      }
    },
    {
      "name": "thePopulatedScopeCountsItsPrincipal",
      "type": "assert",
      "actual": {
        "principals": "{scopedPrincipals}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "comparators": [
          {
            "path": "principals",
            "gte": 1
          }
        ]
      }
    },
    {
      "name": "theGlobalStateReadIsNotScoped",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/state",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "outputs": {
          "globalActiveGroups": "body.groups.activeGroups"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clients": {
            "totalPrincipals": "integer",
            "activeSessions": "integer"
          },
          "events": {
            "recentClientEvents": "integer",
            "recentGroupEvents": "integer"
          }
        }
      }
    },
    {
      "name": "theGlobalStateReadOmitsScopeAndSeesTheGroup",
      "type": "assert",
      "actual": {
        "scope": "{resultsByName.theGlobalStateReadIsNotScoped.0.actual.body.scope}",
        "activeGroups": "{globalActiveGroups}"
      },
      "expect": {
        "missingActualValue": "MISSING",
        "comparators": [
          {
            "path": "scope",
            "equals": "MISSING"
          },
          {
            "path": "activeGroups",
            "gte": 1
          }
        ]
      }
    },
    {
      "name": "theGlobalCrdtReadIsNotScoped",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/crdt",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "documents": {
            "total": "integer"
          },
          "storage": {
            "updates": "integer",
            "snapshots": "integer",
            "storedUpdateBytes": "integer"
          }
        }
      }
    },
    {
      "name": "theSystemReadAnswers",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "GET",
        "path": "/api/admin/operations/system",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "runtimeState": {
            "rows": "integer",
            "expiredRows": "integer"
          },
          "appData": {
            "rows": "integer",
            "expiredRows": "integer"
          },
          "stateEvents": {
            "clientEvents": "integer",
            "groupEvents": "integer"
          }
        }
      }
    },
    {
      "name": "crdtIntegrityOfAnAbsentDocumentIsCleanAndEmpty",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/integrity",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "document": {
            "applicationId": "{scopeApplicationId}",
            "workspaceId": "{scopeWorkspaceId}",
            "scope": "principal",
            "documentType": "checklist",
            "documentId": "adminops-absent-doc-{runId}",
            "principalId": "{adminClientId}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "valid": true,
          "checkedUpdateCount": 0,
          "documentKey": "string"
        }
      }
    },
    {
      "name": "crdtDebugExportRedactsByDefault",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/debug-export",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "document": {
            "applicationId": "{scopeApplicationId}",
            "workspaceId": "{scopeWorkspaceId}",
            "scope": "principal",
            "documentType": "checklist",
            "documentId": "adminops-absent-doc-{runId}",
            "principalId": "{adminClientId}"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "format": "rallar.crdt.debug-bundle.v1",
          "documentKey": "string",
          "reason": "api-v1-admin-operations-debug-export",
          "redaction": {
            "payloadsRedacted": true,
            "reason": "api-v1-admin-operations-redaction"
          }
        }
      }
    },
    {
      "name": "crdtDebugExportHonoursAnExplicitFalse",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/admin/operations/crdt/debug-export",
        "headers": {
          "Authorization": "{adminAuthHeader}",
          "x-client-id": "{adminClientId}"
        },
        "body": {
          "document": {
            "applicationId": "{scopeApplicationId}",
            "workspaceId": "{scopeWorkspaceId}",
            "scope": "principal",
            "documentType": "checklist",
            "documentId": "adminops-absent-doc-{runId}",
            "principalId": "{adminClientId}"
          },
          "redactPayloads": false,
          "reason": "adminops-explicit-reason-{runId}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "format": "rallar.crdt.debug-bundle.v1",
          "reason": "adminops-explicit-reason-{runId}",
          "redaction": {
            "payloadsRedacted": false
          }
        }
      }
    }
  ]
}
