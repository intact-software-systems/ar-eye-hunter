{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "https://api.example.com"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "room-1"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "realtime",
        "laneId": "realtime",
        "openTimeoutMs": 10000,
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{roomId}",
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "realtime",
        "laneId": "realtime",
        "openTimeoutMs": 10000,
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceSendsToBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "data": {
            "text": "hello bob"
          }
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.realtime.message",
          "data": {
            "text": "hello bob"
          }
        }
      }
    },
    {
      "name": "bobSendsToAlice",
      "type": "rtc.send",
      "connection": "bobRtc",
      "request": {
        "send": {
          "data": {
            "text": "hello alice"
          }
        }
      },
      "expect": {
        "connection": "aliceRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.realtime.message",
          "data": {
            "text": "hello alice"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
