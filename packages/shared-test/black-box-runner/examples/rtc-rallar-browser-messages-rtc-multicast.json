{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "charlieUsername": {
      "env": "RALLAR_CHARLIE_USERNAME",
      "default": "charlie"
    },
    "charliePassword": {
      "env": "RALLAR_CHARLIE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.room.multicast.message",
    "topicId": "black-box.room.multicast"
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "charlieRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "charlie",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{charlieUsername}",
        "password": "{charliePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "connectCharlie",
      "type": "rtc.connect",
      "connection": "charlieRtc"
    },
    {
      "name": "aliceMulticastsToRoom",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "contextId": "{applicationId}:{workspaceId}:{roomId}",
          "roomRef": {
            "applicationId": "{applicationId}",
            "workspaceId": "{workspaceId}",
            "groupId": "{roomId}"
          },
          "payload": {
            "from": "alice",
            "text": "hello room multicast"
          }
        },
        "output": "multicastSendStatus",
        "outputPath": "sendResult.status"
      }
    },
    {
      "name": "bobReceivesRoomMulticast",
      "type": "rtc.wait",
      "connection": "bobRtc",
      "request": {
        "outputs": {
          "bobMulticastPayload": "matchedMessage.data.data"
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "alice",
            "text": "hello room multicast"
          }
        }
      }
    },
    {
      "name": "charlieReceivesRoomMulticast",
      "type": "rtc.wait",
      "connection": "charlieRtc",
      "request": {
        "outputs": {
          "charlieMulticastPayload": "matchedMessage.data.data"
        }
      },
      "expect": {
        "connection": "charlieRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "alice",
            "text": "hello room multicast"
          }
        }
      }
    },
    {
      "name": "assertMulticastPayloadParity",
      "type": "assert",
      "actual": {
        "sendStatus": "{multicastSendStatus}",
        "bobPayload": "{bobMulticastPayload}",
        "charliePayload": "{charlieMulticastPayload}"
      },
      "expect": {
        "body": {
          "sendStatus": "sent",
          "bobPayload": {
            "from": "alice",
            "text": "hello room multicast"
          },
          "charliePayload": {
            "from": "alice",
            "text": "hello room multicast"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    },
    {
      "name": "closeCharlie",
      "type": "rtc.close",
      "connection": "charlieRtc"
    }
  ]
}
