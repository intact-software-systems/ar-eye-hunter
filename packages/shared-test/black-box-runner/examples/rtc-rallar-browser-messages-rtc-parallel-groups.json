{
  "variables": {
    "rtcProvider": {
      "env": "RALLAR_BB_RTC_PROVIDER",
      "default": "rallar-browser"
    },
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "controlBaseUrl": {
      "env": "RALLAR_BLACK_BOX_CONTROL_BASE_URL",
      "default": "http://localhost:5180"
    },
    "controlRunId": {
      "env": "RALLAR_BLACK_BOX_RUN_ID",
      "default": "remote-browser-live-parallel"
    },
    "controlAgentId": {
      "env": "RALLAR_BLACK_BOX_AGENT_ID",
      "default": "visible-agent-local"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "roomId": {
      "env": "RALLAR_BB_PARALLEL_GROUP_ID",
      "default": "bb-live-parallel-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.live.parallel.message",
    "topicId": "black-box.live.parallel"
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "parallelRtcTraffic",
      "type": "parallel",
      "maxConcurrency": 2,
      "timeoutMs": 30000,
      "groups": [
        {
          "name": "alice-to-bob",
          "steps": [
            {
              "name": "aliceSendsParallelToBob",
              "type": "rtc.send",
              "connection": "aliceRtc",
              "request": {
                "send": {
                  "typeId": "{messageTypeId}",
                  "topicId": "{topicId}",
                  "contextId": "{applicationId}:{workspaceId}:{roomId}",
                  "roomRef": {
                    "applicationId": "{applicationId}",
                    "workspaceId": "{workspaceId}",
                    "groupId": "{roomId}"
                  },
                  "payload": {
                    "from": "alice",
                    "to": "bob",
                    "flow": "live-parallel",
                    "text": "parallel hello from alice"
                  }
                }
              },
              "expect": {
                "connection": "bobRtc",
                "withinMs": 12000,
                "consume": true,
                "message": {
                  "kind": "message",
                  "topic": "rallar.browser.messages.rtc.message",
                  "typeId": "{messageTypeId}",
                  "topicId": "{topicId}",
                  "data": {
                    "from": "alice",
                    "to": "bob",
                    "flow": "live-parallel",
                    "text": "parallel hello from alice"
                  }
                }
              }
            }
          ]
        },
        {
          "name": "bob-to-alice",
          "steps": [
            {
              "name": "bobSendsParallelToAlice",
              "type": "rtc.send",
              "connection": "bobRtc",
              "request": {
                "send": {
                  "typeId": "{messageTypeId}",
                  "topicId": "{topicId}",
                  "contextId": "{applicationId}:{workspaceId}:{roomId}",
                  "roomRef": {
                    "applicationId": "{applicationId}",
                    "workspaceId": "{workspaceId}",
                    "groupId": "{roomId}"
                  },
                  "payload": {
                    "from": "bob",
                    "to": "alice",
                    "flow": "live-parallel",
                    "text": "parallel hello from bob"
                  }
                }
              },
              "expect": {
                "connection": "aliceRtc",
                "withinMs": 12000,
                "consume": true,
                "message": {
                  "kind": "message",
                  "topic": "rallar.browser.messages.rtc.message",
                  "typeId": "{messageTypeId}",
                  "topicId": "{topicId}",
                  "data": {
                    "from": "bob",
                    "to": "alice",
                    "flow": "live-parallel",
                    "text": "parallel hello from bob"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "parallelClose",
      "type": "parallel",
      "maxConcurrency": 2,
      "groups": [
        {
          "name": "close-alice",
          "steps": [
            {
              "name": "closeAlice",
              "type": "rtc.close",
              "connection": "aliceRtc"
            }
          ]
        },
        {
          "name": "close-bob",
          "steps": [
            {
              "name": "closeBob",
              "type": "rtc.close",
              "connection": "bobRtc"
            }
          ]
        }
      ]
    }
  ]
}
