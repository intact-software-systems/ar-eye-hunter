{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    }
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "realtime",
        "laneId": "realtime",
        "openTimeoutMs": 10000,
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc",
      "outputs": {
        "connectLatencyMs": "actual.connectLatencyMs"
      }
    },
    {
      "name": "waitForProviderConnectedDiagnostic",
      "type": "rtc.wait",
      "connection": "aliceRtc",
      "expect": {
        "withinMs": 1000,
        "diagnostic": {
          "topic": "rallar.browser.provider.connected",
          "data": {
            "connectDiagnostics": {
              "status": "connected",
              "connection": "aliceRtc"
            }
          }
        }
      }
    },
    {
      "name": "waitForConnectedHealth",
      "type": "rtc.wait",
      "connection": "aliceRtc",
      "expect": {
        "withinMs": 1000,
        "health": {
          "connect": {
            "status": "connected",
            "connection": "aliceRtc"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    }
  ]
}
