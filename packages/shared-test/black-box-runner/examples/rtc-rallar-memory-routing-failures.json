{
  "execution": {
    "failFast": false
  },
  "variables": {
    "roomId": "bb-memory-failure-room"
  },
  "connections": {
    "soloRtc": {
      "type": "rtc",
      "provider": "rallar-memory",
      "actor": "solo",
      "peerId": "solo",
      "roomId": "{roomId}"
    },
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-memory",
      "actor": "alice",
      "peerId": "alice",
      "roomId": "{roomId}",
      "remotePeerId": "bob"
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-memory",
      "actor": "bob",
      "peerId": "bob",
      "roomId": "{roomId}",
      "remotePeerId": "alice"
    }
  },
  "steps": [
    {
      "name": "connectSolo",
      "type": "rtc.connect",
      "connection": "soloRtc"
    },
    {
      "name": "soloBroadcastsToEmptyRoom",
      "type": "rtc.send",
      "connection": "soloRtc",
      "request": {
        "send": {
          "topic": "black-box.delivery.broadcast",
          "broadcast": true,
          "payload": {
            "text": "there are no recipients"
          }
        }
      }
    },
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    },
    {
      "name": "aliceSendsToClosedBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "topic": "black-box.delivery.direct",
          "toPeerId": "bob",
          "payload": {
            "text": "bob is closed"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "aliceSendsAfterClose",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "topic": "black-box.delivery.closed",
          "payload": {
            "text": "alice transport is closed"
          }
        }
      }
    },
    {
      "name": "closeSolo",
      "type": "rtc.close",
      "connection": "soloRtc"
    }
  ]
}
