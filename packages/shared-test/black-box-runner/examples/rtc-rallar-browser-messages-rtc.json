{
  "variables": {
    "rallarApiBaseUrl": "https://api.example.com",
    "roomId": "room-1",
    "aliceUsername": "alice",
    "alicePassword": "secret",
    "bobUsername": "bob",
    "bobPassword": "secret",
    "messageTypeId": "black-box.chat.message",
    "topicId": "black-box.chat"
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{roomId}",
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceSendsToBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "payload": {
            "from": "alice",
            "to": "bob",
            "text": "hello bob"
          }
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "alice",
            "to": "bob",
            "text": "hello bob"
          }
        }
      }
    },
    {
      "name": "bobSendsToAlice",
      "type": "rtc.send",
      "connection": "bobRtc",
      "request": {
        "send": {
          "payload": {
            "from": "bob",
            "to": "alice",
            "text": "hello alice"
          }
        }
      },
      "expect": {
        "connection": "aliceRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "bob",
            "to": "alice",
            "text": "hello alice"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
