{
  "variables": {
    "rtcProvider": {
      "env": "RALLAR_BB_RTC_PROVIDER",
      "default": "rallar-browser"
    },
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "controlBaseUrl": {
      "env": "RALLAR_BLACK_BOX_CONTROL_BASE_URL",
      "default": "http://localhost:5180"
    },
    "controlRunId": {
      "env": "RALLAR_BLACK_BOX_RUN_ID",
      "default": "remote-browser-live-traffic"
    },
    "controlAgentId": {
      "env": "RALLAR_BLACK_BOX_AGENT_ID",
      "default": "visible-agent-local"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "roomId": {
      "env": "RALLAR_BB_TRAFFIC_GROUP_ID",
      "default": "bb-live-traffic-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.live.traffic.message",
    "topicId": "black-box.live.traffic"
  },
  "execution": {
    "failFast": true,
    "trafficPlan": {
      "seed": 17017,
      "count": 4,
      "delayMs": 25,
      "setupSteps": [
        "connectAlice",
        "connectBob"
      ],
      "cleanupSteps": [
        "closeAlice",
        "closeBob"
      ],
      "operations": [
        {
          "name": "alice-to-bob",
          "weight": 2,
          "steps": [
            "aliceTrafficToBob"
          ]
        },
        {
          "name": "bob-to-alice",
          "weight": 1,
          "steps": [
            "bobTrafficToAlice"
          ]
        }
      ]
    }
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceTrafficToBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "from": "alice",
            "to": "bob",
            "text": "live traffic {traffic.sequence} from alice"
          }
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 12000,
        "consume": true,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "black-box.live.traffic.message",
          "topicId": "black-box.live.traffic",
          "data": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "from": "alice",
            "to": "bob",
            "text": "live traffic {traffic.sequence} from alice"
          }
        }
      }
    },
    {
      "name": "bobTrafficToAlice",
      "type": "rtc.send",
      "connection": "bobRtc",
      "request": {
        "send": {
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "from": "bob",
            "to": "alice",
            "text": "live traffic {traffic.sequence} from bob"
          }
        }
      },
      "expect": {
        "connection": "aliceRtc",
        "withinMs": 12000,
        "consume": true,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "black-box.live.traffic.message",
          "topicId": "black-box.live.traffic",
          "data": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "from": "bob",
            "to": "alice",
            "text": "live traffic {traffic.sequence} from bob"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
