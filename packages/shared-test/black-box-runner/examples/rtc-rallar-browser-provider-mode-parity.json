{
  "variables": {
    "rtcProvider": {
      "env": "RALLAR_BB_RTC_PROVIDER",
      "default": "rallar-browser"
    },
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "controlBaseUrl": {
      "env": "RALLAR_BLACK_BOX_CONTROL_BASE_URL",
      "default": "http://localhost:5180"
    },
    "controlRunId": {
      "env": "RALLAR_BLACK_BOX_RUN_ID",
      "default": "remote-browser-run"
    },
    "controlAgentId": {
      "env": "RALLAR_BLACK_BOX_AGENT_ID",
      "default": "visible-agent-local"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.provider-mode.parity",
    "topicId": "black-box.provider-mode"
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "{rtcProvider}",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "control": {
        "baseUrl": "{controlBaseUrl}",
        "runId": "{controlRunId}",
        "agentId": "{controlAgentId}",
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceSendsToBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "contextId": "{applicationId}:{workspaceId}:{roomId}",
          "roomRef": {
            "applicationId": "{applicationId}",
            "workspaceId": "{workspaceId}",
            "groupId": "{roomId}"
          },
          "payload": {
            "from": "alice",
            "text": "provider mode parity"
          }
        },
        "outputs": {
          "providerModeSendStatus": "sendResult.status",
          "providerModePayload": "matchedMessage.data.data"
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "alice",
            "text": "provider mode parity"
          }
        }
      }
    },
    {
      "name": "assertProviderModePayload",
      "type": "assert",
      "actual": {
        "sendStatus": "{providerModeSendStatus}",
        "payload": "{providerModePayload}"
      },
      "expect": {
        "body": {
          "sendStatus": "sent",
          "payload": {
            "from": "alice",
            "text": "provider mode parity"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
