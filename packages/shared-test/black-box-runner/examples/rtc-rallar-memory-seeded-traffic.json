{
  "variables": {
    "roomId": "bb-memory-seeded-traffic-room"
  },
  "execution": {
    "failFast": true,
    "trafficPlan": {
      "seed": 1337,
      "count": 6,
      "setupSteps": [
        "connectAlice",
        "connectBob"
      ],
      "cleanupSteps": [
        "closeAlice",
        "closeBob"
      ],
      "operations": [
        {
          "name": "alice-to-bob",
          "weight": 2,
          "steps": [
            "aliceTrafficToBob"
          ]
        },
        {
          "name": "bob-to-alice",
          "weight": 1,
          "steps": [
            "bobTrafficToAlice"
          ]
        }
      ]
    }
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-memory",
      "actor": "alice",
      "peerId": "alice",
      "roomId": "{roomId}",
      "remotePeerId": "bob"
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-memory",
      "actor": "bob",
      "peerId": "bob",
      "roomId": "{roomId}",
      "remotePeerId": "alice"
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceTrafficToBob",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "topic": "black-box.traffic.{traffic.operation}",
          "toPeerId": "bob",
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "text": "traffic {traffic.sequence} from alice"
          }
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 1000,
        "consume": true,
        "message": {
          "topic": "black-box.traffic.{traffic.operation}",
          "toPeerId": "bob",
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "text": "traffic {traffic.sequence} from alice"
          }
        }
      }
    },
    {
      "name": "bobTrafficToAlice",
      "type": "rtc.send",
      "connection": "bobRtc",
      "request": {
        "send": {
          "topic": "black-box.traffic.{traffic.operation}",
          "toPeerId": "alice",
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "text": "traffic {traffic.sequence} from bob"
          }
        }
      },
      "expect": {
        "connection": "aliceRtc",
        "withinMs": 1000,
        "consume": true,
        "message": {
          "topic": "black-box.traffic.{traffic.operation}",
          "toPeerId": "alice",
          "payload": {
            "sequence": "{traffic.sequence}",
            "operation": "{traffic.operation}",
            "randomInt": "{traffic.randomInt}",
            "text": "traffic {traffic.sequence} from bob"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
