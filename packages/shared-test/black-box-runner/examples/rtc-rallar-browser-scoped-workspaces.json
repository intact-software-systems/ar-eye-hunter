{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceA": {
      "env": "RALLAR_BB_WORKSPACE_A",
      "default": "workspace-a"
    },
    "workspaceB": {
      "env": "RALLAR_BB_WORKSPACE_B",
      "default": "workspace-b"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "charlieUsername": {
      "env": "RALLAR_CHARLIE_USERNAME",
      "default": "charlie"
    },
    "charliePassword": {
      "env": "RALLAR_CHARLIE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.scoped.chat.message",
    "topicId": "black-box.scoped.chat"
  },
  "connections": {
    "aliceWorkspaceA": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceA}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceA}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobWorkspaceA": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceA}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceA}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "charlieWorkspaceB": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "charlie",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceB}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{charlieUsername}",
        "password": "{charliePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceB}:{roomId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "connectAliceWorkspaceA",
      "type": "rtc.connect",
      "connection": "aliceWorkspaceA"
    },
    {
      "name": "connectBobWorkspaceA",
      "type": "rtc.connect",
      "connection": "bobWorkspaceA"
    },
    {
      "name": "connectCharlieWorkspaceB",
      "type": "rtc.connect",
      "connection": "charlieWorkspaceB"
    },
    {
      "name": "aliceWorkspaceASendsToBobWorkspaceA",
      "type": "rtc.send",
      "connection": "aliceWorkspaceA",
      "request": {
        "roomRef": {
          "applicationId": "{applicationId}",
          "workspaceId": "{workspaceA}",
          "groupId": "{roomId}"
        },
        "send": {
          "payload": {
            "from": "alice",
            "workspaceId": "{workspaceA}",
            "text": "hello workspace a"
          }
        }
      },
      "expect": {
        "connection": "bobWorkspaceA",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "from": "alice",
            "workspaceId": "{workspaceA}",
            "text": "hello workspace a"
          }
        }
      }
    },
    {
      "name": "closeAliceWorkspaceA",
      "type": "rtc.close",
      "connection": "aliceWorkspaceA"
    },
    {
      "name": "closeBobWorkspaceA",
      "type": "rtc.close",
      "connection": "bobWorkspaceA"
    },
    {
      "name": "closeCharlieWorkspaceB",
      "type": "rtc.close",
      "connection": "charlieWorkspaceB"
    }
  ]
}
