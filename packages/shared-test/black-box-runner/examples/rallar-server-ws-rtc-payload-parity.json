{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "rallarWsBaseUrl": {
      "env": "RALLAR_WS_BASE_URL",
      "default": "ws://localhost:8080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "groupId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "groupName": {
      "env": "RALLAR_BB_GROUP_NAME",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.parity.message",
    "topicId": "room.black-box.parity",
    "parityPayload": "same-payload-over-ws-and-rtc"
  },
  "connections": {
    "api": {
      "type": "http",
      "baseUrl": "{rallarApiBaseUrl}",
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 10000
    },
    "rallarWs": {
      "type": "ws",
      "timeoutMs": 10000
    },
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{groupId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{groupId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{groupId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{groupId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{groupId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{groupId}",
        "timeoutMs": 15000
      }
    }
  },
  "steps": [
    {
      "name": "createParityRunId",
      "type": "set",
      "output": "parityRunId",
      "transform": {
        "uuid": true
      }
    },
    {
      "name": "loginAliceForWebSocket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/login/requests/bb-login-alice-for-web-socket-001-0001-{parityRunId}",
        "body": {
          "username": "{aliceUsername}",
          "password": "{alicePassword}"
        },
        "outputs": {
          "aliceClientId": "body.clientId",
          "aliceAccessToken": {
            "path": "body.accessToken",
            "secret": true
          },
          "aliceSessionId": "body.sessionId"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "clientId": "string",
          "accessToken": "string",
          "sessionId": "string"
        }
      }
    },
    {
      "name": "deriveAliceAuthHeader",
      "type": "set",
      "output": "aliceAuthHeader",
      "value": "Bearer {aliceAccessToken}",
      "secret": true
    },
    {
      "name": "createGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/requests/bb-request-parity-create-scope-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "groupId": "{groupId}",
          "displayName": "{groupName}",
          "kind": "room",
          "joinMode": "open",
          "createdByPrincipalId": "{aliceClientId}"
        }
      },
      "expect": {
        "statusCode": [
          201,
          409
        ]
      }
    },
    {
      "name": "joinAliceToGroup",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/members/{aliceClientId}/requests/parity-join-scope-scope-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectAlicePresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "PUT",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/requests/parity-presence-scope-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "principalId": "{aliceClientId}",
          "generationId": "parity-generation-{aliceSessionId}",
          "publicationKey": null,
          "connectionGenerationId": "parity-connection-generation-{aliceSessionId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "createWebSocketTicket",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/ws-ticket/requests/bb-create-web-socket-ticket-005-0001-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "outputs": {
          "wsTicket": {
            "path": "body.ticket",
            "secret": true
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "deriveWebSocketUrl",
      "type": "set",
      "output": "wsUrl",
      "value": "{rallarWsBaseUrl}/api/ws/{aliceSessionId}?ticket={wsTicket}&applicationId={applicationId}&workspaceId={workspaceId}",
      "secret": true
    },
    {
      "name": "openWebSocket",
      "type": "ws.open",
      "connection": "rallarWs",
      "request": {
        "url": "{wsUrl}",
        "timeoutMs": 10000
      }
    },
    {
      "name": "connectBobRtc",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "encodeWebSocketPayload",
      "type": "set",
      "output": "wsPayloadJson",
      "transform": {
        "jsonStringify": {
          "path": "variables.parityPayload"
        }
      }
    },
    {
      "name": "sendPayloadOverWebSocket",
      "type": "ws.send",
      "connection": "rallarWs",
      "request": {
        "send": {
          "id": {
            "v": 4,
            "msgId": "bb-parity-ws-{aliceSessionId}",
            "ts": 0,
            "senderId": "{aliceSessionId}",
            "sessionId": "{aliceSessionId}",
            "traceId": "bb-parity"
          },
          "route": {
            "topicId": "{topicId}",
            "resourceId": "bb-parity-{aliceSessionId}",
            "contextId": "{applicationId}:{workspaceId}:{groupId}"
          },
          "targets": {
            "mode": "broadcast",
            "scope": "room",
            "groupRef": {
              "applicationId": "{applicationId}",
              "workspaceId": "{workspaceId}",
              "groupId": "{groupId}"
            },
            "exceptPeerIds": [
              "{aliceSessionId}"
            ]
          },
          "delivery": {
            "reliability": "at-least-once",
            "ack": "receiver"
          },
          "payload": {
            "typeId": "{messageTypeId}",
            "contentType": "application/json",
            "resource": "{wsPayloadJson}"
          }
        }
      }
    },
    {
      "name": "bobReceivesWebSocketPayload",
      "type": "rtc.wait",
      "connection": "bobRtc",
      "request": {
        "output": "wsParityPayload",
        "outputPath": "matchedMessage.data.data.payload"
      },
      "expect": {
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.ws.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "payload": "{parityPayload}",
            "msgId": "bb-parity-ws-{aliceSessionId}"
          }
        }
      }
    },
    {
      "name": "closeWebSocket",
      "type": "ws.close",
      "connection": "rallarWs",
      "request": {
        "code": 1000,
        "reason": "black-box recipe done"
      }
    },
    {
      "name": "disconnectAlicePresence",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/state/apps/{applicationId}/workspaces/{workspaceId}/groups/{groupId}/sessions/{aliceSessionId}/disconnect/requests/parity-disconnect-scope-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        },
        "body": {
          "principalId": "{aliceClientId}",
          "generationId": "parity-generation-{aliceSessionId}"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "connectAliceRtc",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "waitForAliceRtcRoomOpen",
      "type": "rtc.wait",
      "connection": "aliceRtc",
      "expect": {
        "withinMs": 15000,
        "diagnostic": {
          "topic": "rallar.browser.formation.room-status",
          "data": {
            "room": {
              "state": "open"
            }
          }
        }
      }
    },
    {
      "name": "waitForBobRtcRoomOpen",
      "type": "rtc.wait",
      "connection": "bobRtc",
      "expect": {
        "withinMs": 15000,
        "diagnostic": {
          "topic": "rallar.browser.formation.room-status",
          "data": {
            "room": {
              "state": "open"
            }
          }
        }
      }
    },
    {
      "name": "sendPayloadOverRtc",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "contextId": "{applicationId}:{workspaceId}:{groupId}",
          "roomRef": {
            "applicationId": "{applicationId}",
            "workspaceId": "{workspaceId}",
            "groupId": "{groupId}"
          },
          "payload": "{parityPayload}"
        },
        "outputs": {
          "rtcParityPayload": "matchedMessage.data.data.payload"
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 10000,
        "message": {
          "kind": "message",
          "topic": "rallar.browser.messages.rtc.message",
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "data": {
            "payload": "{parityPayload}"
          }
        }
      }
    },
    {
      "name": "assertWsRtcPayloadParity",
      "type": "assert",
      "actual": {
        "wsPayload": "{wsParityPayload}",
        "rtcPayload": "{rtcParityPayload}"
      },
      "expect": {
        "body": {
          "wsPayload": "{parityPayload}",
          "rtcPayload": "{parityPayload}"
        }
      }
    },
    {
      "name": "closeAliceRtc",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBobRtc",
      "type": "rtc.close",
      "connection": "bobRtc"
    },
    {
      "name": "logoutAlice",
      "type": "http",
      "connection": "api",
      "request": {
        "method": "POST",
        "path": "/api/auth/logout/requests/bb-logout-alice-007-0001-{parityRunId}",
        "headers": {
          "Authorization": "{aliceAuthHeader}",
          "x-client-id": "{aliceClientId}"
        }
      },
      "expect": {
        "status": 200
      }
    }
  ]
}
