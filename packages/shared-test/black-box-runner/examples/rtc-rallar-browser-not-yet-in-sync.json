{
  "variables": {
    "rallarApiBaseUrl": {
      "env": "RALLAR_API_BASE_URL",
      "default": "http://localhost:8080"
    },
    "applicationId": {
      "env": "RALLAR_BB_APPLICATION_ID",
      "default": "black-box-app"
    },
    "workspaceId": {
      "env": "RALLAR_BB_WORKSPACE_ID",
      "default": "default"
    },
    "roomId": {
      "env": "RALLAR_BB_GROUP_ID",
      "default": "bb-group"
    },
    "aliceUsername": {
      "env": "RALLAR_ALICE_USERNAME",
      "default": "alice"
    },
    "alicePassword": {
      "env": "RALLAR_ALICE_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "bobUsername": {
      "env": "RALLAR_BOB_USERNAME",
      "default": "bob"
    },
    "bobPassword": {
      "env": "RALLAR_BOB_PASSWORD",
      "default": "secret",
      "secret": true
    },
    "messageTypeId": "black-box.stale-state.message",
    "topicId": "black-box.stale-state",
    "futureSnapshotVersion": 999999
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "alice",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{aliceUsername}",
        "password": "{alicePassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "contextId": "{applicationId}:{workspaceId}:{roomId}",
        "timeoutMs": 15000
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar-browser",
      "actor": "bob",
      "roomId": "{roomId}",
      "roomRef": {
        "applicationId": "{applicationId}",
        "workspaceId": "{workspaceId}",
        "groupId": "{roomId}"
      },
      "browser": {
        "headless": true,
        "timeoutMs": 15000
      },
      "rallar": {
        "apiBaseUrl": "{rallarApiBaseUrl}",
        "username": "{bobUsername}",
        "password": "{bobPassword}",
        "transport": "messages.rtc",
        "typeId": "{messageTypeId}",
        "topicId": "{topicId}",
        "timeoutMs": 15000,
        "almDiagnostics": true
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "waitForAliceRtcRoomOpen",
      "type": "rtc.wait",
      "connection": "aliceRtc",
      "expect": {
        "withinMs": 15000,
        "diagnostic": {
          "topic": "rallar.browser.formation.room-status",
          "data": {
            "room": {
              "state": "open"
            }
          }
        }
      }
    },
    {
      "name": "waitForBobRtcRoomOpen",
      "type": "rtc.wait",
      "connection": "bobRtc",
      "expect": {
        "withinMs": 15000,
        "diagnostic": {
          "topic": "rallar.browser.formation.room-status",
          "data": {
            "room": {
              "state": "open"
            }
          }
        }
      }
    },
    {
      "name": "aliceSendsWithFutureSnapshot",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "roomRef": {
          "applicationId": "{applicationId}",
          "workspaceId": "{workspaceId}",
          "groupId": "{roomId}"
        },
        "minSnapshotVersion": "{futureSnapshotVersion}",
        "send": {
          "typeId": "{messageTypeId}",
          "topicId": "{topicId}",
          "payload": {
            "from": "alice",
            "text": "this send requires a future group snapshot"
          }
        },
        "output": "futureMessageId",
        "outputPath": "sendResult.message.handleId"
      }
    },
    {
      "name": "bobRejectsFutureSnapshot",
      "type": "rtc.wait",
      "connection": "bobRtc",
      "expect": {
        "withinMs": 10000,
        "diagnostic": {
          "topic": "rallar.browser.alm.inbound_diagnostics",
          "data": {
            "kind": "admission-outcome",
            "msgId": "{futureMessageId}",
            "typeId": "{messageTypeId}",
            "carrier": "rtc",
            "outcome": "rejected"
          }
        }
      },
      "request": {
        "output": "snapshotRejectionReason",
        "outputPath": "matchedDiagnostic.data.reason"
      }
    },
    {
      "name": "assertSnapshotFenceReason",
      "type": "assert",
      "actual": {
        "reason": "{snapshotRejectionReason}"
      },
      "expect": {
        "comparators": [
          {
            "path": "reason",
            "matches": "^not-yet-in-sync:"
          }
        ]
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}
