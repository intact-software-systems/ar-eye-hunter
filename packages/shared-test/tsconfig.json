{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    // pglite 0.4.1 ships broken Emscripten .d.ts; reconcile with root's 0.5.4 in a later task
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-test/*": [
        "../../packages/shared-test/*"
      ],
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.d.ts",
    "../../types/**/*.d.ts"
  ]
}
