{
  "name": "@ar-eye-hunter/shared-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bb:api-v1:recipes": "bun run black-box-runner/api-v1-black-box-run.mts --recipes-only --artifact-dir=../../.artifacts/api-v1-black-box/recipes",
    "bb:api-v1:postgres": "RALLAR_CRDT_DOCUMENT_TYPE_POLICIES_JSON='[{\"documentType\":\"black-box-map\",\"rollout\":\"production\"}]' bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --artifact-dir=../../.artifacts/api-v1-black-box/postgres",
    "bb:api-v1:postgres:crdt": "RALLAR_CRDT_DOCUMENT_TYPE_POLICIES_JSON='[{\"documentType\":\"black-box-map\",\"rollout\":\"production\"}]' bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-crdt --artifact-dir=../../tmp/api-v1-black-box/postgres-crdt",
    "bb:api-v1:postgres:crdt-append-history": "RALLAR_CRDT_DOCUMENT_TYPE_POLICIES_JSON='[{\"documentType\":\"black-box-map\",\"rollout\":\"production\"}]' bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-crdt-append-history --artifact-dir=${RALLAR_CRDT_APPEND_HISTORY_ARTIFACT_DIR:-../../tmp/perf/crdt-append-history/current}",
    "bb:api-v1:postgres:medium-scale": "bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-medium-scale --artifact-dir=../../tmp/api-v1-black-box/postgres-medium-scale",
    "bb:api-v1:postgres:formation-large": "bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-formation-large --artifact-dir=../../tmp/api-v1-black-box/postgres-formation-large",
    "bb:api-v1:postgres:topology-replay": "bun run black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --profile=api-v1-black-box-topology-replay --artifact-dir=../../tmp/api-v1-black-box/postgres-topology-replay",
    "bb:api-v1:postgres:group-delta": "bun run black-box-runner/cluster-proofs/api-v1-group-delta-cluster-proof.mts --backend=postgres --port=18480 --secondary-port=18481 --tertiary-port=18482 --artifact-dir=../../tmp/api-v1-black-box/postgres-group-delta",
    "bb:api-v1:postgres:auth-logout": "bun run black-box-runner/cluster-proofs/api-v1-auth-logout-cluster-proof.mts --backend=postgres --port=18580 --secondary-port=18581 --tertiary-port=18582 --artifact-dir=../../tmp/api-v1-black-box/postgres-auth-logout",
    "bb:api-v1:memory": "bun run black-box-runner/api-v1-black-box-run.mts --backend=pglite-memory --artifact-dir=../../.artifacts/api-v1-black-box/memory",
    "bb:matrix:deterministic": "bun run black-box-runner/recipe-matrix.mts --profile=deterministic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/deterministic",
    "bb:matrix:dry": "bun run black-box-runner/recipe-matrix.mts --profile=dry --artifact-dir=../../.artifacts/shared-test/recipe-matrix/dry",
    "bb:matrix:list": "bun run black-box-runner/recipe-matrix.mts --list",
    "bb:matrix:live": "bun run black-box-runner/recipe-matrix.mts --profile=live --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live",
    "bb:matrix:live:parallel": "bun run black-box-runner/recipe-matrix.mts --profile=live-parallel --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-parallel",
    "bb:matrix:live:preflight": "bun run black-box-runner/recipe-matrix.mts --profile=live --preflight-only --require-gates --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-preflight",
    "bb:matrix:live:soak": "bun run black-box-runner/recipe-matrix.mts --profile=live-soak --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-soak",
    "bb:matrix:live:strict": "bun run black-box-runner/recipe-matrix.mts --profile=live --require-gates --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live",
    "bb:matrix:live:traffic": "bun run black-box-runner/recipe-matrix.mts --profile=live-traffic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-traffic",
    "bb:matrix:parallel": "bun run black-box-runner/recipe-matrix.mts --profile=parallel --artifact-dir=../../.artifacts/shared-test/recipe-matrix/parallel",
    "bb:matrix:quick": "bun run black-box-runner/recipe-matrix.mts --profile=quick --artifact-dir=../../.artifacts/shared-test/recipe-matrix/quick",
    "bb:matrix:soak": "bun run black-box-runner/recipe-matrix.mts --profile=soak --artifact-dir=../../.artifacts/shared-test/recipe-matrix/soak",
    "bb:matrix:traffic": "bun run black-box-runner/recipe-matrix.mts --profile=traffic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/traffic",
    "bb:browser:validate:dry": "bun run black-box-runner/rallar-browser-live-validation.mts --mode=dry-run --transport=both --record-dir=../../.artifacts/rallar-browser-rtc",
    "bb:browser:validate:live": "bun run black-box-runner/rallar-browser-live-validation.mts --mode=live --transport=both --record-dir=../../.artifacts/rallar-browser-rtc",
    "bb:dry:provider-parity": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-browser-provider-mode-parity.json --dry-run --artifact-dir=../../.artifacts/shared-test/provider-mode-parity-dry",
    "bb:memory:delivery": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-delivery-semantics.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-delivery",
    "bb:memory:parallel": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-parallel-groups.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-parallel",
    "bb:memory:scale": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-delivery-semantics.json --iterations=3 --artifact-dir=../../.artifacts/shared-test/rallar-memory-scale",
    "bb:memory:soak": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-same-connection-soak.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-soak",
    "bb:memory:traffic": "bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-seeded-traffic.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-traffic",
    "bb:remote:provider-parity:dry": "RALLAR_BB_RTC_PROVIDER=rallar-remote-browser bun run black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-browser-provider-mode-parity.json --dry-run --artifact-dir=../../.artifacts/shared-test/provider-mode-parity-remote-dry",
    "build": "npm run check:ts",
    "check": "npm run check:ts",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run check:ts",
    "rtc:browser:validate": "bun run black-box-runner/rallar-browser-live-validation.mts",
    "typecheck": "npm run check:ts",
    "bb:api-v1:postgres:view-push": "bun run black-box-runner/cluster-proofs/api-v1-view-push-cluster-proof.mts --backend=postgres --port=18680 --secondary-port=18681 --tertiary-port=18682 --artifact-dir=../../tmp/api-v1-black-box/postgres-view-push",
    "bb:api-v1:postgres:ordering": "bun run black-box-runner/cluster-proofs/api-v1-ordering-cluster-proof.mts --backend=postgres --port=18780 --secondary-port=18781 --tertiary-port=18782 --artifact-dir=../../tmp/api-v1-black-box/postgres-ordering"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  }
}
