{
  "name": "@ar-eye-hunter/shared-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bb:api-v1:recipes": "deno run -A black-box-runner/api-v1-black-box-run.mts --recipes-only --artifact-dir=../../.artifacts/api-v1-black-box/recipes",
    "bb:api-v1:postgres": "RALLAR_CRDT_DOCUMENT_TYPE_POLICIES_JSON='[{\"documentType\":\"black-box-map\",\"rollout\":\"production\"}]' deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --artifact-dir=../../.artifacts/api-v1-black-box/postgres",
    "bb:api-v1:postgres:crdt": "RALLAR_CRDT_DOCUMENT_TYPE_POLICIES_JSON='[{\"documentType\":\"black-box-map\",\"rollout\":\"production\"}]' deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-crdt --artifact-dir=../../tmp/api-v1-black-box/postgres-crdt",
    "bb:api-v1:postgres:medium-scale": "deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-medium-scale --artifact-dir=../../tmp/api-v1-black-box/postgres-medium-scale",
    "bb:api-v1:postgres:formation-large": "deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-formation-large --artifact-dir=../../tmp/api-v1-black-box/postgres-formation-large",
    "bb:api-v1:postgres:delta-primary": "RALLAR_GROUP_STATE_DISSEMINATION=delta-primary deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --cluster-only --cluster-profile=api-v1-black-box-delta-primary --artifact-dir=../../tmp/api-v1-black-box/postgres-delta-primary",
    "bb:api-v1:postgres:topology-replay": "deno run -A black-box-runner/api-v1-black-box-run.mts --backend=postgres --secondary-port=18081 --tertiary-port=18082 --profile=api-v1-black-box-topology-replay --artifact-dir=../../tmp/api-v1-black-box/postgres-topology-replay",
    "bb:api-v1:memory": "deno run -A black-box-runner/api-v1-black-box-run.mts --backend=pglite-memory --artifact-dir=../../.artifacts/api-v1-black-box/memory",
    "bb:matrix:deterministic": "deno run -A black-box-runner/recipe-matrix.mts --profile=deterministic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/deterministic",
    "bb:matrix:dry": "deno run -A black-box-runner/recipe-matrix.mts --profile=dry --artifact-dir=../../.artifacts/shared-test/recipe-matrix/dry",
    "bb:matrix:list": "deno run -A black-box-runner/recipe-matrix.mts --list",
    "bb:matrix:live": "deno run -A black-box-runner/recipe-matrix.mts --profile=live --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live",
    "bb:matrix:live:parallel": "deno run -A black-box-runner/recipe-matrix.mts --profile=live-parallel --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-parallel",
    "bb:matrix:live:preflight": "deno run -A black-box-runner/recipe-matrix.mts --profile=live --preflight-only --require-gates --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-preflight",
    "bb:matrix:live:soak": "deno run -A black-box-runner/recipe-matrix.mts --profile=live-soak --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-soak",
    "bb:matrix:live:strict": "deno run -A black-box-runner/recipe-matrix.mts --profile=live --require-gates --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live",
    "bb:matrix:live:traffic": "deno run -A black-box-runner/recipe-matrix.mts --profile=live-traffic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/live-traffic",
    "bb:matrix:parallel": "deno run -A black-box-runner/recipe-matrix.mts --profile=parallel --artifact-dir=../../.artifacts/shared-test/recipe-matrix/parallel",
    "bb:matrix:quick": "deno run -A black-box-runner/recipe-matrix.mts --profile=quick --artifact-dir=../../.artifacts/shared-test/recipe-matrix/quick",
    "bb:matrix:soak": "deno run -A black-box-runner/recipe-matrix.mts --profile=soak --artifact-dir=../../.artifacts/shared-test/recipe-matrix/soak",
    "bb:matrix:traffic": "deno run -A black-box-runner/recipe-matrix.mts --profile=traffic --artifact-dir=../../.artifacts/shared-test/recipe-matrix/traffic",
    "bb:browser:validate:dry": "deno run -A black-box-runner/rallar-browser-live-validation.mts --mode=dry-run --transport=both --record-dir=../../.artifacts/rallar-browser-rtc",
    "bb:browser:validate:live": "deno run -A black-box-runner/rallar-browser-live-validation.mts --mode=live --transport=both --record-dir=../../.artifacts/rallar-browser-rtc",
    "bb:dry:provider-parity": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-browser-provider-mode-parity.json --dry-run --artifact-dir=../../.artifacts/shared-test/provider-mode-parity-dry",
    "bb:memory:delivery": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-delivery-semantics.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-delivery",
    "bb:memory:parallel": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-parallel-groups.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-parallel",
    "bb:memory:scale": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-delivery-semantics.json --iterations=3 --artifact-dir=../../.artifacts/shared-test/rallar-memory-scale",
    "bb:memory:soak": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-same-connection-soak.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-soak",
    "bb:memory:traffic": "deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-memory-seeded-traffic.json --artifact-dir=../../.artifacts/shared-test/rallar-memory-traffic",
    "bb:remote:provider-parity:dry": "RALLAR_BB_RTC_PROVIDER=rallar-remote-browser deno run -A black-box-runner/scenario-black-box.ts -c black-box-runner/examples/rtc-rallar-browser-provider-mode-parity.json --dry-run --artifact-dir=../../.artifacts/shared-test/provider-mode-parity-remote-dry",
    "build": "npm run check:ts",
    "check": "npm run check:ts && npm run check:deno",
    "check:deno": "deno check black-box-runner/scenario-black-box.ts black-box-runner/recipe-matrix.mts black-box-runner/preflight/live-preflight.ts black-box-runner/rallar-browser-live-validation.mts black-box-runner/artifacts/artifact-reader.ts black-box-runner/traffic-plan-reducer.ts black-box-runner/api-v1-black-box-run.mts",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run check:ts",
    "rtc:browser:validate": "deno run -A black-box-runner/rallar-browser-live-validation.mts",
    "typecheck": "npm run check:ts"
  }
}
