{
  "variables": {
    "roomId": "room-1",
    "signalingUrl": "ws://localhost:8080/ws"
  },
  "connections": {
    "aliceRtc": {
      "type": "rtc",
      "provider": "rallar",
      "actor": "alice",
      "peerId": "alice",
      "remotePeerId": "bob",
      "roomId": "{roomId}",
      "signaling": {
        "type": "ws",
        "url": "{signalingUrl}"
      },
      "waitForOpen": true,
      "openTimeoutMs": 5000,
      "rtcConfig": {
        "iceServers": []
      },
      "metadata": {
        "role": "initiator"
      }
    },
    "bobRtc": {
      "type": "rtc",
      "provider": "rallar",
      "actor": "bob",
      "peerId": "bob",
      "remotePeerId": "alice",
      "roomId": "{roomId}",
      "signaling": {
        "type": "ws",
        "url": "{signalingUrl}"
      },
      "waitForOpen": true,
      "openTimeoutMs": 5000,
      "rtcConfig": {
        "iceServers": []
      },
      "metadata": {
        "role": "receiver"
      }
    }
  },
  "steps": [
    {
      "name": "connectAlice",
      "type": "rtc.connect",
      "connection": "aliceRtc"
    },
    {
      "name": "connectBob",
      "type": "rtc.connect",
      "connection": "bobRtc"
    },
    {
      "name": "aliceSendsMessage",
      "type": "rtc.send",
      "connection": "aliceRtc",
      "request": {
        "send": {
          "topic": "chat.message",
          "payload": {
            "from": "alice",
            "to": "bob",
            "text": "hello bob"
          }
        }
      },
      "expect": {
        "connection": "bobRtc",
        "withinMs": 3000,
        "message": {
          "topic": "chat.message",
          "payload": {
            "from": "alice",
            "to": "bob",
            "text": "hello bob"
          }
        }
      }
    },
    {
      "name": "bobSendsReply",
      "type": "rtc.send",
      "connection": "bobRtc",
      "request": {
        "send": {
          "topic": "chat.message",
          "payload": {
            "from": "bob",
            "to": "alice",
            "text": "hello alice"
          }
        }
      },
      "expect": {
        "connection": "aliceRtc",
        "withinMs": 3000,
        "message": {
          "topic": "chat.message",
          "payload": {
            "from": "bob",
            "to": "alice",
            "text": "hello alice"
          }
        }
      }
    },
    {
      "name": "closeAlice",
      "type": "rtc.close",
      "connection": "aliceRtc"
    },
    {
      "name": "closeBob",
      "type": "rtc.close",
      "connection": "bobRtc"
    }
  ]
}