{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared-test/*": [
        "../../packages/shared-test/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "**/*.test.ts",
    "**/*.d.ts",
    "../../types/**/*.d.ts"
  ]
}
