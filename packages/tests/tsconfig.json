{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@shared-react/*": [
        "../../packages/shared-react/*"
      ],
      "@api-v1/*": [
        "../../apps/api-v1/*"
      ],
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared-test/*": [
        "../../packages/shared-test/*"
      ],
      "@relic-hunters/*": [
        "../../packages/relic-hunters/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ],
      "@ar-eye-hunter/*": [
        "../../packages/ar-eye-hunter/*"
      ]
    },
    // bun-types declares a global `fetch` with Bun-only members (preconnect, …) that break the
    // vitest fetch mocks; skipLibCheck lets those .d.ts bodies and the Emscripten/undici lib
    // errors stay out of scope while bun.d.ts below supplies the narrow `Bun.*` surface we import.
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "exclude": [
    "shared-test/scenario-black-box-rtc-config.test.ts",
    "shared-test/rtc-client-provider/**",
    "repo/mutation-route-ownership/fixtures/mutation-boundary-capability-receivers/assertions.ts",
    "repo/mutation-route-ownership/fixtures/mutation-boundary-capability-receivers/lexical-classes.ts"
  ]
}
