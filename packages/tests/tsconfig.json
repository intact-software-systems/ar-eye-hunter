{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "baseUrl": "../..",
    "paths": {
      "@shared-web/*": [
        "packages/shared-web/*"
      ],
      "@shared-server/*": [
        "packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "packages/shared-graph/*"
      ],
      "@shared/*": [
        "packages/shared/*"
      ]
    },
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "**/*.test.ts",
    "**/*.d.ts",
    "../../types/**/*.d.ts"
  ],
  "exclude": [
    "**/dummy.test.ts"
  ]
}
