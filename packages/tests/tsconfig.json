{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@shared-web/*": [
        "../../packages/shared-web/*"
      ],
      "@shared-server/*": [
        "../../packages/shared-server/*"
      ],
      "@shared-graph/*": [
        "../../packages/shared-graph/*"
      ],
      "@shared-test/*": [
        "../../packages/shared-test/*"
      ],
      "@relic-hunters/*": [
        "../../packages/relic-hunters/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals",
      "deno"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "shared-test/scenario-black-box-rtc-config.test.ts",
    "shared-test/execute-black-box-rtc-client-provider.test.ts"
  ]
}
